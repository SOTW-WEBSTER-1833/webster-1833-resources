{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "LAM",
  "chapter": 3,
  "verses": [
    {
      "id": "LAM.3.1",
      "edition_verse_id": "WEBSTER1833:LAM.3.1",
      "verse": 1,
      "spans": [
        {
          "text": "I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the man ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " hath seen affliction by the rod of his wrath.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LAM.3.2",
      "edition_verse_id": "WEBSTER1833:LAM.3.2",
      "verse": 2,
      "spans": [
        {
          "text": "He hath led me, and brought ",
          "kind": "text"
        },
        {
          "text": "me into",
          "kind": "supplied"
        },
        {
          "text": " darkness, but not ",
          "kind": "text"
        },
        {
          "text": "into",
          "kind": "supplied"
        },
        {
          "text": " light.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.3",
      "edition_verse_id": "WEBSTER1833:LAM.3.3",
      "verse": 3,
      "spans": [
        {
          "text": "Surely against me is he turned; he turneth his hand ",
          "kind": "text"
        },
        {
          "text": "against me",
          "kind": "supplied"
        },
        {
          "text": " all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.4",
      "edition_verse_id": "WEBSTER1833:LAM.3.4",
      "verse": 4,
      "spans": [
        {
          "text": "My flesh and my skin hath he made old; he hath broken my bones.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.5",
      "edition_verse_id": "WEBSTER1833:LAM.3.5",
      "verse": 5,
      "spans": [
        {
          "text": "He hath built against me, and compassed ",
          "kind": "text"
        },
        {
          "text": "me",
          "kind": "supplied"
        },
        {
          "text": " with gall and labor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.6",
      "edition_verse_id": "WEBSTER1833:LAM.3.6",
      "verse": 6,
      "spans": [
        {
          "text": "He hath set me in dark places, as ",
          "kind": "text"
        },
        {
          "text": "they that are",
          "kind": "supplied"
        },
        {
          "text": " dead of old.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.7",
      "edition_verse_id": "WEBSTER1833:LAM.3.7",
      "verse": 7,
      "spans": [
        {
          "text": "He hath hedged me about, that I cannot get out: he hath made my chain heavy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.8",
      "edition_verse_id": "WEBSTER1833:LAM.3.8",
      "verse": 8,
      "spans": [
        {
          "text": "Also when I cry and shout, he shutteth out my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.9",
      "edition_verse_id": "WEBSTER1833:LAM.3.9",
      "verse": 9,
      "spans": [
        {
          "text": "He hath inclosed my ways with hewn stone, he hath made my paths crooked.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.10",
      "edition_verse_id": "WEBSTER1833:LAM.3.10",
      "verse": 10,
      "spans": [
        {
          "text": "He ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " to me ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " a bear lying in wait, ",
          "kind": "text"
        },
        {
          "text": "and as",
          "kind": "supplied"
        },
        {
          "text": " a lion in secret places.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.11",
      "edition_verse_id": "WEBSTER1833:LAM.3.11",
      "verse": 11,
      "spans": [
        {
          "text": "He hath turned aside my ways, and pulled me in pieces: he hath made me desolate.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.12",
      "edition_verse_id": "WEBSTER1833:LAM.3.12",
      "verse": 12,
      "spans": [
        {
          "text": "He hath bent his bow, and set me as a mark for the arrow.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.13",
      "edition_verse_id": "WEBSTER1833:LAM.3.13",
      "verse": 13,
      "spans": [
        {
          "text": "He hath caused the arrows of his quiver to enter into my reins.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.14",
      "edition_verse_id": "WEBSTER1833:LAM.3.14",
      "verse": 14,
      "spans": [
        {
          "text": "I was a derision to all my people; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " their song all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.15",
      "edition_verse_id": "WEBSTER1833:LAM.3.15",
      "verse": 15,
      "spans": [
        {
          "text": "He hath filled me with bitterness, he hath made me drunken with wormwood.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.16",
      "edition_verse_id": "WEBSTER1833:LAM.3.16",
      "verse": 16,
      "spans": [
        {
          "text": "He hath also broken my teeth with gravel stones, he hath covered me with ashes.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.17",
      "edition_verse_id": "WEBSTER1833:LAM.3.17",
      "verse": 17,
      "spans": [
        {
          "text": "And thou hast removed my soul far off from peace: I forgat prosperity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.18",
      "edition_verse_id": "WEBSTER1833:LAM.3.18",
      "verse": 18,
      "spans": [
        {
          "text": "And I said, My strength and my hope hath perished from the LORD:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.19",
      "edition_verse_id": "WEBSTER1833:LAM.3.19",
      "verse": 19,
      "spans": [
        {
          "text": "Remembering my affliction and my misery, the wormwood and the gall.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.20",
      "edition_verse_id": "WEBSTER1833:LAM.3.20",
      "verse": 20,
      "spans": [
        {
          "text": "My soul hath ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " still in remembrance, and is humbled in me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.21",
      "edition_verse_id": "WEBSTER1833:LAM.3.21",
      "verse": 21,
      "spans": [
        {
          "text": "This I recall to my mind, therefore have I hope.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.22",
      "edition_verse_id": "WEBSTER1833:LAM.3.22",
      "verse": 22,
      "spans": [
        {
          "text": "It is of",
          "kind": "supplied"
        },
        {
          "text": " the LORD'S mercies that we are not consumed, because his compassions fail not.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.23",
      "edition_verse_id": "WEBSTER1833:LAM.3.23",
      "verse": 23,
      "spans": [
        {
          "text": "They are",
          "kind": "supplied"
        },
        {
          "text": " new every morning: great ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " thy faithfulness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.24",
      "edition_verse_id": "WEBSTER1833:LAM.3.24",
      "verse": 24,
      "spans": [
        {
          "text": "The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my portion, saith my soul; therefore will I hope in him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.25",
      "edition_verse_id": "WEBSTER1833:LAM.3.25",
      "verse": 25,
      "spans": [
        {
          "text": "The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " good to them that wait for him, to the soul ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " seeketh him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.26",
      "edition_verse_id": "WEBSTER1833:LAM.3.26",
      "verse": 26,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " good that ",
          "kind": "text"
        },
        {
          "text": "a man",
          "kind": "supplied"
        },
        {
          "text": " should both hope and quietly wait for the salvation of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.27",
      "edition_verse_id": "WEBSTER1833:LAM.3.27",
      "verse": 27,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " good for a man that he should bear the yoke in his youth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.28",
      "edition_verse_id": "WEBSTER1833:LAM.3.28",
      "verse": 28,
      "spans": [
        {
          "text": "He sitteth alone, and keepeth silence, because he hath borne ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " upon him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.29",
      "edition_verse_id": "WEBSTER1833:LAM.3.29",
      "verse": 29,
      "spans": [
        {
          "text": "He putteth his mouth in the dust; if there may be hope.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.30",
      "edition_verse_id": "WEBSTER1833:LAM.3.30",
      "verse": 30,
      "spans": [
        {
          "text": "He giveth ",
          "kind": "text"
        },
        {
          "text": "his",
          "kind": "supplied"
        },
        {
          "text": " cheek to him that smiteth him: he is filled full with reproach.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.31",
      "edition_verse_id": "WEBSTER1833:LAM.3.31",
      "verse": 31,
      "spans": [
        {
          "text": "For the LORD will not cast off for ever:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.32",
      "edition_verse_id": "WEBSTER1833:LAM.3.32",
      "verse": 32,
      "spans": [
        {
          "text": "But though he causeth grief, yet will he have compassion according to the multitude of his mercies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.33",
      "edition_verse_id": "WEBSTER1833:LAM.3.33",
      "verse": 33,
      "spans": [
        {
          "text": "For he doth not afflict willingly nor grieve the children of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.34",
      "edition_verse_id": "WEBSTER1833:LAM.3.34",
      "verse": 34,
      "spans": [
        {
          "text": "To crush under his feet all the prisoners of the earth,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.35",
      "edition_verse_id": "WEBSTER1833:LAM.3.35",
      "verse": 35,
      "spans": [
        {
          "text": "To turn aside the right of a man before the face of the most High,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.36",
      "edition_verse_id": "WEBSTER1833:LAM.3.36",
      "verse": 36,
      "spans": [
        {
          "text": "To subvert a man in his cause, the LORD approveth not.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.37",
      "edition_verse_id": "WEBSTER1833:LAM.3.37",
      "verse": 37,
      "spans": [
        {
          "text": "Who ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " he ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " saith, and it cometh to pass, ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " the LORD commandeth ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " not?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.38",
      "edition_verse_id": "WEBSTER1833:LAM.3.38",
      "verse": 38,
      "spans": [
        {
          "text": "Out of the mouth of the most High proceedeth not evil and good?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.39",
      "edition_verse_id": "WEBSTER1833:LAM.3.39",
      "verse": 39,
      "spans": [
        {
          "text": "Why doth a living man complain, a man for the punishment of his sins?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.40",
      "edition_verse_id": "WEBSTER1833:LAM.3.40",
      "verse": 40,
      "spans": [
        {
          "text": "Let us search and try our ways, and turn again to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.41",
      "edition_verse_id": "WEBSTER1833:LAM.3.41",
      "verse": 41,
      "spans": [
        {
          "text": "Let us lift up our heart with ",
          "kind": "text"
        },
        {
          "text": "our",
          "kind": "supplied"
        },
        {
          "text": " hands to God in the heavens.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.42",
      "edition_verse_id": "WEBSTER1833:LAM.3.42",
      "verse": 42,
      "spans": [
        {
          "text": "We have transgressed and have rebelled: thou hast not pardoned.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.43",
      "edition_verse_id": "WEBSTER1833:LAM.3.43",
      "verse": 43,
      "spans": [
        {
          "text": "Thou hast covered with anger, and persecuted us: thou hast slain, thou hast not pitied.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.44",
      "edition_verse_id": "WEBSTER1833:LAM.3.44",
      "verse": 44,
      "spans": [
        {
          "text": "Thou hast covered thyself with a cloud, that ",
          "kind": "text"
        },
        {
          "text": "our",
          "kind": "supplied"
        },
        {
          "text": " prayer should not pass through.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.45",
      "edition_verse_id": "WEBSTER1833:LAM.3.45",
      "verse": 45,
      "spans": [
        {
          "text": "Thou hast made us ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " the offscouring and refuse in the midst of the people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.46",
      "edition_verse_id": "WEBSTER1833:LAM.3.46",
      "verse": 46,
      "spans": [
        {
          "text": "All our enemies have opened their mouths against us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.47",
      "edition_verse_id": "WEBSTER1833:LAM.3.47",
      "verse": 47,
      "spans": [
        {
          "text": "Fear and a snare is come upon us, desolation and destruction.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.48",
      "edition_verse_id": "WEBSTER1833:LAM.3.48",
      "verse": 48,
      "spans": [
        {
          "text": "My eye runneth down with rivers of water for the destruction of the daughter of my people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.49",
      "edition_verse_id": "WEBSTER1833:LAM.3.49",
      "verse": 49,
      "spans": [
        {
          "text": "My eye trickleth down, and ceaseth not, without any intermission,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.50",
      "edition_verse_id": "WEBSTER1833:LAM.3.50",
      "verse": 50,
      "spans": [
        {
          "text": "Till the LORD shall look down, and behold from heaven.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.51",
      "edition_verse_id": "WEBSTER1833:LAM.3.51",
      "verse": 51,
      "spans": [
        {
          "text": "My eye affecteth my heart because of all the daughters of my city.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.52",
      "edition_verse_id": "WEBSTER1833:LAM.3.52",
      "verse": 52,
      "spans": [
        {
          "text": "My enemies chased me fiercely, like a bird without cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.53",
      "edition_verse_id": "WEBSTER1833:LAM.3.53",
      "verse": 53,
      "spans": [
        {
          "text": "They have cut off my life in the dungeon, and cast a stone upon me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.54",
      "edition_verse_id": "WEBSTER1833:LAM.3.54",
      "verse": 54,
      "spans": [
        {
          "text": "Waters flowed over my head; ",
          "kind": "text"
        },
        {
          "text": "then",
          "kind": "supplied"
        },
        {
          "text": " I said, I am cut off.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.55",
      "edition_verse_id": "WEBSTER1833:LAM.3.55",
      "verse": 55,
      "spans": [
        {
          "text": "I called upon thy name, O LORD, out of the low dungeon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.56",
      "edition_verse_id": "WEBSTER1833:LAM.3.56",
      "verse": 56,
      "spans": [
        {
          "text": "Thou hast heard my voice: hide not thy ear at my breathing, at my cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.57",
      "edition_verse_id": "WEBSTER1833:LAM.3.57",
      "verse": 57,
      "spans": [
        {
          "text": "Thou drewest near in the day ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " I called upon thee: thou saidst, Fear not.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.58",
      "edition_verse_id": "WEBSTER1833:LAM.3.58",
      "verse": 58,
      "spans": [
        {
          "text": "O LORD, thou hast pleaded the causes of my soul; thou hast redeemed my life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.59",
      "edition_verse_id": "WEBSTER1833:LAM.3.59",
      "verse": 59,
      "spans": [
        {
          "text": "O LORD, thou hast seen my wrong: judge thou my cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.60",
      "edition_verse_id": "WEBSTER1833:LAM.3.60",
      "verse": 60,
      "spans": [
        {
          "text": "Thou hast seen all their vengeance ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " all their imaginations against me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.61",
      "edition_verse_id": "WEBSTER1833:LAM.3.61",
      "verse": 61,
      "spans": [
        {
          "text": "Thou hast heard their reproach, O LORD, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " all their imaginations against me;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.62",
      "edition_verse_id": "WEBSTER1833:LAM.3.62",
      "verse": 62,
      "spans": [
        {
          "text": "The lips of those that rose up against me, and their device against me all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.63",
      "edition_verse_id": "WEBSTER1833:LAM.3.63",
      "verse": 63,
      "spans": [
        {
          "text": "Behold their sitting down, and their rising up; I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " their music.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.64",
      "edition_verse_id": "WEBSTER1833:LAM.3.64",
      "verse": 64,
      "spans": [
        {
          "text": "Render to them a recompense, O LORD, according to the work of their hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.65",
      "edition_verse_id": "WEBSTER1833:LAM.3.65",
      "verse": 65,
      "spans": [
        {
          "text": "Give them sorrow of heart, thy curse to them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LAM.3.66",
      "edition_verse_id": "WEBSTER1833:LAM.3.66",
      "verse": 66,
      "spans": [
        {
          "text": "Persecute and destroy them in anger from under the heavens of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
