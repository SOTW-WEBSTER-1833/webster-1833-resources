{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "1KI",
  "chapter": 6,
  "verses": [
    {
      "id": "1KI.6.1",
      "edition_verse_id": "WEBSTER1833:1KI.6.1",
      "verse": 1,
      "spans": [
        {
          "text": "And it came to pass in the four hundred and eightieth year after the children of Israel had come out of the land of Egypt, in the fourth year of Solomon's reign over Israel, in the month of Zif, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the second month, that he began to build the house of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1KI.6.2",
      "edition_verse_id": "WEBSTER1833:1KI.6.2",
      "verse": 2,
      "spans": [
        {
          "text": "And the house which king Solomon built for the LORD, the length of it ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " sixty cubits, and the breadth of it twenty ",
          "kind": "text"
        },
        {
          "text": "cubits",
          "kind": "supplied"
        },
        {
          "text": ", and the hight of it thirty cubits.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1KI.6.3",
      "edition_verse_id": "WEBSTER1833:1KI.6.3",
      "verse": 3,
      "spans": [
        {
          "text": "And the porch before the temple of the house, twenty cubits ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the length of it, according to the breadth of the house; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " ten cubits ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the breadth of it, before the house.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1KI.6.4",
      "edition_verse_id": "WEBSTER1833:1KI.6.4",
      "verse": 4,
      "spans": [
        {
          "text": "And for the house he made windows of narrow lights.",
          "kind": "text"
        }
