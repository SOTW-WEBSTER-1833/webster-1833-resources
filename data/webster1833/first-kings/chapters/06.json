      "paragraph_start": false
    },
    {
      "id": "1KI.6.11",
      "edition_verse_id": "WEBSTER1833:1KI.6.11",
      "verse": 11,
      "spans": [
        {
          "text": "And the word of the LORD came to Solomon, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1KI.6.12",
      "edition_verse_id": "WEBSTER1833:1KI.6.12",
      "verse": 12,
      "spans": [
        {
          "text": "Concerning",
          "kind": "supplied"
        },
        {
          "text": " this house which thou art in building, if thou wilt walk in my statutes, and execute my judgments, and keep all my commandments to walk in them; then will I perform my word with thee, which I spoke to David thy father:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1KI.6.13",
      "edition_verse_id": "WEBSTER1833:1KI.6.13",
      "verse": 13,
      "spans": [
        {
          "text": "And I will dwell among the children of Israel, and will not forsake my people Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1KI.6.14",
      "edition_verse_id": "WEBSTER1833:1KI.6.14",
      "verse": 14,
      "spans": [
