        },
        {
          "text": ", he would not drink.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.27.35",
      "edition_verse_id": "WEBSTER1833:MAT.27.35",
      "verse": 35,
      "spans": [
        {
          "text": "And they crucified him, and parted his garments, casting lots: that it might be fulfilled which was spoken by the prophet, They parted my garments among them, and upon my vesture they cast lots.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.27.36",
      "edition_verse_id": "WEBSTER1833:MAT.27.36",
      "verse": 36,
      "spans": [
        {
          "text": "And sitting down, they watched him there:",
          "kind": "text"
