      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.27.54",
      "edition_verse_id": "WEBSTER1833:MAT.27.54",
      "verse": 54,
      "spans": [
        {
          "text": "Now when the centurion, and they that were with him, watching Jesus, saw the earthquake, and those things that were done, they feared greatly, saying, Truly this was the Son of God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.27.55",
      "edition_verse_id": "WEBSTER1833:MAT.27.55",
      "verse": 55,
      "spans": [
        {
          "text": "And many women were there (beholding at a distance) who followed Jesus from Galilee, ministering to him:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
