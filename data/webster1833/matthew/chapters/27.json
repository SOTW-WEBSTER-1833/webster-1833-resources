      "paragraph_start": false
    },
    {
      "id": "MAT.27.33",
      "edition_verse_id": "WEBSTER1833:MAT.27.33",
      "verse": 33,
      "spans": [
        {
          "text": "And when they had come to a place called Golgotha, that is to say, a place of a skull,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
