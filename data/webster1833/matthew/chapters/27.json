      "edition_verse_id": "WEBSTER1833:MAT.27.56",
      "verse": 56,
      "spans": [
        {
          "text": "Among whom was Mary Magdalene, and Mary the mother of James and Joses, and the mother of Zebedee's children.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
