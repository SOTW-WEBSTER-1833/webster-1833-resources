      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.27.30",
      "edition_verse_id": "WEBSTER1833:MAT.27.30",
      "verse": 30,
      "spans": [
        {
          "text": "And they spit upon him, and took the reed, and struck him on the head.",
          "kind": "text"
