{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "MAT",
  "chapter": 1,
  "verses": [
    {
      "id": "MAT.1.1",
      "edition_verse_id": "WEBSTER1833:MAT.1.1",
      "verse": 1,
      "spans": [
        {
          "text": "The book of the generation of Jesus Christ, the son of David, the son of Abraham.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "MAT.1.2",
      "edition_verse_id": "WEBSTER1833:MAT.1.2",
      "verse": 2,
      "spans": [
        {
          "text": "Abraham begat Isaac; and Isaac begat Jacob; and Jacob begat Judah and his brethren;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.3",
      "edition_verse_id": "WEBSTER1833:MAT.1.3",
      "verse": 3,
      "spans": [
        {
          "text": "And Judah begat Phares and Zara of Thamar; and Phares begat Esrom; and Esrom begat Aram;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.4",
      "edition_verse_id": "WEBSTER1833:MAT.1.4",
      "verse": 4,
      "spans": [
        {
          "text": "And Aram begat Aminadab; and Aminadab begat Naasson; and Naasson begat Salmon;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.5",
      "edition_verse_id": "WEBSTER1833:MAT.1.5",
      "verse": 5,
      "spans": [
        {
          "text": "And Salmon begat Booz of Rachab; and Booz begat Obed of Ruth; and Obed begat Jesse;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.6",
      "edition_verse_id": "WEBSTER1833:MAT.1.6",
      "verse": 6,
      "spans": [
        {
          "text": "And Jesse begat David the king; and David the king begat Solomon of her ",
          "kind": "text"
        },
        {
          "text": "that had been the wife",
          "kind": "supplied"
        },
        {
          "text": " of Uriah;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.7",
      "edition_verse_id": "WEBSTER1833:MAT.1.7",
      "verse": 7,
      "spans": [
        {
          "text": "And Solomon begat Roboam; and Roboam begat Abia; and Abia begat Asa;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.8",
      "edition_verse_id": "WEBSTER1833:MAT.1.8",
      "verse": 8,
      "spans": [
        {
          "text": "And Asa begat Josaphat; and Josaphat begat Joram; and Joram begat Ozias;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.9",
      "edition_verse_id": "WEBSTER1833:MAT.1.9",
      "verse": 9,
      "spans": [
        {
          "text": "And Ozias begat Joatham; and Joatham begat Achaz; and Achaz begat Ezekias;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.10",
      "edition_verse_id": "WEBSTER1833:MAT.1.10",
      "verse": 10,
      "spans": [
        {
          "text": "And Ezekias begat Manasses; and Manasses begat Amon; and Amon begat Josias;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.11",
      "edition_verse_id": "WEBSTER1833:MAT.1.11",
      "verse": 11,
      "spans": [
        {
          "text": "And Josias begat Jechonias and his brethren, about the time they were carried away to Babylon:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.12",
      "edition_verse_id": "WEBSTER1833:MAT.1.12",
      "verse": 12,
      "spans": [
        {
          "text": "And after they were brought to Babylon, Jechonias begat Salathiel; and Salathiel begat Zorobabel;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.13",
      "edition_verse_id": "WEBSTER1833:MAT.1.13",
      "verse": 13,
      "spans": [
        {
          "text": "And Zorobabel begat Abiud; and Abiud begat Eliakim; and Eliakim begat Azor;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.14",
      "edition_verse_id": "WEBSTER1833:MAT.1.14",
      "verse": 14,
      "spans": [
        {
          "text": "And Azor begat Sadoc; and Sadoc begat Achim; and Achim begat Eliud;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.15",
      "edition_verse_id": "WEBSTER1833:MAT.1.15",
      "verse": 15,
      "spans": [
        {
          "text": "And Eliud begat Eleazar; and Eleazar begat Matthan; and Matthan begat Jacob;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.16",
      "edition_verse_id": "WEBSTER1833:MAT.1.16",
      "verse": 16,
      "spans": [
        {
          "text": "And Jacob begat Joseph the husband of Mary, of whom was born Jesus, who is called Christ.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.17",
      "edition_verse_id": "WEBSTER1833:MAT.1.17",
      "verse": 17,
      "spans": [
        {
          "text": "So all the generations from Abraham to David ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " fourteen generations; and from David until the carrying away into Babylon ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " fourteen generations; and from the carrying away into Babylon to Christ ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " fourteen generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.18",
      "edition_verse_id": "WEBSTER1833:MAT.1.18",
      "verse": 18,
      "spans": [
        {
          "text": "Now the birth of Jesus Christ was in this manner: When his mother Mary was espoused to Joseph, before they came together, she was found with child by the Holy Spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.19",
      "edition_verse_id": "WEBSTER1833:MAT.1.19",
      "verse": 19,
      "spans": [
        {
          "text": "Then Joseph her husband, being a just ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": ", and not willing to make her a public example, purposed to put her away privately.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.20",
      "edition_verse_id": "WEBSTER1833:MAT.1.20",
      "verse": 20,
      "spans": [
        {
          "text": "But while he thought on these things, the angel of the Lord appeared to him in a dream, saying, Joseph, thou son of David, fear not to take to thee Mary thy wife: for that which is conceived in her is by the Holy Spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.21",
      "edition_verse_id": "WEBSTER1833:MAT.1.21",
      "verse": 21,
      "spans": [
        {
          "text": "And she shall bring forth a son, and thou shalt call his name JESUS: for he shall save his people from their sins.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.22",
      "edition_verse_id": "WEBSTER1833:MAT.1.22",
      "verse": 22,
      "spans": [
        {
          "text": "Now all this was done, that it might be fulfilled which was spoken from the Lord by the prophet, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.23",
      "edition_verse_id": "WEBSTER1833:MAT.1.23",
      "verse": 23,
      "spans": [
        {
          "text": "Behold, a virgin shall be with child, and shall bring forth a son, and they shall call his name Emmanuel, which being interpreted is, God with us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.24",
      "edition_verse_id": "WEBSTER1833:MAT.1.24",
      "verse": 24,
      "spans": [
        {
          "text": "Then Joseph, being raised from sleep, did as the angel of the Lord had bidden him, and took to him his wife:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "MAT.1.25",
      "edition_verse_id": "WEBSTER1833:MAT.1.25",
      "verse": 25,
      "spans": [
        {
          "text": "And knew her not till she had brought forth her first-born son: and he called his name JESUS.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
