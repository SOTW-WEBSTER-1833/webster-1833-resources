  "chapter": 1,
  "verses": [
    {
      "id": "LEV.1.1",
      "edition_verse_id": "WEBSTER1833:LEV.1.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD called to Moses, and spoke to him out of the tabernacle of the congregation, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.1.2",
      "edition_verse_id": "WEBSTER1833:LEV.1.2",
      "verse": 2,
      "spans": [
        {
          "text": "Speak to the children of Israel, and say to them, If any man of you shall bring an offering to the LORD, ye shall bring your offering of the cattle, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " of the herd, and of the flock.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.3",
      "edition_verse_id": "WEBSTER1833:LEV.1.3",
      "verse": 3,
      "spans": [
        {
          "text": "If his offering shall ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " a burnt-sacrifice of the herd, let him offer a male without blemish: he shall offer it of his own voluntary will at the door of the tabernacle of the congregation before the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.4",
      "edition_verse_id": "WEBSTER1833:LEV.1.4",
      "verse": 4,
      "spans": [
        {
          "text": "And he shall put his hand upon the head of the burnt-offering; and it shall be accepted for him to make atonement for him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.5",
      "edition_verse_id": "WEBSTER1833:LEV.1.5",
      "verse": 5,
      "spans": [
        {
          "text": "And he shall kill the bullock before the LORD: and the priests, Aaron's sons, shall bring the blood, and sprinkle the blood around upon the altar that ",
          "kind": "text"
        },
        {
          "text": "is by",
          "kind": "supplied"
        },
        {
          "text": " the door of the tabernacle of the congregation.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.6",
      "edition_verse_id": "WEBSTER1833:LEV.1.6",
      "verse": 6,
      "spans": [
        {
          "text": "And he shall flay the burnt-offering, and cut it into its pieces,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.7",
      "edition_verse_id": "WEBSTER1833:LEV.1.7",
      "verse": 7,
      "spans": [
        {
          "text": "And the sons of Aaron the priest shall put fire upon the altar, and lay the wood in order upon the fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.8",
      "edition_verse_id": "WEBSTER1833:LEV.1.8",
      "verse": 8,
      "spans": [
        {
          "text": "And the priests, Aaron's sons, shall lay the parts, the head, and the fat, in order upon the wood that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " on the fire which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon the altar.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.9",
      "edition_verse_id": "WEBSTER1833:LEV.1.9",
      "verse": 9,
      "spans": [
        {
          "text": "But his inwards and his legs shall he wash in water: and the priest shall burn all on the altar, ",
          "kind": "text"
        },
        {
          "text": "to be",
          "kind": "supplied"
        },
        {
          "text": " a burnt-sacrifice, an offering made by fire, of a sweet savor to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.10",
      "edition_verse_id": "WEBSTER1833:LEV.1.10",
      "verse": 10,
      "spans": [
        {
          "text": "And if his offering ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " of the flocks, ",
          "kind": "text"
        },
        {
          "text": "namely",
          "kind": "supplied"
        },
        {
          "text": ", of the sheep, or of the goats, for a burnt-sacrifice; he shall bring it a male without blemish.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.1.11",
      "edition_verse_id": "WEBSTER1833:LEV.1.11",
      "verse": 11,
      "spans": [
