    {
      "id": "LEV.1.14",
      "edition_verse_id": "WEBSTER1833:LEV.1.14",
      "verse": 14,
      "spans": [
        {
          "text": "And if the burnt sacrifice for his offering to the LORD shall ",
          "kind": "text"
        },
