    {
      "id": "LEV.13.1",
      "edition_verse_id": "WEBSTER1833:LEV.13.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spoke to Moses and Aaron, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.13.2",
      "edition_verse_id": "WEBSTER1833:LEV.13.2",
      "verse": 2,
      "spans": [
        {
          "text": "When a man shall have in the skin of his flesh a rising, a scab, or bright spot, and it be in the skin of his flesh ",
          "kind": "text"
        },
        {
          "text": "like",
          "kind": "supplied"
        },
        {
          "text": " the plague of leprosy; then he shall be brought to Aaron the priest, or to one of his sons the priests:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.13.3",
      "edition_verse_id": "WEBSTER1833:LEV.13.3",
      "verse": 3,
      "spans": [
        {
          "text": "And the priest shall look on the plague in the skin of the flesh: and ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " the hair in the plague is turned white, and the plague in sight ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " deeper than the skin of his flesh, it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a plague of leprosy: and the priest shall look on him, and pronounce him unclean.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.13.4",
      "edition_verse_id": "WEBSTER1833:LEV.13.4",
      "verse": 4,
      "spans": [
        {
          "text": "If the bright spot ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " white in the skin of his flesh, and in sight, not deeper than the skin, and the hair of it not turned white; then the priest shall shut up ",
          "kind": "text"
        },
        {
          "text": "him that hath",
          "kind": "supplied"
        },
        {
          "text": " the plague seven days:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
