      "edition_verse_id": "WEBSTER1833:LEV.13.7",
      "verse": 7,
      "spans": [
        {
          "text": "But if the scab shall spread much in the skin, after he hath been seen by the priest for his cleansing, he shall be seen by the priest again:",
          "kind": "text"
