{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "LEV",
  "chapter": 24,
  "verses": [
    {
      "id": "LEV.24.1",
      "edition_verse_id": "WEBSTER1833:LEV.24.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spoke to Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.24.2",
      "edition_verse_id": "WEBSTER1833:LEV.24.2",
      "verse": 2,
      "spans": [
        {
          "text": "Command the children of Israel, that they bring to thee pure olive oil beaten for the light, to cause the lamps to burn continually.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.3",
      "edition_verse_id": "WEBSTER1833:LEV.24.3",
      "verse": 3,
      "spans": [
        {
          "text": "Without the vail of the testimony, in the tabernacle of the congregation, shall Aaron order it from the evening to the morning before the LORD continually: ",
          "kind": "text"
        },
        {
          "text": "It shall be",
          "kind": "supplied"
        },
        {
          "text": " a statute for ever in your generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.4",
      "edition_verse_id": "WEBSTER1833:LEV.24.4",
      "verse": 4,
      "spans": [
        {
          "text": "Ye shall order the lamps upon the pure candlestick before the LORD continually.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.5",
      "edition_verse_id": "WEBSTER1833:LEV.24.5",
      "verse": 5,
      "spans": [
        {
          "text": "And thou shalt take fine flour, and bake twelve cakes of it: two tenth-parts shall be in one cake.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.6",
      "edition_verse_id": "WEBSTER1833:LEV.24.6",
      "verse": 6,
      "spans": [
        {
          "text": "And thou shalt set them in two rows, six in a row, upon the pure table before the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.7",
      "edition_verse_id": "WEBSTER1833:LEV.24.7",
      "verse": 7,
      "spans": [
        {
          "text": "And thou shalt put pure frankincense upon ",
          "kind": "text"
        },
        {
          "text": "each",
          "kind": "supplied"
        },
        {
          "text": " row, that it may be on the bread for a memorial, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " an offering made by fire to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.8",
      "edition_verse_id": "WEBSTER1833:LEV.24.8",
      "verse": 8,
      "spans": [
        {
          "text": "Every sabbath he shall set it in order before the LORD continually, ",
          "kind": "text"
        },
        {
          "text": "being taken",
          "kind": "supplied"
        },
        {
          "text": " from the children of Israel by an everlasting covenant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.9",
      "edition_verse_id": "WEBSTER1833:LEV.24.9",
      "verse": 9,
      "spans": [
        {
          "text": "And it shall be Aaron's and his sons'; and they shall eat it in the holy place: for it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " most holy to him of the offerings of the LORD made by fire by a perpetual statute.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.10",
      "edition_verse_id": "WEBSTER1833:LEV.24.10",
      "verse": 10,
      "spans": [
        {
          "text": "And the son of an Israelitish woman whose father ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " an Egyptian, went out among the children of Israel; and this son of the Israelitish ",
          "kind": "text"
        },
        {
          "text": "woman",
          "kind": "supplied"
        },
        {
          "text": " and a man of Israel strove together in the camp;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.11",
      "edition_verse_id": "WEBSTER1833:LEV.24.11",
      "verse": 11,
      "spans": [
        {
          "text": "And the Israelitish woman's son blasphemed the name ",
          "kind": "text"
        },
        {
          "text": "of the LORD",
          "kind": "supplied"
        },
        {
          "text": ", and cursed: and they brought him to Moses: (and his mother's name ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " Shelomith, the daughter of Dibri, of the tribe of Dan:)",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.12",
      "edition_verse_id": "WEBSTER1833:LEV.24.12",
      "verse": 12,
      "spans": [
        {
          "text": "And they put him in custody, that the mind of the LORD might be shown to them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.13",
      "edition_verse_id": "WEBSTER1833:LEV.24.13",
      "verse": 13,
      "spans": [
        {
          "text": "And the LORD spoke to Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.14",
      "edition_verse_id": "WEBSTER1833:LEV.24.14",
      "verse": 14,
      "spans": [
        {
          "text": "Bring forth him that hath cursed without the camp; and let all that heard ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": " lay their hands upon his head, and let all the congregation stone him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.15",
      "edition_verse_id": "WEBSTER1833:LEV.24.15",
      "verse": 15,
      "spans": [
        {
          "text": "And thou shalt speak to the children of Israel, saying, Whoever curseth his God shall bear his sin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.16",
      "edition_verse_id": "WEBSTER1833:LEV.24.16",
      "verse": 16,
      "spans": [
        {
          "text": "And he that blasphemeth the name of the LORD, he shall surely be put to death, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " all the congregation shall certainly stone him: as well the stranger, as he that is born in the land, when he blasphemeth the name ",
          "kind": "text"
        },
        {
          "text": "of the LORD",
          "kind": "supplied"
        },
        {
          "text": ", shall be put to death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.17",
      "edition_verse_id": "WEBSTER1833:LEV.24.17",
      "verse": 17,
      "spans": [
        {
          "text": "And he that killeth any man shall surely be put to death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.18",
      "edition_verse_id": "WEBSTER1833:LEV.24.18",
      "verse": 18,
      "spans": [
        {
          "text": "And he that killeth a beast shall make it good; beast for beast.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.19",
      "edition_verse_id": "WEBSTER1833:LEV.24.19",
      "verse": 19,
      "spans": [
        {
          "text": "And if a man shall cause a blemish in his neighbor; as he hath done, so shall it be done to him;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.20",
      "edition_verse_id": "WEBSTER1833:LEV.24.20",
      "verse": 20,
      "spans": [
        {
          "text": "Breach for breach, eye for eye, tooth for tooth: as he hath caused a blemish in a man, so shall it be done to him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.21",
      "edition_verse_id": "WEBSTER1833:LEV.24.21",
      "verse": 21,
      "spans": [
        {
          "text": "And he that killeth a beast, he shall restore it: and he that killeth a man, he shall be put to death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.22",
      "edition_verse_id": "WEBSTER1833:LEV.24.22",
      "verse": 22,
      "spans": [
        {
          "text": "Ye shall have one manner of law, as well for the stranger, as for one of your own country: for I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD your God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.24.23",
      "edition_verse_id": "WEBSTER1833:LEV.24.23",
      "verse": 23,
      "spans": [
        {
          "text": "And Moses spoke to the children of Israel, that they should bring forth him that had cursed out of the camp, and stone him with stones: and the children of Israel did as the LORD commanded Moses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
