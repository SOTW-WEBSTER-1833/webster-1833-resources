      "edition_verse_id": "WEBSTER1833:LEV.2.1",
      "verse": 1,
      "spans": [
        {
          "text": "And when any will offer a meat-offering to the LORD, his offering shall be ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " fine flour; and he shall pour oil upon it, and put frankincense upon it.",
