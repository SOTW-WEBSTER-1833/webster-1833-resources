      "edition_verse_id": "WEBSTER1833:LEV.2.8",
      "verse": 8,
      "spans": [
        {
          "text": "And thou shalt bring the meat-offering that is made of these things to the LORD: and when it is presented to the priest, he shall bring it to the altar.",
          "kind": "text"
        }
