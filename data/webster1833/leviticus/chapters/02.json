      "edition_verse_id": "WEBSTER1833:LEV.2.10",
      "verse": 10,
      "spans": [
        {
          "text": "And that which is left of the meat-offering ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " Aaron's and his sons': ",
          "kind": "text"
