{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "LEV",
  "chapter": 21,
  "verses": [
    {
      "id": "LEV.21.1",
      "edition_verse_id": "WEBSTER1833:LEV.21.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD said to Moses, Speak to the priests, the sons of Aaron, and say to them, There shall none be defiled for the dead among his people:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "LEV.21.2",
      "edition_verse_id": "WEBSTER1833:LEV.21.2",
      "verse": 2,
      "spans": [
        {
          "text": "But for his kin, that is near to him, ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": ", for his mother, and for his father, and for his son, and for his daughter, and for his brother,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.3",
      "edition_verse_id": "WEBSTER1833:LEV.21.3",
      "verse": 3,
      "spans": [
        {
          "text": "And for his sister a virgin, that is nigh to him, who hath had no husband: for her he may be defiled.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.4",
      "edition_verse_id": "WEBSTER1833:LEV.21.4",
      "verse": 4,
      "spans": [
        {
          "text": "But",
          "kind": "supplied"
        },
        {
          "text": " he shall not defile himself, ",
          "kind": "text"
        },
        {
          "text": "being",
          "kind": "supplied"
        },
        {
          "text": " a chief man among his people, to profane himself.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.5",
      "edition_verse_id": "WEBSTER1833:LEV.21.5",
      "verse": 5,
      "spans": [
        {
          "text": "They shall not make baldness upon their head, neither shall they shave off the corner of their beard, nor make any cuttings in their flesh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.6",
      "edition_verse_id": "WEBSTER1833:LEV.21.6",
      "verse": 6,
      "spans": [
        {
          "text": "They shall be holy to their God, and not profane the name of their God: for the offerings of the LORD made by fire, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " the bread of their God they do offer: therefore they shall be holy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.7",
      "edition_verse_id": "WEBSTER1833:LEV.21.7",
      "verse": 7,
      "spans": [
        {
          "text": "They shall not take a wife ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": " a lewd woman, or profane; neither shall they take a woman put away from her husband: for he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " holy to his God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.8",
      "edition_verse_id": "WEBSTER1833:LEV.21.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou shalt sanctify him therefore, for he offereth the bread of thy God: he shall be holy to thee: for I the LORD, who sanctify you, ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " holy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.9",
      "edition_verse_id": "WEBSTER1833:LEV.21.9",
      "verse": 9,
      "spans": [
        {
          "text": "And the daughter of any priest, if she shall profane herself by lewdness, she profaneth her father: she shall be burnt with fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.10",
      "edition_verse_id": "WEBSTER1833:LEV.21.10",
      "verse": 10,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "he that is",
          "kind": "supplied"
        },
        {
          "text": " the high priest among his brethren, upon whose head the anointing oil was poured, and that is consecrated to put on the garments, shall not uncover his head, nor rend his clothes;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.11",
      "edition_verse_id": "WEBSTER1833:LEV.21.11",
      "verse": 11,
      "spans": [
        {
          "text": "Neither shall he go in to any dead body, nor defile himself for his father, or for his mother;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.12",
      "edition_verse_id": "WEBSTER1833:LEV.21.12",
      "verse": 12,
      "spans": [
        {
          "text": "Neither shall he go out of the sanctuary, nor profane the sanctuary of his God; for the crown of the anointing oil of his God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon him: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.13",
      "edition_verse_id": "WEBSTER1833:LEV.21.13",
      "verse": 13,
      "spans": [
        {
          "text": "And he shall take a wife in her virginity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.14",
      "edition_verse_id": "WEBSTER1833:LEV.21.14",
      "verse": 14,
      "spans": [
        {
          "text": "A widow, or a divorced woman, or profane, ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " a harlot, these shall he not take: but he shall take a virgin of his own people for a wife.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.15",
      "edition_verse_id": "WEBSTER1833:LEV.21.15",
      "verse": 15,
      "spans": [
        {
          "text": "Neither shall he profane his seed among his people: for I the LORD do sanctify him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.16",
      "edition_verse_id": "WEBSTER1833:LEV.21.16",
      "verse": 16,
      "spans": [
        {
          "text": "And the LORD spoke to Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.17",
      "edition_verse_id": "WEBSTER1833:LEV.21.17",
      "verse": 17,
      "spans": [
        {
          "text": "Speak to Aaron, saying, whoever ",
          "kind": "text"
        },
        {
          "text": "he may be",
          "kind": "supplied"
        },
        {
          "text": " of thy seed in their generations that hath ",
          "kind": "text"
        },
        {
          "text": "any",
          "kind": "supplied"
        },
        {
          "text": " blemish, let him not approach to offer the bread of his God:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.18",
      "edition_verse_id": "WEBSTER1833:LEV.21.18",
      "verse": 18,
      "spans": [
        {
          "text": "For whatever man ",
          "kind": "text"
        },
        {
          "text": "he may be",
          "kind": "supplied"
        },
        {
          "text": " that hath a blemish, he shall not approach: a blind man, or a lame, or he that hath a flat nose, or any thing superfluous,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.19",
      "edition_verse_id": "WEBSTER1833:LEV.21.19",
      "verse": 19,
      "spans": [
        {
          "text": "Or a man that is broken-footed, or broken-handed,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.20",
      "edition_verse_id": "WEBSTER1833:LEV.21.20",
      "verse": 20,
      "spans": [
        {
          "text": "Or crooked-backed, or a dwarf, or that hath a blemish in his eye, or be scurvy, or scabbed, or hath his peculiar members broken:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.21",
      "edition_verse_id": "WEBSTER1833:LEV.21.21",
      "verse": 21,
      "spans": [
        {
          "text": "No man of the seed of Aaron the priest, that hath a blemish, shall come nigh to offer the offerings of the LORD made by fire; he hath a blemish, he shall not come nigh to offer the bread of his God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.22",
      "edition_verse_id": "WEBSTER1833:LEV.21.22",
      "verse": 22,
      "spans": [
        {
          "text": "He shall eat the bread of his God, ",
          "kind": "text"
        },
        {
          "text": "both",
          "kind": "supplied"
        },
        {
          "text": " of the most holy, and of the holy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.23",
      "edition_verse_id": "WEBSTER1833:LEV.21.23",
      "verse": 23,
      "spans": [
        {
          "text": "Only he shall not go in to the vail, nor come nigh to the altar, because he hath a blemish; that he may not profane my sanctuaries: for I the LORD do sanctify them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "LEV.21.24",
      "edition_verse_id": "WEBSTER1833:LEV.21.24",
      "verse": 24,
      "spans": [
        {
          "text": "And Moses told ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " to Aaron, and to his sons, and to all the children of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
