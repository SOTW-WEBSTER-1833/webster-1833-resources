      "edition_verse_id": "WEBSTER1833:LEV.14.18",
      "verse": 18,
      "spans": [
        {
          "text": "And the remnant of the oil that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in the priest's hand he shall pour upon the head of him that is to be cleansed: and the priest shall make an atonement for him before the LORD.",
