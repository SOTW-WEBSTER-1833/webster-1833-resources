      "edition_verse_id": "WEBSTER1833:LEV.14.16",
      "verse": 16,
      "spans": [
        {
          "text": "And the priest shall dip his right finger in the oil that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in his left hand, and shall sprinkle of the oil with his finger seven times before the LORD.",
