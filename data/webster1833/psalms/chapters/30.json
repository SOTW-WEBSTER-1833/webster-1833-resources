{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 30,
  "verses": [
    {
      "id": "PSA.30.1",
      "edition_verse_id": "WEBSTER1833:PSA.30.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " Song, ",
          "kind": "text"
        },
        {
          "text": "at",
          "kind": "supplied"
        },
        {
          "text": " the dedication of the house of David. I will extol thee, O LORD; for thou hast lifted me up, and hast not made my foes to rejoice over me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.30.2",
      "edition_verse_id": "WEBSTER1833:PSA.30.2",
      "verse": 2,
      "spans": [
        {
          "text": "O LORD my God, I cried to thee, and thou hast healed me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.3",
      "edition_verse_id": "WEBSTER1833:PSA.30.3",
      "verse": 3,
      "spans": [
        {
          "text": "O LORD, thou hast brought up my soul from the grave: thou hast kept me alive, that I should not go down to the pit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.4",
      "edition_verse_id": "WEBSTER1833:PSA.30.4",
      "verse": 4,
      "spans": [
        {
          "text": "Sing to the LORD, O ye saints of his, and give thanks at the remembrance of his holiness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.5",
      "edition_verse_id": "WEBSTER1833:PSA.30.5",
      "verse": 5,
      "spans": [
        {
          "text": "For his anger ",
          "kind": "text"
        },
        {
          "text": "endureth but",
          "kind": "supplied"
        },
        {
          "text": " a moment; in his favor ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " life: weeping may endure for a night, but joy ",
          "kind": "text"
        },
        {
          "text": "cometh",
          "kind": "supplied"
        },
        {
          "text": " in the morning.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.6",
      "edition_verse_id": "WEBSTER1833:PSA.30.6",
      "verse": 6,
      "spans": [
        {
          "text": "And in my prosperity I said, I shall never be moved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.7",
      "edition_verse_id": "WEBSTER1833:PSA.30.7",
      "verse": 7,
      "spans": [
        {
          "text": "LORD, by thy favor thou hast made my mountain to stand strong: thou didst hide thy face, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " I was troubled.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.8",
      "edition_verse_id": "WEBSTER1833:PSA.30.8",
      "verse": 8,
      "spans": [
        {
          "text": "I cried to thee, O LORD; and to the LORD I made supplication.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.9",
      "edition_verse_id": "WEBSTER1833:PSA.30.9",
      "verse": 9,
      "spans": [
        {
          "text": "What profit ",
          "kind": "text"
        },
        {
          "text": "is there",
          "kind": "supplied"
        },
        {
          "text": " in my blood, when I go down to the pit? Shall the dust praise thee? shall it declare thy truth?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.10",
      "edition_verse_id": "WEBSTER1833:PSA.30.10",
      "verse": 10,
      "spans": [
        {
          "text": "Hear, O LORD, and have mercy upon me: LORD, be thou my helper.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.11",
      "edition_verse_id": "WEBSTER1833:PSA.30.11",
      "verse": 11,
      "spans": [
        {
          "text": "Thou hast turned for me my mourning into dancing: thou hast put off my sackcloth, and girded me with gladness;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.30.12",
      "edition_verse_id": "WEBSTER1833:PSA.30.12",
      "verse": 12,
      "spans": [
        {
          "text": "To the end that ",
          "kind": "text"
        },
        {
          "text": "my",
          "kind": "supplied"
        },
        {
          "text": " glory may sing praise to thee, and not be silent. O LORD my God, I will give thanks to thee for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
