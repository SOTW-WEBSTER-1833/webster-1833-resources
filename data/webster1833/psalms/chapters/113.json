{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 113,
  "verses": [
    {
      "id": "PSA.113.1",
      "edition_verse_id": "WEBSTER1833:PSA.113.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye the LORD. Praise, O ye servants of the LORD, praise the name of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.113.2",
      "edition_verse_id": "WEBSTER1833:PSA.113.2",
      "verse": 2,
      "spans": [
        {
          "text": "Blessed be the name of the LORD from this time forth and for evermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.3",
      "edition_verse_id": "WEBSTER1833:PSA.113.3",
      "verse": 3,
      "spans": [
        {
          "text": "From the rising of the sun to the going down of the same the LORD'S name ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " to be praised.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.4",
      "edition_verse_id": "WEBSTER1833:PSA.113.4",
      "verse": 4,
      "spans": [
        {
          "text": "The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " high above all nations, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " his glory above the heavens.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.5",
      "edition_verse_id": "WEBSTER1833:PSA.113.5",
      "verse": 5,
      "spans": [
        {
          "text": "Who ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " like to the LORD our God, who dwelleth on high.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.6",
      "edition_verse_id": "WEBSTER1833:PSA.113.6",
      "verse": 6,
      "spans": [
        {
          "text": "Who humbleth ",
          "kind": "text"
        },
        {
          "text": "himself",
          "kind": "supplied"
        },
        {
          "text": " to behold ",
          "kind": "text"
        },
        {
          "text": "the things that are",
          "kind": "supplied"
        },
        {
          "text": " in heaven, and in the earth!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.7",
      "edition_verse_id": "WEBSTER1833:PSA.113.7",
      "verse": 7,
      "spans": [
        {
          "text": "He raiseth the poor out of the dust, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " lifteth the needy out of the dunghill;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.8",
      "edition_verse_id": "WEBSTER1833:PSA.113.8",
      "verse": 8,
      "spans": [
        {
          "text": "That he may set ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": " with princes, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " with the princes of his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.113.9",
      "edition_verse_id": "WEBSTER1833:PSA.113.9",
      "verse": 9,
      "spans": [
        {
          "text": "He maketh the barren woman to keep house, ",
          "kind": "text"
        },
        {
          "text": "and to be",
          "kind": "supplied"
        },
        {
          "text": " a joyful mother of children. Praise ye the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
