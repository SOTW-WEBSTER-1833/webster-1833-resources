      "verse": 1,
      "spans": [
        {
          "text": "A Song of degrees of David. LORD, my heart ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " not haughty, nor my eyes lofty: neither do I exercise myself in great matters, or in things too high for me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.131.2",
      "edition_verse_id": "WEBSTER1833:PSA.131.2",
      "verse": 2,
      "spans": [
        {
          "text": "Surely I have behaved and quieted myself as a child that is weaned by his mother: my soul ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " even as a weaned child.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.131.3",
      "edition_verse_id": "WEBSTER1833:PSA.131.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let Israel hope in the LORD from henceforth and for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
