{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 141,
  "verses": [
    {
      "id": "PSA.141.1",
      "edition_verse_id": "WEBSTER1833:PSA.141.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David. LORD, I cry to thee: make haste to me; give ear to my voice, when I cry to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.141.2",
      "edition_verse_id": "WEBSTER1833:PSA.141.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let my prayer be set forth before thee ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " incense; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " the lifting up of my hands ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " the evening sacrifice.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.3",
      "edition_verse_id": "WEBSTER1833:PSA.141.3",
      "verse": 3,
      "spans": [
        {
          "text": "Set a watch, O LORD, before my mouth; keep the door of my lips.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.4",
      "edition_verse_id": "WEBSTER1833:PSA.141.4",
      "verse": 4,
      "spans": [
        {
          "text": "Incline not my heart to ",
          "kind": "text"
        },
        {
          "text": "any",
          "kind": "supplied"
        },
        {
          "text": " evil thing, to practice wicked works with men that work iniquity: and let me not eat of their dainties.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.5",
      "edition_verse_id": "WEBSTER1833:PSA.141.5",
      "verse": 5,
      "spans": [
        {
          "text": "Let the righteous smite me; ",
          "kind": "text"
        },
        {
          "text": "it shall be",
          "kind": "supplied"
        },
        {
          "text": " a kindness: and let him reprove me; ",
          "kind": "text"
        },
        {
          "text": "it shall be",
          "kind": "supplied"
        },
        {
          "text": " an excellent oil, ",
          "kind": "text"
        },
        {
          "text": "which",
          "kind": "supplied"
        },
        {
          "text": " shall not break my head: for yet my prayer also ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " in their calamities.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.6",
      "edition_verse_id": "WEBSTER1833:PSA.141.6",
      "verse": 6,
      "spans": [
        {
          "text": "When their judges are overthrown in stony places, they shall hear my words; for they are sweet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.7",
      "edition_verse_id": "WEBSTER1833:PSA.141.7",
      "verse": 7,
      "spans": [
        {
          "text": "Our bones are scattered at the grave's mouth, as when one cutteth and cleaveth ",
          "kind": "text"
        },
        {
          "text": "wood",
          "kind": "supplied"
        },
        {
          "text": " upon the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.8",
      "edition_verse_id": "WEBSTER1833:PSA.141.8",
      "verse": 8,
      "spans": [
        {
          "text": "But my eyes ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " to thee, O GOD the LORD: in thee is my trust; leave not my soul destitute.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.9",
      "edition_verse_id": "WEBSTER1833:PSA.141.9",
      "verse": 9,
      "spans": [
        {
          "text": "Keep me from the snare ",
          "kind": "text"
        },
        {
          "text": "which",
          "kind": "supplied"
        },
        {
          "text": " they have laid for me, and the gins of the workers of iniquity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.141.10",
      "edition_verse_id": "WEBSTER1833:PSA.141.10",
      "verse": 10,
      "spans": [
        {
          "text": "Let the wicked fall into their own nets, whilst I escape.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
