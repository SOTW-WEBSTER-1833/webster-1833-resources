{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 21,
  "verses": [
    {
      "id": "PSA.21.1",
      "edition_verse_id": "WEBSTER1833:PSA.21.1",
      "verse": 1,
      "spans": [
        {
          "text": "To the chief Musician, a Psalm of David. The king shall joy in thy strength, O LORD; and in thy salvation how greatly shall he rejoice!",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.21.2",
      "edition_verse_id": "WEBSTER1833:PSA.21.2",
      "verse": 2,
      "spans": [
        {
          "text": "Thou hast given him his heart's desire, and hast not withheld the request of his lips. Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.3",
      "edition_verse_id": "WEBSTER1833:PSA.21.3",
      "verse": 3,
      "spans": [
        {
          "text": "For thou hast met him with the blessings of goodness: thou hast set a crown of pure gold on his head.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.4",
      "edition_verse_id": "WEBSTER1833:PSA.21.4",
      "verse": 4,
      "spans": [
        {
          "text": "He asked life of thee, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " thou gavest ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " to him, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " length of days for ever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.5",
      "edition_verse_id": "WEBSTER1833:PSA.21.5",
      "verse": 5,
      "spans": [
        {
          "text": "His glory ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " great in thy salvation: honor and majesty hast thou laid upon him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.6",
      "edition_verse_id": "WEBSTER1833:PSA.21.6",
      "verse": 6,
      "spans": [
        {
          "text": "For thou hast made him most blessed for ever: thou hast made him exceeding glad with thy countenance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.7",
      "edition_verse_id": "WEBSTER1833:PSA.21.7",
      "verse": 7,
      "spans": [
        {
          "text": "For the king trusteth in the LORD, and through the mercy of the most High he shall not be moved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.8",
      "edition_verse_id": "WEBSTER1833:PSA.21.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thy hand shall find out all thy enemies: thy right hand shall find out those that hate thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.9",
      "edition_verse_id": "WEBSTER1833:PSA.21.9",
      "verse": 9,
      "spans": [
        {
          "text": "Thou shalt make them as a fiery oven in the time of thy anger: the LORD shall swallow them up in his wrath, and the fire shall devour them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.10",
      "edition_verse_id": "WEBSTER1833:PSA.21.10",
      "verse": 10,
      "spans": [
        {
          "text": "Their fruit shalt thou destroy from the earth, and their seed from among the children of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.11",
      "edition_verse_id": "WEBSTER1833:PSA.21.11",
      "verse": 11,
      "spans": [
        {
          "text": "For they intended evil against thee: they imagined a mischievous device, ",
          "kind": "text"
        },
        {
          "text": "which",
          "kind": "supplied"
        },
        {
          "text": " they are not able ",
          "kind": "text"
        },
        {
          "text": "to perform",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.12",
      "edition_verse_id": "WEBSTER1833:PSA.21.12",
      "verse": 12,
      "spans": [
        {
          "text": "Therefore shalt thou make them turn their back, ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " thou shalt make ready ",
          "kind": "text"
        },
        {
          "text": "thy arrows",
          "kind": "supplied"
        },
        {
          "text": " upon thy strings against the face of them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.21.13",
      "edition_verse_id": "WEBSTER1833:PSA.21.13",
      "verse": 13,
      "spans": [
        {
          "text": "Be thou exalted, LORD, in thy own strength: ",
          "kind": "text"
        },
        {
          "text": "so",
          "kind": "supplied"
        },
        {
          "text": " will we sing and praise thy power.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
