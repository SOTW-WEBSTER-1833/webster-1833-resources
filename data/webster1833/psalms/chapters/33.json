{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 33,
  "verses": [
    {
      "id": "PSA.33.1",
      "edition_verse_id": "WEBSTER1833:PSA.33.1",
      "verse": 1,
      "spans": [
        {
          "text": "Rejoice in the LORD, O ye righteous: ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " praise is comely for the upright.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.33.2",
      "edition_verse_id": "WEBSTER1833:PSA.33.2",
      "verse": 2,
      "spans": [
        {
          "text": "Praise the LORD with harp: sing to him with the psaltery ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " an instrument of ten strings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.3",
      "edition_verse_id": "WEBSTER1833:PSA.33.3",
      "verse": 3,
      "spans": [
        {
          "text": "Sing to him a new song; play skillfully with a loud noise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.4",
      "edition_verse_id": "WEBSTER1833:PSA.33.4",
      "verse": 4,
      "spans": [
        {
          "text": "For the word of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " right; and all his works ",
          "kind": "text"
        },
        {
          "text": "are done",
          "kind": "supplied"
        },
        {
          "text": " in truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.5",
      "edition_verse_id": "WEBSTER1833:PSA.33.5",
      "verse": 5,
      "spans": [
        {
          "text": "He loveth righteousness and judgment: the earth is full of the goodness of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.6",
      "edition_verse_id": "WEBSTER1833:PSA.33.6",
      "verse": 6,
      "spans": [
        {
          "text": "By the word of the LORD were the heavens made; and all the host of them by the breath of his mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.7",
      "edition_verse_id": "WEBSTER1833:PSA.33.7",
      "verse": 7,
      "spans": [
        {
          "text": "He gathereth the waters of the sea together as a heap: he layeth up the depth in store-houses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.8",
      "edition_verse_id": "WEBSTER1833:PSA.33.8",
      "verse": 8,
      "spans": [
        {
          "text": "Let all the earth fear the LORD: let all the inhabitants of the world stand in awe of him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.9",
      "edition_verse_id": "WEBSTER1833:PSA.33.9",
      "verse": 9,
      "spans": [
        {
          "text": "For he spoke, and it was ",
          "kind": "text"
        },
        {
          "text": "done",
          "kind": "supplied"
        },
        {
          "text": "; he commanded, and it stood fast.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.10",
      "edition_verse_id": "WEBSTER1833:PSA.33.10",
      "verse": 10,
      "spans": [
        {
          "text": "The LORD bringeth the counsel of the heathen to naught: he maketh the devices of the people of no effect.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.11",
      "edition_verse_id": "WEBSTER1833:PSA.33.11",
      "verse": 11,
      "spans": [
        {
          "text": "The counsel of the LORD standeth for ever, the thoughts of his heart to all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.12",
      "edition_verse_id": "WEBSTER1833:PSA.33.12",
      "verse": 12,
      "spans": [
        {
          "text": "Blessed ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the nation whose God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the LORD; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " the people ",
          "kind": "text"
        },
        {
          "text": "whom",
          "kind": "supplied"
        },
        {
          "text": " he hath chosen for his own inheritance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.13",
      "edition_verse_id": "WEBSTER1833:PSA.33.13",
      "verse": 13,
      "spans": [
        {
          "text": "The LORD looketh from heaven; he beholdeth all the sons of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.14",
      "edition_verse_id": "WEBSTER1833:PSA.33.14",
      "verse": 14,
      "spans": [
        {
          "text": "From the place of his habitation he looketh upon all the inhabitants of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.15",
      "edition_verse_id": "WEBSTER1833:PSA.33.15",
      "verse": 15,
      "spans": [
        {
          "text": "He fashioneth their hearts alike; he considereth all their works.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.16",
      "edition_verse_id": "WEBSTER1833:PSA.33.16",
      "verse": 16,
      "spans": [
        {
          "text": "There is no king saved by the multitude of a host: a mighty man is not delivered by much strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.17",
      "edition_verse_id": "WEBSTER1833:PSA.33.17",
      "verse": 17,
      "spans": [
        {
          "text": "A horse ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a vain thing for safety: neither shall he deliver ",
          "kind": "text"
        },
        {
          "text": "any",
          "kind": "supplied"
        },
        {
          "text": " by his great strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.18",
      "edition_verse_id": "WEBSTER1833:PSA.33.18",
      "verse": 18,
      "spans": [
        {
          "text": "Behold, the eye of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon them that fear him, upon them that hope in his mercy;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.19",
      "edition_verse_id": "WEBSTER1833:PSA.33.19",
      "verse": 19,
      "spans": [
        {
          "text": "To deliver their soul from death, and to keep them alive in famine.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.20",
      "edition_verse_id": "WEBSTER1833:PSA.33.20",
      "verse": 20,
      "spans": [
        {
          "text": "Our soul waiteth for the LORD: he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " our help and our shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.21",
      "edition_verse_id": "WEBSTER1833:PSA.33.21",
      "verse": 21,
      "spans": [
        {
          "text": "For our heart shall rejoice in him, because we have trusted in his holy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.33.22",
      "edition_verse_id": "WEBSTER1833:PSA.33.22",
      "verse": 22,
      "spans": [
        {
          "text": "Let thy mercy, O LORD, be upon us, according as we hope in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
