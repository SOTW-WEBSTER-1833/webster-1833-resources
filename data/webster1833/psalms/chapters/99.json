    {
      "id": "PSA.99.6",
      "edition_verse_id": "WEBSTER1833:PSA.99.6",
      "verse": 6,
      "spans": [
        {
          "text": "Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the LORD, and he answered them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.99.7",
      "edition_verse_id": "WEBSTER1833:PSA.99.7",
      "verse": 7,
      "spans": [
        {
          "text": "He spoke to them in the cloudy pillar: they kept his testimonies, and the ordinance ",
          "kind": "text"
