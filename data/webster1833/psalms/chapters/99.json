      "edition_verse_id": "WEBSTER1833:PSA.99.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou didst answer them, O LORD our God: thou wast a God that forgavest them, though thou tookest vengeance of their inventions.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
