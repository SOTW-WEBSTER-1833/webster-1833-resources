{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 144,
  "verses": [
    {
      "id": "PSA.144.1",
      "edition_verse_id": "WEBSTER1833:PSA.144.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm",
          "kind": "supplied"
        },
        {
          "text": " of David. Blessed ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " the LORD my strength, who teacheth my hands to war, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my fingers to fight;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.144.2",
      "edition_verse_id": "WEBSTER1833:PSA.144.2",
      "verse": 2,
      "spans": [
        {
          "text": "My goodness, and my fortress; my high tower, and my deliverer; my shield, and ",
          "kind": "text"
        },
        {
          "text": "he",
          "kind": "supplied"
        },
        {
          "text": " in whom I trust; who subdueth my people under me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.3",
      "edition_verse_id": "WEBSTER1833:PSA.144.3",
      "verse": 3,
      "spans": [
        {
          "text": "LORD, what ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " man, that thou takest knowledge of him! ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " the son of man, that thou makest account of him!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.4",
      "edition_verse_id": "WEBSTER1833:PSA.144.4",
      "verse": 4,
      "spans": [
        {
          "text": "Man is like to vanity: his days ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " as a shadow that passeth away.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.5",
      "edition_verse_id": "WEBSTER1833:PSA.144.5",
      "verse": 5,
      "spans": [
        {
          "text": "Bow thy heavens, O LORD, and come down: touch the mountains, and they shall smoke.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.6",
      "edition_verse_id": "WEBSTER1833:PSA.144.6",
      "verse": 6,
      "spans": [
        {
          "text": "Cast forth lightning, and scatter them: shoot thy arrows, and destroy them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.7",
      "edition_verse_id": "WEBSTER1833:PSA.144.7",
      "verse": 7,
      "spans": [
        {
          "text": "Send thy hand from above; rid me, and deliver me out of great waters, from the hand of strange children;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.8",
      "edition_verse_id": "WEBSTER1833:PSA.144.8",
      "verse": 8,
      "spans": [
        {
          "text": "Whose mouth speaketh vanity, and their right hand ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a right hand of falsehood.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.9",
      "edition_verse_id": "WEBSTER1833:PSA.144.9",
      "verse": 9,
      "spans": [
        {
          "text": "I will sing a new song to thee, O God: upon a psaltery ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " an instrument of ten strings will I sing praises to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.10",
      "edition_verse_id": "WEBSTER1833:PSA.144.10",
      "verse": 10,
      "spans": [
        {
          "text": "It is he",
          "kind": "supplied"
        },
        {
          "text": " that giveth salvation to kings: who delivereth David his servant from the hurtful sword.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.11",
      "edition_verse_id": "WEBSTER1833:PSA.144.11",
      "verse": 11,
      "spans": [
        {
          "text": "Rid me, and deliver me from the hand of strange children, whose mouth speaketh vanity, and their right hand ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a right hand of falsehood:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.12",
      "edition_verse_id": "WEBSTER1833:PSA.144.12",
      "verse": 12,
      "spans": [
        {
          "text": "That our sons ",
          "kind": "text"
        },
        {
          "text": "may be",
          "kind": "supplied"
        },
        {
          "text": " as plants grown up in their youth; ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " our daughters ",
          "kind": "text"
        },
        {
          "text": "may be",
          "kind": "supplied"
        },
        {
          "text": " as corner stones, polished ",
          "kind": "text"
        },
        {
          "text": "after",
          "kind": "supplied"
        },
        {
          "text": " the similitude of a palace:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.13",
      "edition_verse_id": "WEBSTER1833:PSA.144.13",
      "verse": 13,
      "spans": [
        {
          "text": "That",
          "kind": "supplied"
        },
        {
          "text": " our granaries ",
          "kind": "text"
        },
        {
          "text": "may be",
          "kind": "supplied"
        },
        {
          "text": " full, affording all manner of store; ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " our sheep may bring forth thousands and ten thousands in our streets:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.14",
      "edition_verse_id": "WEBSTER1833:PSA.144.14",
      "verse": 14,
      "spans": [
        {
          "text": "That",
          "kind": "supplied"
        },
        {
          "text": " our oxen ",
          "kind": "text"
        },
        {
          "text": "may be",
          "kind": "supplied"
        },
        {
          "text": " strong to labor; that ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " no breaking in, nor going out; that ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " no complaining in our streets.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.144.15",
      "edition_verse_id": "WEBSTER1833:PSA.144.15",
      "verse": 15,
      "spans": [
        {
          "text": "Happy ",
          "kind": "text"
        },
        {
          "text": "is that",
          "kind": "supplied"
        },
        {
          "text": " people, that is in such a case: ",
          "kind": "text"
        },
        {
          "text": "yes",
          "kind": "supplied"
        },
        {
          "text": ", happy ",
          "kind": "text"
        },
        {
          "text": "is that",
          "kind": "supplied"
        },
        {
          "text": " people, whose God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
