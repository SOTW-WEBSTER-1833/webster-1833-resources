{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 135,
  "verses": [
    {
      "id": "PSA.135.1",
      "edition_verse_id": "WEBSTER1833:PSA.135.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye the LORD. Praise ye the name of the LORD; praise ",
          "kind": "text"
        },
        {
          "text": "him",
          "kind": "supplied"
        },
        {
          "text": ", O ye servants of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.135.2",
      "edition_verse_id": "WEBSTER1833:PSA.135.2",
      "verse": 2,
      "spans": [
        {
          "text": "Ye that stand in the house of the LORD, in the courts of the house of our God,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.3",
      "edition_verse_id": "WEBSTER1833:PSA.135.3",
      "verse": 3,
      "spans": [
        {
          "text": "Praise the LORD; for the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " good; sing praises to his name; for ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " pleasant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.4",
      "edition_verse_id": "WEBSTER1833:PSA.135.4",
      "verse": 4,
      "spans": [
        {
          "text": "For the LORD hath chosen Jacob to himself, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " Israel for his peculiar treasure.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.5",
      "edition_verse_id": "WEBSTER1833:PSA.135.5",
      "verse": 5,
      "spans": [
        {
          "text": "For I know that the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " great, and ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " our LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " above all gods.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.6",
      "edition_verse_id": "WEBSTER1833:PSA.135.6",
      "verse": 6,
      "spans": [
        {
          "text": "Whatever the LORD pleased, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " did he in heaven, and in earth, in the seas, and all deep places.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.7",
      "edition_verse_id": "WEBSTER1833:PSA.135.7",
      "verse": 7,
      "spans": [
        {
          "text": "He causeth the vapors to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.8",
      "edition_verse_id": "WEBSTER1833:PSA.135.8",
      "verse": 8,
      "spans": [
        {
          "text": "Who smote the first-born of Egypt, both of man and beast.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.9",
      "edition_verse_id": "WEBSTER1833:PSA.135.9",
      "verse": 9,
      "spans": [
        {
          "text": "Who",
          "kind": "supplied"
        },
        {
          "text": " sent tokens and wonders into the midst of thee, O Egypt, upon Pharaoh, and upon all his servants.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.10",
      "edition_verse_id": "WEBSTER1833:PSA.135.10",
      "verse": 10,
      "spans": [
        {
          "text": "Who smote great nations, and slew mighty kings;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.11",
      "edition_verse_id": "WEBSTER1833:PSA.135.11",
      "verse": 11,
      "spans": [
        {
          "text": "Sihon king of the Amorites, and Og king of Bashan, and all the kingdoms of Canaan:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.12",
      "edition_verse_id": "WEBSTER1833:PSA.135.12",
      "verse": 12,
      "spans": [
        {
          "text": "And gave their land ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a heritage, a heritage to Israel his people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.13",
      "edition_verse_id": "WEBSTER1833:PSA.135.13",
      "verse": 13,
      "spans": [
        {
          "text": "Thy name, O LORD, ",
          "kind": "text"
        },
        {
          "text": "endureth",
          "kind": "supplied"
        },
        {
          "text": " for ever; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " thy memorial, O LORD, throughout all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.14",
      "edition_verse_id": "WEBSTER1833:PSA.135.14",
      "verse": 14,
      "spans": [
        {
          "text": "For the LORD will judge his people, and he will repent concerning his servants.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.15",
      "edition_verse_id": "WEBSTER1833:PSA.135.15",
      "verse": 15,
      "spans": [
        {
          "text": "The idols of the heathen ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " silver and gold, the work of men's hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.16",
      "edition_verse_id": "WEBSTER1833:PSA.135.16",
      "verse": 16,
      "spans": [
        {
          "text": "They have mouths, but they speak not; eyes have they, but they see not.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.17",
      "edition_verse_id": "WEBSTER1833:PSA.135.17",
      "verse": 17,
      "spans": [
        {
          "text": "They have ears, but they hear not; neither is there ",
          "kind": "text"
        },
        {
          "text": "any",
          "kind": "supplied"
        },
        {
          "text": " breath in their mouths.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.18",
      "edition_verse_id": "WEBSTER1833:PSA.135.18",
      "verse": 18,
      "spans": [
        {
          "text": "They that make them are like them: ",
          "kind": "text"
        },
        {
          "text": "so is",
          "kind": "supplied"
        },
        {
          "text": " every one that trusteth in them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.19",
      "edition_verse_id": "WEBSTER1833:PSA.135.19",
      "verse": 19,
      "spans": [
        {
          "text": "Bless the LORD, O house of Israel: bless the LORD, O house of Aaron:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.20",
      "edition_verse_id": "WEBSTER1833:PSA.135.20",
      "verse": 20,
      "spans": [
        {
          "text": "Bless the LORD, O house of Levi: ye that fear the LORD, bless the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.135.21",
      "edition_verse_id": "WEBSTER1833:PSA.135.21",
      "verse": 21,
      "spans": [
        {
          "text": "Blessed be the LORD out of Zion, who dwelleth at Jerusalem. Praise ye the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
