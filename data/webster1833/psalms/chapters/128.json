    {
      "id": "PSA.128.1",
      "edition_verse_id": "WEBSTER1833:PSA.128.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Song of degrees. Blessed ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " every one that feareth the LORD; that walketh in his ways.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.128.2",
      "edition_verse_id": "WEBSTER1833:PSA.128.2",
      "verse": 2,
      "spans": [
        {
          "text": "For thou shalt eat the labor of thy hands: happy ",
          "kind": "text"
        },
        {
          "text": "shalt",
          "kind": "supplied"
        },
        {
          "text": " thou be, and ",
          "kind": "text"
        },
        {
          "text": "it shall be",
          "kind": "supplied"
        },
        {
          "text": " well with thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.128.3",
      "edition_verse_id": "WEBSTER1833:PSA.128.3",
      "verse": 3,
      "spans": [
        {
          "text": "Thy wife ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " as a fruitful vine by the sides of thy house: thy children like olive plants around thy table.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.128.4",
      "edition_verse_id": "WEBSTER1833:PSA.128.4",
      "verse": 4,
      "spans": [
        {
          "text": "Behold, that thus shall the man be blessed that feareth the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.128.5",
      "edition_verse_id": "WEBSTER1833:PSA.128.5",
      "verse": 5,
      "spans": [
        {
          "text": "The LORD shall bless thee out of Zion: and thou shalt see the good of Jerusalem all the days of thy life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.128.6",
      "edition_verse_id": "WEBSTER1833:PSA.128.6",
      "verse": 6,
      "spans": [
        {
          "text": "Yes, thou shalt see thy children's children, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " peace upon Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
