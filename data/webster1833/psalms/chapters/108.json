{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 108,
  "verses": [
    {
      "id": "PSA.108.1",
      "edition_verse_id": "WEBSTER1833:PSA.108.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Song ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " Psalm of David. O God, my heart is fixed; I will sing and give praise, even with my glory.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.108.2",
      "edition_verse_id": "WEBSTER1833:PSA.108.2",
      "verse": 2,
      "spans": [
        {
          "text": "Awake, psaltery and harp: I ",
          "kind": "text"
        },
        {
          "text": "myself",
          "kind": "supplied"
        },
        {
          "text": " will awake early.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.3",
      "edition_verse_id": "WEBSTER1833:PSA.108.3",
      "verse": 3,
      "spans": [
        {
          "text": "I will praise thee, O LORD, among the people: and I will sing praises to thee among the nations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.4",
      "edition_verse_id": "WEBSTER1833:PSA.108.4",
      "verse": 4,
      "spans": [
        {
          "text": "For thy mercy ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " great above the heavens: and thy truth ",
          "kind": "text"
        },
        {
          "text": "reacheth",
          "kind": "supplied"
        },
        {
          "text": " to the clouds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.5",
      "edition_verse_id": "WEBSTER1833:PSA.108.5",
      "verse": 5,
      "spans": [
        {
          "text": "Be thou exalted, O God, above the heavens: and thy glory above all the earth;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.6",
      "edition_verse_id": "WEBSTER1833:PSA.108.6",
      "verse": 6,
      "spans": [
        {
          "text": "That thy beloved may be delivered: save ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " thy right hand, and answer me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.7",
      "edition_verse_id": "WEBSTER1833:PSA.108.7",
      "verse": 7,
      "spans": [
        {
          "text": "God hath spoken in his holiness; I will rejoice, I will divide Shechem, and measure out the valley of Succoth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.8",
      "edition_verse_id": "WEBSTER1833:PSA.108.8",
      "verse": 8,
      "spans": [
        {
          "text": "Gilead ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " mine; Manasseh ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " mine; Ephraim also ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the strength of my head; Judah ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my lawgiver;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.9",
      "edition_verse_id": "WEBSTER1833:PSA.108.9",
      "verse": 9,
      "spans": [
        {
          "text": "Moab ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my washpot; over Edom will I cast out my shoe; over Philistia will I triumph.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.10",
      "edition_verse_id": "WEBSTER1833:PSA.108.10",
      "verse": 10,
      "spans": [
        {
          "text": "Who will bring me into the strong city: who will lead me into Edom?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.11",
      "edition_verse_id": "WEBSTER1833:PSA.108.11",
      "verse": 11,
      "spans": [
        {
          "text": "Wilt",
          "kind": "supplied"
        },
        {
          "text": " not ",
          "kind": "text"
        },
        {
          "text": "thou",
          "kind": "supplied"
        },
        {
          "text": ", O God, ",
          "kind": "text"
        },
        {
          "text": "who",
          "kind": "supplied"
        },
        {
          "text": " hast cast us off? and wilt not thou, O God, go forth with our armies?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.12",
      "edition_verse_id": "WEBSTER1833:PSA.108.12",
      "verse": 12,
      "spans": [
        {
          "text": "Give us help from trouble: for vain ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the help of man.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.108.13",
      "edition_verse_id": "WEBSTER1833:PSA.108.13",
      "verse": 13,
      "spans": [
        {
          "text": "Through God we shall do valiantly: for he will tread down our enemies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
