{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 29,
  "verses": [
    {
      "id": "PSA.29.1",
      "edition_verse_id": "WEBSTER1833:PSA.29.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David. Give to the LORD, O ye mighty, give to the LORD glory and strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.29.2",
      "edition_verse_id": "WEBSTER1833:PSA.29.2",
      "verse": 2,
      "spans": [
        {
          "text": "Give to the LORD, the glory due to his name; worship the LORD in the beauty of holiness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.3",
      "edition_verse_id": "WEBSTER1833:PSA.29.3",
      "verse": 3,
      "spans": [
        {
          "text": "The voice of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon the waters: the God of glory thundereth: the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon many waters.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.4",
      "edition_verse_id": "WEBSTER1833:PSA.29.4",
      "verse": 4,
      "spans": [
        {
          "text": "The voice of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " powerful; the voice of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " full of majesty.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.5",
      "edition_verse_id": "WEBSTER1833:PSA.29.5",
      "verse": 5,
      "spans": [
        {
          "text": "The voice of the LORD breaketh the cedars; yes, the LORD breaketh the cedars of Lebanon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.6",
      "edition_verse_id": "WEBSTER1833:PSA.29.6",
      "verse": 6,
      "spans": [
        {
          "text": "He maketh them also to skip like a calf; Lebanon and Sirion like a young unicorn.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.7",
      "edition_verse_id": "WEBSTER1833:PSA.29.7",
      "verse": 7,
      "spans": [
        {
          "text": "The voice of the LORD divideth the flames of fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.8",
      "edition_verse_id": "WEBSTER1833:PSA.29.8",
      "verse": 8,
      "spans": [
        {
          "text": "The voice of the LORD shaketh the wilderness; the LORD shaketh the wilderness of Kadesh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.9",
      "edition_verse_id": "WEBSTER1833:PSA.29.9",
      "verse": 9,
      "spans": [
        {
          "text": "The voice of the LORD maketh the hinds to calve, and maketh bare the forests: and in his temple doth every one speak of ",
          "kind": "text"
        },
        {
          "text": "his",
          "kind": "supplied"
        },
        {
          "text": " glory.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.10",
      "edition_verse_id": "WEBSTER1833:PSA.29.10",
      "verse": 10,
      "spans": [
        {
          "text": "The LORD sitteth upon the flood; yes, the LORD sitteth king for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.11",
      "edition_verse_id": "WEBSTER1833:PSA.29.11",
      "verse": 11,
      "spans": [
        {
          "text": "The LORD will give strength to his people; the LORD will bless his people with peace.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
