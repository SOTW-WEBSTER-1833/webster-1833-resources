{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 36,
  "verses": [
    {
      "id": "PSA.36.1",
      "edition_verse_id": "WEBSTER1833:PSA.36.1",
      "verse": 1,
      "spans": [
        {
          "text": "To the chief Musician, ",
          "kind": "text"
        },
        {
          "text": "A Psalm",
          "kind": "supplied"
        },
        {
          "text": " of David the servant of the LORD. The transgression of the wicked saith within my heart, ",
          "kind": "text"
        },
        {
          "text": "that there is",
          "kind": "supplied"
        },
        {
          "text": " no fear of God before his eyes.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.36.2",
      "edition_verse_id": "WEBSTER1833:PSA.36.2",
      "verse": 2,
      "spans": [
        {
          "text": "For he flattereth himself in his own eyes, until his iniquity is found to be hateful.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.3",
      "edition_verse_id": "WEBSTER1833:PSA.36.3",
      "verse": 3,
      "spans": [
        {
          "text": "The words of his mouth ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " iniquity and deceit: he hath ceased to be wise, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " to do good.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.4",
      "edition_verse_id": "WEBSTER1833:PSA.36.4",
      "verse": 4,
      "spans": [
        {
          "text": "He deviseth mischief upon his bed; he setteth himself in a way ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": " not good; he abhorreth not evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.5",
      "edition_verse_id": "WEBSTER1833:PSA.36.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thy mercy, O LORD, ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in the heavens; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " thy faithfulness ",
          "kind": "text"
        },
        {
          "text": "reacheth",
          "kind": "supplied"
        },
        {
          "text": " to the clouds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.6",
      "edition_verse_id": "WEBSTER1833:PSA.36.6",
      "verse": 6,
      "spans": [
        {
          "text": "Thy righteousness ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " like the great mountains; thy judgments ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " a great deep: O LORD, thou preservest man and beast.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.7",
      "edition_verse_id": "WEBSTER1833:PSA.36.7",
      "verse": 7,
      "spans": [
        {
          "text": "How excellent ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " thy loving-kindness, O God! therefore the children of men put their trust under the shadow of thy wings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.8",
      "edition_verse_id": "WEBSTER1833:PSA.36.8",
      "verse": 8,
      "spans": [
        {
          "text": "They shall be abundantly satisfied with the fatness of thy house; and thou shalt make them drink of the river of thy pleasures.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.9",
      "edition_verse_id": "WEBSTER1833:PSA.36.9",
      "verse": 9,
      "spans": [
        {
          "text": "For with thee ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the fountain of life: in thy light shall we see light.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.10",
      "edition_verse_id": "WEBSTER1833:PSA.36.10",
      "verse": 10,
      "spans": [
        {
          "text": "O continue thy loving-kindness to them that know thee; and thy righteousness to the upright in heart.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.11",
      "edition_verse_id": "WEBSTER1833:PSA.36.11",
      "verse": 11,
      "spans": [
        {
          "text": "Let not the foot of pride come against me, and let not the hand of the wicked remove me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.36.12",
      "edition_verse_id": "WEBSTER1833:PSA.36.12",
      "verse": 12,
      "spans": [
        {
          "text": "There are the workers of iniquity fallen: they are cast down, and shall not be able to rise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
