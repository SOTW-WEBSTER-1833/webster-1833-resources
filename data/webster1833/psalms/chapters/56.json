{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 56,
  "verses": [
    {
      "id": "PSA.56.1",
      "edition_verse_id": "WEBSTER1833:PSA.56.1",
      "verse": 1,
      "spans": [
        {
          "text": "To the chief Musician upon Jonathelem-rechokim, Michtam of David, when the Philistines took him in Gath. Be merciful to me, O God: for man would swallow me up; he fighting daily oppresseth me.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.56.2",
      "edition_verse_id": "WEBSTER1833:PSA.56.2",
      "verse": 2,
      "spans": [
        {
          "text": "My enemies would daily swallow ",
          "kind": "text"
        },
        {
          "text": "me",
          "kind": "supplied"
        },
        {
          "text": " up: for ",
          "kind": "text"
        },
        {
          "text": "they are",
          "kind": "supplied"
        },
        {
          "text": " many that fight against me, O thou Most High.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.3",
      "edition_verse_id": "WEBSTER1833:PSA.56.3",
      "verse": 3,
      "spans": [
        {
          "text": "In the time when I am afraid, I will trust in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.4",
      "edition_verse_id": "WEBSTER1833:PSA.56.4",
      "verse": 4,
      "spans": [
        {
          "text": "In God I will praise his word, in God I have put my trust; I will not fear what flesh can do to me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.5",
      "edition_verse_id": "WEBSTER1833:PSA.56.5",
      "verse": 5,
      "spans": [
        {
          "text": "Every day they wrest my words: all their thoughts ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " against me for evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.6",
      "edition_verse_id": "WEBSTER1833:PSA.56.6",
      "verse": 6,
      "spans": [
        {
          "text": "They assemble themselves, they hide themselves, they mark my steps, when they wait for my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.7",
      "edition_verse_id": "WEBSTER1833:PSA.56.7",
      "verse": 7,
      "spans": [
        {
          "text": "Shall they escape by iniquity; in ",
          "kind": "text"
        },
        {
          "text": "thy",
          "kind": "supplied"
        },
        {
          "text": " anger cast down the people, O God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.8",
      "edition_verse_id": "WEBSTER1833:PSA.56.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou numberest my wanderings: put thou my tears into thy bottle: ",
          "kind": "text"
        },
        {
          "text": "are they",
          "kind": "supplied"
        },
        {
          "text": " not in thy book?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.9",
      "edition_verse_id": "WEBSTER1833:PSA.56.9",
      "verse": 9,
      "spans": [
        {
          "text": "When I cry ",
          "kind": "text"
        },
        {
          "text": "to thee",
          "kind": "supplied"
        },
        {
          "text": ", then shall my enemies turn back: this I know; for God ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " for me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.10",
      "edition_verse_id": "WEBSTER1833:PSA.56.10",
      "verse": 10,
      "spans": [
        {
          "text": "In God will I praise ",
          "kind": "text"
        },
        {
          "text": "his",
          "kind": "supplied"
        },
        {
          "text": " word: in the LORD will I praise ",
          "kind": "text"
        },
        {
          "text": "his",
          "kind": "supplied"
        },
        {
          "text": " word.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.11",
      "edition_verse_id": "WEBSTER1833:PSA.56.11",
      "verse": 11,
      "spans": [
        {
          "text": "In God have I put my trust: I will not be afraid what man can do to me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.12",
      "edition_verse_id": "WEBSTER1833:PSA.56.12",
      "verse": 12,
      "spans": [
        {
          "text": "Thy vows ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " upon me, O God: I will render praises to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.56.13",
      "edition_verse_id": "WEBSTER1833:PSA.56.13",
      "verse": 13,
      "spans": [
        {
          "text": "For thou hast delivered my soul from death: ",
          "kind": "text"
        },
        {
          "text": "wilt thou",
          "kind": "supplied"
        },
        {
          "text": " not ",
          "kind": "text"
        },
        {
          "text": "deliver",
          "kind": "supplied"
        },
        {
          "text": " my feet from falling, that I may walk before God in the light of the living?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
