{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 112,
  "verses": [
    {
      "id": "PSA.112.1",
      "edition_verse_id": "WEBSTER1833:PSA.112.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye the LORD. Blessed ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the man ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " feareth the LORD, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " delighteth greatly in his commandments.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.112.2",
      "edition_verse_id": "WEBSTER1833:PSA.112.2",
      "verse": 2,
      "spans": [
        {
          "text": "His seed shall be mighty upon earth: the generation of the upright shall be blessed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.3",
      "edition_verse_id": "WEBSTER1833:PSA.112.3",
      "verse": 3,
      "spans": [
        {
          "text": "Wealth and riches ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " in his house: and his righteousness endureth for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.4",
      "edition_verse_id": "WEBSTER1833:PSA.112.4",
      "verse": 4,
      "spans": [
        {
          "text": "To the upright there ariseth light in darkness: ",
          "kind": "text"
        },
        {
          "text": "he is",
          "kind": "supplied"
        },
        {
          "text": " gracious, and full of compassion, and righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.5",
      "edition_verse_id": "WEBSTER1833:PSA.112.5",
      "verse": 5,
      "spans": [
        {
          "text": "A good man showeth favor, and lendeth: he will guide his affairs with discretion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.6",
      "edition_verse_id": "WEBSTER1833:PSA.112.6",
      "verse": 6,
      "spans": [
        {
          "text": "Surely he shall not be moved for ever: the righteous shall be in everlasting remembrance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.7",
      "edition_verse_id": "WEBSTER1833:PSA.112.7",
      "verse": 7,
      "spans": [
        {
          "text": "He shall not be afraid of evil tidings: his heart is fixed, trusting in the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.8",
      "edition_verse_id": "WEBSTER1833:PSA.112.8",
      "verse": 8,
      "spans": [
        {
          "text": "His heart ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " established, he shall not be afraid, until he seeth ",
          "kind": "text"
        },
        {
          "text": "his desire",
          "kind": "supplied"
        },
        {
          "text": " upon his enemies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.9",
      "edition_verse_id": "WEBSTER1833:PSA.112.9",
      "verse": 9,
      "spans": [
        {
          "text": "He hath dispersed, he hath given to the poor; his righteousness endureth for ever; his horn shall be exalted with honor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.112.10",
      "edition_verse_id": "WEBSTER1833:PSA.112.10",
      "verse": 10,
      "spans": [
        {
          "text": "The wicked shall see ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", and be grieved; he shall gnash with his teeth, and melt away: the desire of the wicked shall perish.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
