{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 143,
  "verses": [
    {
      "id": "PSA.143.1",
      "edition_verse_id": "WEBSTER1833:PSA.143.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David. Hear my prayer, O LORD, give ear to my supplications: in thy faithfulness answer me, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " in thy righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.143.2",
      "edition_verse_id": "WEBSTER1833:PSA.143.2",
      "verse": 2,
      "spans": [
        {
          "text": "And enter not into judgment with thy servant: for in thy sight shall no man living be justified.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.3",
      "edition_verse_id": "WEBSTER1833:PSA.143.3",
      "verse": 3,
      "spans": [
        {
          "text": "For the enemy hath persecuted my soul; he hath smitten my life down to the ground; he hath made me to dwell in darkness, as those that have been long dead.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.4",
      "edition_verse_id": "WEBSTER1833:PSA.143.4",
      "verse": 4,
      "spans": [
        {
          "text": "Therefore is my spirit overwhelmed within me; my heart within me is desolate.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.5",
      "edition_verse_id": "WEBSTER1833:PSA.143.5",
      "verse": 5,
      "spans": [
        {
          "text": "I remember the days of old, I meditate on all thy works; I muse on the work of thy hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.6",
      "edition_verse_id": "WEBSTER1833:PSA.143.6",
      "verse": 6,
      "spans": [
        {
          "text": "I stretch forth my hands to thee: my soul ",
          "kind": "text"
        },
        {
          "text": "thirsteth",
          "kind": "supplied"
        },
        {
          "text": " after thee, as a thirsty land. Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.7",
      "edition_verse_id": "WEBSTER1833:PSA.143.7",
      "verse": 7,
      "spans": [
        {
          "text": "Hear me speedily, O LORD: my spirit faileth: hide not thy face from me, lest I be like them that go down into the pit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.8",
      "edition_verse_id": "WEBSTER1833:PSA.143.8",
      "verse": 8,
      "spans": [
        {
          "text": "Cause me to hear thy loving-kindness in the morning; for in thee do I trust: cause me to know the way in which I should walk; for I lift up my soul to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.9",
      "edition_verse_id": "WEBSTER1833:PSA.143.9",
      "verse": 9,
      "spans": [
        {
          "text": "Deliver me, O LORD, from my enemies: I flee to thee to hide me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.10",
      "edition_verse_id": "WEBSTER1833:PSA.143.10",
      "verse": 10,
      "spans": [
        {
          "text": "Teach me to do thy will; for thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " my God: thy spirit ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " good; lead me into the land of uprightness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.11",
      "edition_verse_id": "WEBSTER1833:PSA.143.11",
      "verse": 11,
      "spans": [
        {
          "text": "Revive me, O LORD, for thy name's sake: for thy righteousness' sake bring my soul out of trouble.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.143.12",
      "edition_verse_id": "WEBSTER1833:PSA.143.12",
      "verse": 12,
      "spans": [
        {
          "text": "And of thy mercy cut off my enemies, and destroy all them that afflict my soul: for I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " thy servant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
