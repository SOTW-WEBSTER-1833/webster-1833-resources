{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 88,
  "verses": [
    {
      "id": "PSA.88.1",
      "edition_verse_id": "WEBSTER1833:PSA.88.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Song ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " Psalm for the sons of Korah, to the chief Musician upon Mahalath Leannoth, Maschil of Heman the Ezrahite. O LORD God of my salvation, I have cried day ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " night before thee:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.2",
      "edition_verse_id": "WEBSTER1833:PSA.88.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let my prayer come before thee: incline thy ear to my cry;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.3",
      "edition_verse_id": "WEBSTER1833:PSA.88.3",
      "verse": 3,
      "spans": [
        {
          "text": "For my soul is full of troubles: and my life draweth nigh to the grave.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.4",
      "edition_verse_id": "WEBSTER1833:PSA.88.4",
      "verse": 4,
      "spans": [
        {
          "text": "I am counted with them that go down into the pit: I am as a man ",
          "kind": "text"
        },
        {
          "text": "that hath",
          "kind": "supplied"
        },
        {
          "text": " no strength:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.5",
      "edition_verse_id": "WEBSTER1833:PSA.88.5",
      "verse": 5,
      "spans": [
        {
          "text": "Free among the dead, like the slain that lie in the grave, whom thou rememberest no more: and they are cut off from thy hand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.6",
      "edition_verse_id": "WEBSTER1833:PSA.88.6",
      "verse": 6,
      "spans": [
        {
          "text": "Thou hast laid me in the lowest pit, in darkness, in the deeps.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.7",
      "edition_verse_id": "WEBSTER1833:PSA.88.7",
      "verse": 7,
      "spans": [
        {
          "text": "Thy wrath lieth hard upon me, and thou hast afflicted ",
          "kind": "text"
        },
        {
          "text": "me",
          "kind": "supplied"
        },
        {
          "text": " with all thy waves. Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.8",
      "edition_verse_id": "WEBSTER1833:PSA.88.8",
      "verse": 8,
      "spans": [
        {
          "text": "Thou hast put away my acquaintance far from me; thou hast made me an abomination to them: ",
          "kind": "text"
        },
        {
          "text": "I am",
          "kind": "supplied"
        },
        {
          "text": " shut up, and I cannot come forth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.9",
      "edition_verse_id": "WEBSTER1833:PSA.88.9",
      "verse": 9,
      "spans": [
        {
          "text": "My eye mourneth by reason of affliction: LORD, I have called daily upon thee, I have stretched out my hands to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.10",
      "edition_verse_id": "WEBSTER1833:PSA.88.10",
      "verse": 10,
      "spans": [
        {
          "text": "Wilt thou show wonders to the dead? shall the dead arise ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " praise thee? Selah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.11",
      "edition_verse_id": "WEBSTER1833:PSA.88.11",
      "verse": 11,
      "spans": [
        {
          "text": "Shall thy loving-kindness be declared in the grave? ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " thy faithfulness in destruction?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.12",
      "edition_verse_id": "WEBSTER1833:PSA.88.12",
      "verse": 12,
      "spans": [
        {
          "text": "Shall thy wonders be known in the dark? and thy righteousness in the land of forgetfulness?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.13",
      "edition_verse_id": "WEBSTER1833:PSA.88.13",
      "verse": 13,
      "spans": [
        {
          "text": "But to thee have I cried, O LORD; and in the morning shall my prayer come before thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.14",
      "edition_verse_id": "WEBSTER1833:PSA.88.14",
      "verse": 14,
      "spans": [
        {
          "text": "LORD, why castest thou off my soul? ",
          "kind": "text"
        },
        {
          "text": "why",
          "kind": "supplied"
        },
        {
          "text": " hidest thou thy face from me?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.15",
      "edition_verse_id": "WEBSTER1833:PSA.88.15",
      "verse": 15,
      "spans": [
        {
          "text": "I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " afflicted and ready to die from ",
          "kind": "text"
        },
        {
          "text": "my",
          "kind": "supplied"
        },
        {
          "text": " youth up: ",
          "kind": "text"
        },
        {
          "text": "while",
          "kind": "supplied"
        },
        {
          "text": " I suffer thy terrors I am distracted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.16",
      "edition_verse_id": "WEBSTER1833:PSA.88.16",
      "verse": 16,
      "spans": [
        {
          "text": "Thy fierce wrath goeth over me; thy terrors have cut me off.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.17",
      "edition_verse_id": "WEBSTER1833:PSA.88.17",
      "verse": 17,
      "spans": [
        {
          "text": "They came around me daily like water; they encompassed me together.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.18",
      "edition_verse_id": "WEBSTER1833:PSA.88.18",
      "verse": 18,
      "spans": [
        {
          "text": "Lover and friend hast thou put far from me, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my acquaintance into darkness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
