{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 25,
  "verses": [
    {
      "id": "PSA.25.1",
      "edition_verse_id": "WEBSTER1833:PSA.25.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm",
          "kind": "supplied"
        },
        {
          "text": " of David. To thee, O LORD, do I lift up my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.2",
      "edition_verse_id": "WEBSTER1833:PSA.25.2",
      "verse": 2,
      "spans": [
        {
          "text": "O my God, I trust in thee: let me not be ashamed, let not my enemies triumph over me,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.3",
      "edition_verse_id": "WEBSTER1833:PSA.25.3",
      "verse": 3,
      "spans": [
        {
          "text": "Also, let none that wait on thee be ashamed: let them be ashamed who transgress without cause.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.4",
      "edition_verse_id": "WEBSTER1833:PSA.25.4",
      "verse": 4,
      "spans": [
        {
          "text": "Show me thy ways, O LORD; teach me thy paths.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.5",
      "edition_verse_id": "WEBSTER1833:PSA.25.5",
      "verse": 5,
      "spans": [
        {
          "text": "Lead me in thy truth, and teach me: for thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " the God of my salvation; on thee do I wait all the day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.6",
      "edition_verse_id": "WEBSTER1833:PSA.25.6",
      "verse": 6,
      "spans": [
        {
          "text": "Remember, O LORD, thy tender mercies and thy loving kindnesses; for they ",
          "kind": "text"
        },
        {
          "text": "have been",
          "kind": "supplied"
        },
        {
          "text": " ever of old.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.7",
      "edition_verse_id": "WEBSTER1833:PSA.25.7",
      "verse": 7,
      "spans": [
        {
          "text": "Remember not the sins of my youth, nor my transgressions: according to thy mercy remember thou me for thy goodness' sake, O LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.8",
      "edition_verse_id": "WEBSTER1833:PSA.25.8",
      "verse": 8,
      "spans": [
        {
          "text": "Good and upright ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the LORD: therefore will he teach sinners in the way.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.9",
      "edition_verse_id": "WEBSTER1833:PSA.25.9",
      "verse": 9,
      "spans": [
        {
          "text": "The meek will he guide in judgment: and the meek will he teach his way.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.10",
      "edition_verse_id": "WEBSTER1833:PSA.25.10",
      "verse": 10,
      "spans": [
        {
          "text": "All the paths of the LORD ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " mercy and truth to such as keep his covenant and his testimonies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.11",
      "edition_verse_id": "WEBSTER1833:PSA.25.11",
      "verse": 11,
      "spans": [
        {
          "text": "For thy name's sake, O LORD, pardon my iniquity; for it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " great.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.12",
      "edition_verse_id": "WEBSTER1833:PSA.25.12",
      "verse": 12,
      "spans": [
        {
          "text": "What man ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " he that feareth the LORD? him shall he teach in the way ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " he shall choose.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.13",
      "edition_verse_id": "WEBSTER1833:PSA.25.13",
      "verse": 13,
      "spans": [
        {
          "text": "His soul shall dwell at ease; and his seed shall inherit the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.14",
      "edition_verse_id": "WEBSTER1833:PSA.25.14",
      "verse": 14,
      "spans": [
        {
          "text": "The secret of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " with them that fear him; and he will show them his covenant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.15",
      "edition_verse_id": "WEBSTER1833:PSA.25.15",
      "verse": 15,
      "spans": [
        {
          "text": "My eyes ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " ever towards the LORD; for he will pluck my feet out of the net.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.16",
      "edition_verse_id": "WEBSTER1833:PSA.25.16",
      "verse": 16,
      "spans": [
        {
          "text": "Turn thee to me, and have mercy upon me; for I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " desolate and afflicted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.17",
      "edition_verse_id": "WEBSTER1833:PSA.25.17",
      "verse": 17,
      "spans": [
        {
          "text": "The troubles of my heart are enlarged: O bring thou me out of my distresses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.18",
      "edition_verse_id": "WEBSTER1833:PSA.25.18",
      "verse": 18,
      "spans": [
        {
          "text": "Look upon my affliction and my pain; and forgive all my sins.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.19",
      "edition_verse_id": "WEBSTER1833:PSA.25.19",
      "verse": 19,
      "spans": [
        {
          "text": "Consider my enemies, for they are many; and they hate me with cruel hatred.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.20",
      "edition_verse_id": "WEBSTER1833:PSA.25.20",
      "verse": 20,
      "spans": [
        {
          "text": "O keep my soul, and deliver me: let me not be ashamed; for I put my trust in thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.21",
      "edition_verse_id": "WEBSTER1833:PSA.25.21",
      "verse": 21,
      "spans": [
        {
          "text": "Let integrity and uprightness preserve me; for I wait on thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.22",
      "edition_verse_id": "WEBSTER1833:PSA.25.22",
      "verse": 22,
      "spans": [
        {
          "text": "Redeem Israel, O God, out of all his troubles.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
