  "chapter": 123,
  "verses": [
    {
      "id": "PSA.123.1",
      "edition_verse_id": "WEBSTER1833:PSA.123.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Song of degrees. To thee I raise my eyes, O thou that dwellest in the heavens.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.123.2",
      "edition_verse_id": "WEBSTER1833:PSA.123.2",
      "verse": 2,
      "spans": [
        {
          "text": "Behold, as the eyes of servants ",
          "kind": "text"
        },
        {
          "text": "look",
          "kind": "supplied"
        },
        {
          "text": " to the hand of their masters, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " as the eyes of a maiden to the hand of her mistress; so our eyes ",
          "kind": "text"
        },
        {
          "text": "wait",
          "kind": "supplied"
        },
        {
          "text": " upon the LORD our God, until he shall have mercy upon us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.123.3",
      "edition_verse_id": "WEBSTER1833:PSA.123.3",
      "verse": 3,
      "spans": [
        {
          "text": "Have mercy upon us, O LORD, have mercy upon us; for we are exceedingly filled with contempt.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.123.4",
      "edition_verse_id": "WEBSTER1833:PSA.123.4",
      "verse": 4,
      "spans": [
        {
          "text": "Our soul is exceedingly filled with the scorning of those that are at ease, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " with the contempt of the proud.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
