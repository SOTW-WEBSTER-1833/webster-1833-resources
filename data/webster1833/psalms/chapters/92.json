{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 92,
  "verses": [
    {
      "id": "PSA.92.1",
      "edition_verse_id": "WEBSTER1833:PSA.92.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " Song for the sabbath day. ",
          "kind": "text"
        },
        {
          "text": "It is a",
          "kind": "supplied"
        },
        {
          "text": " good ",
          "kind": "text"
        },
        {
          "text": "thing",
          "kind": "supplied"
        },
        {
          "text": " to give thanks to the LORD, and to sing praises to thy name, O Most High.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.92.2",
      "edition_verse_id": "WEBSTER1833:PSA.92.2",
      "verse": 2,
      "spans": [
        {
          "text": "To show forth thy loving-kindness in the morning, and thy faithfulness every night.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.3",
      "edition_verse_id": "WEBSTER1833:PSA.92.3",
      "verse": 3,
      "spans": [
        {
          "text": "Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.4",
      "edition_verse_id": "WEBSTER1833:PSA.92.4",
      "verse": 4,
      "spans": [
        {
          "text": "For thou, LORD, hast made me glad through thy work: I will triumph in the works of thy hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.5",
      "edition_verse_id": "WEBSTER1833:PSA.92.5",
      "verse": 5,
      "spans": [
        {
          "text": "O LORD, how great are thy works! ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " thy thoughts are very deep.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.6",
      "edition_verse_id": "WEBSTER1833:PSA.92.6",
      "verse": 6,
      "spans": [
        {
          "text": "A brutish man knoweth not; neither doth a fool understand this.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.7",
      "edition_verse_id": "WEBSTER1833:PSA.92.7",
      "verse": 7,
      "spans": [
        {
          "text": "When the wicked spring as the grass, and when all the workers of iniquity do flourish; ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " that they shall be destroyed for ever:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.8",
      "edition_verse_id": "WEBSTER1833:PSA.92.8",
      "verse": 8,
      "spans": [
        {
          "text": "But thou, LORD, ",
          "kind": "text"
        },
        {
          "text": "art most",
          "kind": "supplied"
        },
        {
          "text": " high for evermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.9",
      "edition_verse_id": "WEBSTER1833:PSA.92.9",
      "verse": 9,
      "spans": [
        {
          "text": "For lo, thy enemies, O LORD, for lo, thy enemies shall perish; all the workers of iniquity shall be scattered.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.10",
      "edition_verse_id": "WEBSTER1833:PSA.92.10",
      "verse": 10,
      "spans": [
        {
          "text": "But my horn shalt thou exalt like ",
          "kind": "text"
        },
        {
          "text": "the horn of",
          "kind": "supplied"
        },
        {
          "text": " an unicorn: I shall be anointed with fresh oil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.11",
      "edition_verse_id": "WEBSTER1833:PSA.92.11",
      "verse": 11,
      "spans": [
        {
          "text": "My eye also shall see ",
          "kind": "text"
        },
        {
          "text": "my desire",
          "kind": "supplied"
        },
        {
          "text": " on my enemies, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my ears shall hear ",
          "kind": "text"
        },
        {
          "text": "my desire",
          "kind": "supplied"
        },
        {
          "text": " of the wicked that rise up against me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.12",
      "edition_verse_id": "WEBSTER1833:PSA.92.12",
      "verse": 12,
      "spans": [
        {
          "text": "The righteous shall flourish like the palm-tree; he shall grow like a cedar in Lebanon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.13",
      "edition_verse_id": "WEBSTER1833:PSA.92.13",
      "verse": 13,
      "spans": [
        {
          "text": "Those that are planted in the house of the LORD shall flourish in the courts of our God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.14",
      "edition_verse_id": "WEBSTER1833:PSA.92.14",
      "verse": 14,
      "spans": [
        {
          "text": "They shall still bring forth fruit in old age; they shall be fat and flourishing;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.92.15",
      "edition_verse_id": "WEBSTER1833:PSA.92.15",
      "verse": 15,
      "spans": [
        {
          "text": "To show that the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upright: ",
          "kind": "text"
        },
        {
          "text": "he is",
          "kind": "supplied"
        },
        {
          "text": " my rock, and ",
          "kind": "text"
        },
        {
          "text": "there is",
          "kind": "supplied"
        },
        {
          "text": " no unrighteousness in him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
