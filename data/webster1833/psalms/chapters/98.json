{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 98,
  "verses": [
    {
      "id": "PSA.98.1",
      "edition_verse_id": "WEBSTER1833:PSA.98.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm. O sing to the LORD a new song; for he hath done marvelous things: his right hand, and his holy arm, hath gotten him the victory.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.98.2",
      "edition_verse_id": "WEBSTER1833:PSA.98.2",
      "verse": 2,
      "spans": [
        {
          "text": "The LORD hath made known his salvation: his righteousness hath he openly shown in the sight of the heathen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.3",
      "edition_verse_id": "WEBSTER1833:PSA.98.3",
      "verse": 3,
      "spans": [
        {
          "text": "He hath remembered his mercy and his truth towards the house of Israel: all the ends of the earth have seen the salvation of our God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.4",
      "edition_verse_id": "WEBSTER1833:PSA.98.4",
      "verse": 4,
      "spans": [
        {
          "text": "Make a joyful noise to the LORD, all the earth: make a loud noise, and rejoice, and sing praise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.5",
      "edition_verse_id": "WEBSTER1833:PSA.98.5",
      "verse": 5,
      "spans": [
        {
          "text": "Sing to the LORD with the harp; with the harp, and the voice of a psalm.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.6",
      "edition_verse_id": "WEBSTER1833:PSA.98.6",
      "verse": 6,
      "spans": [
        {
          "text": "With trumpets and sound of cornet make a joyful noise before the LORD, the King.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.7",
      "edition_verse_id": "WEBSTER1833:PSA.98.7",
      "verse": 7,
      "spans": [
        {
          "text": "Let the sea roar, and the fullness of it, the world, and they that dwell therein.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.8",
      "edition_verse_id": "WEBSTER1833:PSA.98.8",
      "verse": 8,
      "spans": [
        {
          "text": "Let the floods clap ",
          "kind": "text"
        },
        {
          "text": "their",
          "kind": "supplied"
        },
        {
          "text": " hands: let the hills be joyful together",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.98.9",
      "edition_verse_id": "WEBSTER1833:PSA.98.9",
      "verse": 9,
      "spans": [
        {
          "text": "Before the LORD; for he cometh to judge the earth: with righteousness will he judge the world, and the people with equity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
