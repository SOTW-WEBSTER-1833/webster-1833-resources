  "chapter": 63,
  "verses": [
    {
      "id": "PSA.63.1",
      "edition_verse_id": "WEBSTER1833:PSA.63.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David, when he was in the wilderness of Judah. O God, thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " my God; early will I seek thee: my soul thirsteth for thee, my flesh longeth for thee in a dry and thirsty land, where no water is;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.63.2",
      "edition_verse_id": "WEBSTER1833:PSA.63.2",
      "verse": 2,
      "spans": [
        {
          "text": "To see thy power and thy glory, so ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " I have seen thee in the sanctuary.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.3",
      "edition_verse_id": "WEBSTER1833:PSA.63.3",
      "verse": 3,
      "spans": [
        {
          "text": "Because thy loving-kindness ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " better than life, my lips shall praise thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.4",
      "edition_verse_id": "WEBSTER1833:PSA.63.4",
      "verse": 4,
      "spans": [
        {
          "text": "Thus will I bless thee while I live: I will lift up my hands in thy name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.5",
      "edition_verse_id": "WEBSTER1833:PSA.63.5",
      "verse": 5,
      "spans": [
        {
          "text": "My soul shall be satisfied as ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " marrow and fatness; and my mouth shall praise ",
          "kind": "text"
        },
        {
          "text": "thee",
          "kind": "supplied"
        },
        {
          "text": " with joyful lips:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.6",
      "edition_verse_id": "WEBSTER1833:PSA.63.6",
      "verse": 6,
      "spans": [
        {
          "text": "When I remember thee upon my bed, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " meditate on thee in the ",
          "kind": "text"
        },
        {
          "text": "night",
          "kind": "supplied"
        },
        {
          "text": " watches.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.7",
      "edition_verse_id": "WEBSTER1833:PSA.63.7",
      "verse": 7,
      "spans": [
        {
          "text": "Because thou hast been my help, therefore in the shadow of thy wings will I rejoice.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.8",
      "edition_verse_id": "WEBSTER1833:PSA.63.8",
      "verse": 8,
      "spans": [
        {
          "text": "My soul followeth hard after thee: thy right hand upholdeth me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.9",
      "edition_verse_id": "WEBSTER1833:PSA.63.9",
      "verse": 9,
      "spans": [
        {
          "text": "But those ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " seek my soul to destroy ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", shall go into the lower parts of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.10",
      "edition_verse_id": "WEBSTER1833:PSA.63.10",
      "verse": 10,
      "spans": [
        {
          "text": "They shall fall by the sword: they shall be a portion for foxes.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.11",
      "edition_verse_id": "WEBSTER1833:PSA.63.11",
      "verse": 11,
      "spans": [
        {
          "text": "But the king shall rejoice in God; every one that sweareth by him shall glory: but the mouth of them that speak lies shall be stopped.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
