{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PSA",
  "chapter": 111,
  "verses": [
    {
      "id": "PSA.111.1",
      "edition_verse_id": "WEBSTER1833:PSA.111.1",
      "verse": 1,
      "spans": [
        {
          "text": "Praise ye the LORD. I will praise the LORD with ",
          "kind": "text"
        },
        {
          "text": "my",
          "kind": "supplied"
        },
        {
          "text": " whole heart, in the assembly of the upright, and ",
          "kind": "text"
        },
        {
          "text": "in",
          "kind": "supplied"
        },
        {
          "text": " the congregation.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.111.2",
      "edition_verse_id": "WEBSTER1833:PSA.111.2",
      "verse": 2,
      "spans": [
        {
          "text": "The works of the LORD ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " great, sought out by all them that have pleasure in them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.3",
      "edition_verse_id": "WEBSTER1833:PSA.111.3",
      "verse": 3,
      "spans": [
        {
          "text": "His work ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " honorable and glorious: and his righteousness endureth for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.4",
      "edition_verse_id": "WEBSTER1833:PSA.111.4",
      "verse": 4,
      "spans": [
        {
          "text": "He hath made his wonderful works to be remembered: the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " gracious and full of compassion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.5",
      "edition_verse_id": "WEBSTER1833:PSA.111.5",
      "verse": 5,
      "spans": [
        {
          "text": "He hath given food to them that fear him: he will ever be mindful of his covenant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.6",
      "edition_verse_id": "WEBSTER1833:PSA.111.6",
      "verse": 6,
      "spans": [
        {
          "text": "He hath shown his people the power of his works, that he may give them the heritage of the heathen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.7",
      "edition_verse_id": "WEBSTER1833:PSA.111.7",
      "verse": 7,
      "spans": [
        {
          "text": "The works of his hands ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " verity and judgment; all his commandments ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " sure.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.8",
      "edition_verse_id": "WEBSTER1833:PSA.111.8",
      "verse": 8,
      "spans": [
        {
          "text": "They stand fast for ever and ever, ",
          "kind": "text"
        },
        {
          "text": "and are",
          "kind": "supplied"
        },
        {
          "text": " done in truth and uprightness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.9",
      "edition_verse_id": "WEBSTER1833:PSA.111.9",
      "verse": 9,
      "spans": [
        {
          "text": "He sent redemption to his people: he hath commanded his covenant for ever: holy and reverend ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " his name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.111.10",
      "edition_verse_id": "WEBSTER1833:PSA.111.10",
      "verse": 10,
      "spans": [
        {
          "text": "The fear of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the beginning of wisdom: a good understanding have all they that do ",
          "kind": "text"
        },
        {
          "text": "his commandments",
          "kind": "supplied"
        },
        {
          "text": ": his praise endureth for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
