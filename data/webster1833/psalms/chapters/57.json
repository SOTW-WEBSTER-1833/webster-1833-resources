      "edition_verse_id": "WEBSTER1833:PSA.57.6",
      "verse": 6,
      "spans": [
        {
          "text": "They have prepared a net for my steps; my soul is bowed down: they have digged a pit before me, into the midst of which they have fallen ",
          "kind": "text"
        },
        {
          "text": "themselves",
          "kind": "supplied"
        },
        {
          "text": ". Selah.",
          "kind": "text"
