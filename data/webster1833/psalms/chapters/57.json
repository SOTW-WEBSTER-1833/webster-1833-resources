          "text": "My soul ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " among lions: ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " I lie ",
          "kind": "text"
        },
        {
          "text": "even among",
          "kind": "supplied"
        },
        {
          "text": " them that are set on fire, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " the sons of men, whose teeth ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " spears and arrows, and their tongue a sharp sword.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.57.5",
      "edition_verse_id": "WEBSTER1833:PSA.57.5",
      "verse": 5,
      "spans": [
        {
          "text": "Be thou exalted, O God, above the heavens; ",
          "kind": "text"
        },
        {
          "text": "let",
          "kind": "supplied"
        },
        {
          "text": " thy glory ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " above all the earth.",
          "kind": "text"
        }
