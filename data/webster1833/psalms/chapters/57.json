      "edition_verse_id": "WEBSTER1833:PSA.57.7",
      "verse": 7,
      "spans": [
        {
          "text": "My heart is fixed, O God, my heart is fixed: I will sing and give praise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.57.8",
      "edition_verse_id": "WEBSTER1833:PSA.57.8",
      "verse": 8,
      "spans": [
        {
