{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "NUM",
  "chapter": 28,
  "verses": [
    {
      "id": "NUM.28.1",
      "edition_verse_id": "WEBSTER1833:NUM.28.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spoke to Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "NUM.28.2",
      "edition_verse_id": "WEBSTER1833:NUM.28.2",
      "verse": 2,
      "spans": [
        {
          "text": "Command the children of Israel, and say to them, My offering, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my bread for my sacrifices made by fire, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a sweet savor to me, shall ye observe to offer to me in their due season.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.3",
      "edition_verse_id": "WEBSTER1833:NUM.28.3",
      "verse": 3,
      "spans": [
        {
          "text": "And thou shalt say to them, This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the offering made by fire which ye shall offer to the LORD; two lambs of the first year without spot day by day, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a continual burnt-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.4",
      "edition_verse_id": "WEBSTER1833:NUM.28.4",
      "verse": 4,
      "spans": [
        {
          "text": "The one lamb shalt thou offer in the morning, and the other lamb shalt thou offer at evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.5",
      "edition_verse_id": "WEBSTER1833:NUM.28.5",
      "verse": 5,
      "spans": [
        {
          "text": "And a tenth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of an ephah of flour for a meat-offering, mingled with a fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of a hin of beaten oil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.6",
      "edition_verse_id": "WEBSTER1833:NUM.28.6",
      "verse": 6,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " a continual burnt-offering, which was ordained in mount Sinai for a sweet savor, a sacrifice made by fire to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.7",
      "edition_verse_id": "WEBSTER1833:NUM.28.7",
      "verse": 7,
      "spans": [
        {
          "text": "And the drink-offering of it ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " the fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of a hin for the one lamb: in the holy ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
          "text": " shalt thou cause the strong wine to be poured to the LORD ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a drink-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.8",
      "edition_verse_id": "WEBSTER1833:NUM.28.8",
      "verse": 8,
      "spans": [
        {
          "text": "And the other lamb shalt thou offer at evening; as the meat-offering of the morning, and as the drink-offering of it, thou shalt offer ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", a sacrifice made by fire, of a sweet savor to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.9",
      "edition_verse_id": "WEBSTER1833:NUM.28.9",
      "verse": 9,
      "spans": [
        {
          "text": "And on the sabbath-day two lambs of the first year without spot, and two tenth-parts of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat-offering, mingled with oil, and its drink-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.10",
      "edition_verse_id": "WEBSTER1833:NUM.28.10",
      "verse": 10,
      "spans": [
        {
          "text": "This is",
          "kind": "supplied"
        },
        {
          "text": " the burnt-offering of every sabbath, besides the continual burnt-offering, and his drink-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.11",
      "edition_verse_id": "WEBSTER1833:NUM.28.11",
      "verse": 11,
      "spans": [
        {
          "text": "And in the beginnings of your months ye shall offer a burnt-offering to the LORD; two young bullocks, and one ram, seven lambs of the first year without spot;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.12",
      "edition_verse_id": "WEBSTER1833:NUM.28.12",
      "verse": 12,
      "spans": [
        {
          "text": "And three tenth-parts of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat-offering, mingled with oil, for one bullock; and two tenth-parts of flour ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat-offering, mingled with oil, for one ram;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.13",
      "edition_verse_id": "WEBSTER1833:NUM.28.13",
      "verse": 13,
      "spans": [
        {
          "text": "And a several tenth-part of flour mingled with oil ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a meat-offering to one lamb, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a burnt-offering of a sweet savor, a sacrifice made by fire to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.14",
      "edition_verse_id": "WEBSTER1833:NUM.28.14",
      "verse": 14,
      "spans": [
        {
          "text": "And their drink-offering shall be half a hin of wine to a bullock, and the third ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of a hin to a ram, and a fourth ",
          "kind": "text"
        },
        {
          "text": "part",
          "kind": "supplied"
        },
        {
          "text": " of a hin to a lamb: this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the burnt-offering of every month throughout the months of the year.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.15",
      "edition_verse_id": "WEBSTER1833:NUM.28.15",
      "verse": 15,
      "spans": [
        {
          "text": "And one kid of the goats for a sin-offering to the LORD shall be offered, besides the continual burnt-offering, and his drink-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.16",
      "edition_verse_id": "WEBSTER1833:NUM.28.16",
      "verse": 16,
      "spans": [
        {
          "text": "And on the fourteenth day of the first month ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the passover of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.17",
      "edition_verse_id": "WEBSTER1833:NUM.28.17",
      "verse": 17,
      "spans": [
        {
          "text": "And on the fifteenth day of this month ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the feast: seven days shall unleavened bread be eaten.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.18",
      "edition_verse_id": "WEBSTER1833:NUM.28.18",
      "verse": 18,
      "spans": [
        {
          "text": "On the first day ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " a holy convocation; ",
          "kind": "text"
        },
        {
          "text": "in it",
          "kind": "supplied"
        },
        {
          "text": " ye shall do no manner of servile work.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.19",
      "edition_verse_id": "WEBSTER1833:NUM.28.19",
      "verse": 19,
      "spans": [
        {
          "text": "But ye shall offer a sacrifice made by fire ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a burnt-offering to the LORD; two young bullocks, and one ram, and seven lambs of the first year: they shall be to you without blemish:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.20",
      "edition_verse_id": "WEBSTER1833:NUM.28.20",
      "verse": 20,
      "spans": [
        {
          "text": "And their meat-offering ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " flour mingled with oil: three tenth-parts shall ye offer for a bullock, and two tenth-parts for a ram;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.21",
      "edition_verse_id": "WEBSTER1833:NUM.28.21",
      "verse": 21,
      "spans": [
        {
          "text": "A several tenth-part shalt thou offer for every lamb, throughout the seven lambs:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.22",
      "edition_verse_id": "WEBSTER1833:NUM.28.22",
      "verse": 22,
      "spans": [
        {
          "text": "And one goat ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a sin-offering, to make an atonement for you.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.23",
      "edition_verse_id": "WEBSTER1833:NUM.28.23",
      "verse": 23,
      "spans": [
        {
          "text": "Ye shall offer these besides the burnt-offering in the morning, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " for a continual burnt-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.24",
      "edition_verse_id": "WEBSTER1833:NUM.28.24",
      "verse": 24,
      "spans": [
        {
          "text": "After this manner ye shall offer daily throughout the seven days, the food of the sacrifice made by fire, of a sweet savor to the LORD: it shall be offered besides the continual burnt-offering, and his drink-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.25",
      "edition_verse_id": "WEBSTER1833:NUM.28.25",
      "verse": 25,
      "spans": [
        {
          "text": "And on the seventh day ye shall have a holy convocation; ye shall do no servile work.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.26",
      "edition_verse_id": "WEBSTER1833:NUM.28.26",
      "verse": 26,
      "spans": [
        {
          "text": "Also in the day of the first-fruits, when ye bring a new meat-offering to the LORD, after your weeks ",
          "kind": "text"
        },
        {
          "text": "are ended",
          "kind": "supplied"
        },
        {
          "text": ", ye shall have a holy convocation; ye shall do no servile work:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.27",
      "edition_verse_id": "WEBSTER1833:NUM.28.27",
      "verse": 27,
      "spans": [
        {
          "text": "But ye shall offer the burnt-offering for a sweet savor to the LORD; two young bullocks, one ram, seven lambs of the first year;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.28",
      "edition_verse_id": "WEBSTER1833:NUM.28.28",
      "verse": 28,
      "spans": [
        {
          "text": "And their meat-offering of flour mingled with oil, three tenth-parts to one bullock, two tenth-parts to one ram,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.29",
      "edition_verse_id": "WEBSTER1833:NUM.28.29",
      "verse": 29,
      "spans": [
        {
          "text": "A several tenth part to one lamb, throughout the seven lambs;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.30",
      "edition_verse_id": "WEBSTER1833:NUM.28.30",
      "verse": 30,
      "spans": [
        {
          "text": "And",
          "kind": "supplied"
        },
        {
          "text": " one kid of the goats, to make an atonement for you.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.28.31",
      "edition_verse_id": "WEBSTER1833:NUM.28.31",
      "verse": 31,
      "spans": [
        {
          "text": "Ye shall offer ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " besides the continual burnt-offering and his meat-offering (they shall be to you without blemish) and their drink-offerings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
