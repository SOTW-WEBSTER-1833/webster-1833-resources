      "spans": [
        {
          "text": "These ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the families of the Zebulunites according to those that were numbered of them, sixty thousand and five hundred.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.26.28",
      "edition_verse_id": "WEBSTER1833:NUM.26.28",
