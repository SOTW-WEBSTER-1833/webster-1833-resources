{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "NUM",
  "chapter": 19,
  "verses": [
    {
      "id": "NUM.19.1",
      "edition_verse_id": "WEBSTER1833:NUM.19.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spoke to Moses and to Aaron, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "NUM.19.2",
      "edition_verse_id": "WEBSTER1833:NUM.19.2",
      "verse": 2,
      "spans": [
        {
          "text": "This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the ordinance of the law which the LORD hath commanded, saying, Speak to the children of Israel, that they bring thee a red heifer without spot, in which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " no blemish, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " upon which never came a yoke:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.3",
      "edition_verse_id": "WEBSTER1833:NUM.19.3",
      "verse": 3,
      "spans": [
        {
          "text": "And ye shall give her to Eleazar the priest, that he may bring her forth without the camp, and ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " shall slay her before his face:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.4",
      "edition_verse_id": "WEBSTER1833:NUM.19.4",
      "verse": 4,
      "spans": [
        {
          "text": "And Eleazar the priest shall take of her blood with his finger, and sprinkle of her blood directly before the tabernacle of the congregation seven times:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.5",
      "edition_verse_id": "WEBSTER1833:NUM.19.5",
      "verse": 5,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " shall burn the heifer in his sight; her skin, and her flesh, and her blood, with her dung, shall he burn:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.6",
      "edition_verse_id": "WEBSTER1833:NUM.19.6",
      "verse": 6,
      "spans": [
        {
          "text": "And the priest shall take cedar-wood, and hyssop, and scarlet, and cast ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " into the midst of the burning of the heifer.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.7",
      "edition_verse_id": "WEBSTER1833:NUM.19.7",
      "verse": 7,
      "spans": [
        {
          "text": "Then the priest shall wash his clothes, and he shall bathe his flesh in water, and afterward he shall come into the camp, and the priest shall be unclean until the evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.8",
      "edition_verse_id": "WEBSTER1833:NUM.19.8",
      "verse": 8,
      "spans": [
        {
          "text": "And he that burneth her shall wash his clothes in water, and bathe his flesh in water, and shall be unclean until the evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.9",
      "edition_verse_id": "WEBSTER1833:NUM.19.9",
      "verse": 9,
      "spans": [
        {
          "text": "And a man ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": " clean shall gather the ashes of the heifer, and lay ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " without the camp in a clean place, and it shall be kept for the congregation of the children of Israel, for a water of separation: it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a purification for sin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.10",
      "edition_verse_id": "WEBSTER1833:NUM.19.10",
      "verse": 10,
      "spans": [
        {
          "text": "And he that gathereth the ashes of the heifer shall wash his clothes, and be unclean until the evening: and it shall be to the children of Israel, and to the stranger that sojourneth among them, for a statute for ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.11",
      "edition_verse_id": "WEBSTER1833:NUM.19.11",
      "verse": 11,
      "spans": [
        {
          "text": "He that toucheth the dead body of any man shall be unclean seven days.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.12",
      "edition_verse_id": "WEBSTER1833:NUM.19.12",
      "verse": 12,
      "spans": [
        {
          "text": "He shall purify himself with it on the third day, and on the seventh day he shall be clean: but if he shall not purify himself the third day, then the seventh day he shall not be clean.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.13",
      "edition_verse_id": "WEBSTER1833:NUM.19.13",
      "verse": 13,
      "spans": [
        {
          "text": "Whoever toucheth the dead body of any man that is dead, and purifieth not himself, defileth the tabernacle of the LORD; and that soul shall be cut off from Israel: because the water of separation was not sprinkled upon him, he shall be unclean; his uncleanness ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " yet upon him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.14",
      "edition_verse_id": "WEBSTER1833:NUM.19.14",
      "verse": 14,
      "spans": [
        {
          "text": "This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the law, when a man dieth in a tent: all that come into the tent, and all that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in the tent, shall be unclean seven days.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.15",
      "edition_verse_id": "WEBSTER1833:NUM.19.15",
      "verse": 15,
      "spans": [
        {
          "text": "And every open vessel, which hath no covering bound upon it, ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " unclean.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.16",
      "edition_verse_id": "WEBSTER1833:NUM.19.16",
      "verse": 16,
      "spans": [
        {
          "text": "And whoever toucheth one that is slain with a sword in the open fields, or a dead body, or a bone of a man, or a grave, shall be unclean seven days.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.17",
      "edition_verse_id": "WEBSTER1833:NUM.19.17",
      "verse": 17,
      "spans": [
        {
          "text": "And for an unclean ",
          "kind": "text"
        },
        {
          "text": "person",
          "kind": "supplied"
        },
        {
          "text": " they shall take of the ashes of the burnt heifer of purification for sin, and running water shall be put to it in a vessel:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.18",
      "edition_verse_id": "WEBSTER1833:NUM.19.18",
      "verse": 18,
      "spans": [
        {
          "text": "And a clean person shall take hyssop, and dip ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " in the water, and sprinkle ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " upon the tent, and upon all the vessels, and upon the persons that were there, and upon him that touched a bone, or one slain, or one dead, or a grave:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.19",
      "edition_verse_id": "WEBSTER1833:NUM.19.19",
      "verse": 19,
      "spans": [
        {
          "text": "And the clean ",
          "kind": "text"
        },
        {
          "text": "person",
          "kind": "supplied"
        },
        {
          "text": " shall sprinkle upon the unclean on the third day, and on the seventh day: and on the seventh day he shall purify himself, and wash his clothes, and bathe himself in water, and shall be clean at evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.20",
      "edition_verse_id": "WEBSTER1833:NUM.19.20",
      "verse": 20,
      "spans": [
        {
          "text": "But the man that shall be unclean, and shall not purify himself, that soul shall be cut off from among the congregation, because he hath defiled the sanctuary of the LORD: the water of separation hath not been sprinkled upon him: he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " unclean.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.21",
      "edition_verse_id": "WEBSTER1833:NUM.19.21",
      "verse": 21,
      "spans": [
        {
          "text": "And it shall be a perpetual statute to them, that he that sprinkleth the water of separation shall wash his clothes; and he that toucheth the water of separation shall be unclean until the evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "NUM.19.22",
      "edition_verse_id": "WEBSTER1833:NUM.19.22",
      "verse": 22,
      "spans": [
        {
          "text": "And whatever the unclean ",
          "kind": "text"
        },
        {
          "text": "person",
          "kind": "supplied"
        },
        {
          "text": " toucheth shall be unclean; and the soul that toucheth ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " shall be unclean until the evening.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
