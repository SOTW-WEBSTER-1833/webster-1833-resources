      "edition_verse_id": "WEBSTER1833:NUM.1.51",
      "verse": 51,
      "spans": [
        {
          "text": "And when the tabernacle moveth forward, the Levites shall take it down; and when the tabernacle is to be pitched, the Levites shall set it up: and the stranger that cometh nigh shall be put to death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
