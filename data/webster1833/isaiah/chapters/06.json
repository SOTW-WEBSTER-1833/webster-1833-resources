          "text": "And the LORD shall have removed men far away, and ",
          "kind": "text"
        },
        {
          "text": "there be",
          "kind": "supplied"
        },
        {
          "text": " a great forsaking in the midst of the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ISA.6.13",
      "edition_verse_id": "WEBSTER1833:ISA.6.13",
      "verse": 13,
      "spans": [
        {
