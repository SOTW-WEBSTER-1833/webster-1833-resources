    },
    {
      "id": "ISA.25.5",
      "edition_verse_id": "WEBSTER1833:ISA.25.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thou wilt bring down the noise of strangers, as the heat in a dry place; ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " the heat with the shade of a cloud: the branch of the terrible ones shall be brought low.",
