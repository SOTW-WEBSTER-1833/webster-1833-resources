      "edition_verse_id": "WEBSTER1833:ISA.46.12",
      "verse": 12,
      "spans": [
        {
          "text": "Hearken to me, ye stout-hearted, that ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " far from righteousness:",
          "kind": "text"
