        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " to hoary hairs will I carry ",
          "kind": "text"
        },
        {
          "text": "you",
          "kind": "supplied"
        },
        {
          "text": ": I have made, and I will bear; even I will carry, and will deliver ",
          "kind": "text"
        },
