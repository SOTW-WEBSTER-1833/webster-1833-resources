      "edition_verse_id": "WEBSTER1833:ISA.46.5",
      "verse": 5,
      "spans": [
        {
          "text": "To whom will ye liken me, and make ",
          "kind": "text"
        },
        {
          "text": "me",
          "kind": "supplied"
        },
