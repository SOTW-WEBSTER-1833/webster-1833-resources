      "edition_verse_id": "WEBSTER1833:ISA.46.11",
      "verse": 11,
      "spans": [
        {
          "text": "Calling a ravenous bird from the east, the man that executeth my counsel from a far country: yes, I have spoken ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
