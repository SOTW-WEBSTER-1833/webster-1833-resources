      "edition_verse_id": "WEBSTER1833:2CH.3.17",
      "verse": 17,
      "spans": [
        {
          "text": "And he erected the pillars before the temple, one on the right hand, and the other on the left; and called the name of that on the right hand Jachin, and the name of that on the left Boaz.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
