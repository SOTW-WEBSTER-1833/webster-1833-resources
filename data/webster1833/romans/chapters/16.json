{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "ROM",
  "chapter": 16,
  "verses": [
    {
      "id": "ROM.16.1",
      "edition_verse_id": "WEBSTER1833:ROM.16.1",
      "verse": 1,
      "spans": [
        {
          "text": "I commend to you Phebe our sister, who is a servant of the church which is at Cenchrea:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "ROM.16.2",
      "edition_verse_id": "WEBSTER1833:ROM.16.2",
      "verse": 2,
      "spans": [
        {
          "text": "That ye receive her in the Lord, as it becometh saints, and that ye assist her in whatever business she hath need of you: for she hath been a succorer of many, and of myself also.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.3",
      "edition_verse_id": "WEBSTER1833:ROM.16.3",
      "verse": 3,
      "spans": [
        {
          "text": "Greet Priscilla and Aquila my helpers in Christ Jesus:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.4",
      "edition_verse_id": "WEBSTER1833:ROM.16.4",
      "verse": 4,
      "spans": [
        {
          "text": "Who have for my life laid down their own necks: to whom not only I give thanks, but also all the churches of the Gentiles.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.5",
      "edition_verse_id": "WEBSTER1833:ROM.16.5",
      "verse": 5,
      "spans": [
        {
          "text": "Likewise ",
          "kind": "text"
        },
        {
          "text": "greet",
          "kind": "supplied"
        },
        {
          "text": " the church that is in their house. Salute my well-beloved Epenetus, who is the first-fruits of Achaia to Christ.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.6",
      "edition_verse_id": "WEBSTER1833:ROM.16.6",
      "verse": 6,
      "spans": [
        {
          "text": "Greet Mary, who bestowed much labor on us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.7",
      "edition_verse_id": "WEBSTER1833:ROM.16.7",
      "verse": 7,
      "spans": [
        {
          "text": "Salute Andronicus and Junia my kinsmen, and my fellow-prisoners, who are of note among the apostles, who also were in Christ before me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.8",
      "edition_verse_id": "WEBSTER1833:ROM.16.8",
      "verse": 8,
      "spans": [
        {
          "text": "Greet Amplias my beloved in the Lord.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.9",
      "edition_verse_id": "WEBSTER1833:ROM.16.9",
      "verse": 9,
      "spans": [
        {
          "text": "Salute Urbane, our helper in Christ, and Stachys my beloved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.10",
      "edition_verse_id": "WEBSTER1833:ROM.16.10",
      "verse": 10,
      "spans": [
        {
          "text": "Salute Apelles approved in Christ. Salute them who are of Aristobulus' ",
          "kind": "text"
        },
        {
          "text": "household",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.11",
      "edition_verse_id": "WEBSTER1833:ROM.16.11",
      "verse": 11,
      "spans": [
        {
          "text": "Salute Herodion my kinsman. Greet them that are of the ",
          "kind": "text"
        },
        {
          "text": "household",
          "kind": "supplied"
        },
        {
          "text": " of Narcissus, who are in the Lord.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.12",
      "edition_verse_id": "WEBSTER1833:ROM.16.12",
      "verse": 12,
      "spans": [
        {
          "text": "Salute Tryphena and Tryphosa, who labor in the Lord. Salute the beloved Persis, who labored much in the Lord.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.13",
      "edition_verse_id": "WEBSTER1833:ROM.16.13",
      "verse": 13,
      "spans": [
        {
          "text": "Salute Rufus chosen in the Lord, and his mother and mine.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.14",
      "edition_verse_id": "WEBSTER1833:ROM.16.14",
      "verse": 14,
      "spans": [
        {
          "text": "Salute Asyncritus, Phlegon, Hermas, Patrobas, Hermes, and the brethren who are with them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.15",
      "edition_verse_id": "WEBSTER1833:ROM.16.15",
      "verse": 15,
      "spans": [
        {
          "text": "Salute Philologus, and Julia, Nereus, and his sister, and Olympas, and all the saints who are with them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.16",
      "edition_verse_id": "WEBSTER1833:ROM.16.16",
      "verse": 16,
      "spans": [
        {
          "text": "Salute one another with a holy kiss. The churches of Christ salute you.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.17",
      "edition_verse_id": "WEBSTER1833:ROM.16.17",
      "verse": 17,
      "spans": [
        {
          "text": "Now I beseech you, brethren, mark them who cause divisions and offenses, contrary to the doctrine which ye have learned; and avoid them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.18",
      "edition_verse_id": "WEBSTER1833:ROM.16.18",
      "verse": 18,
      "spans": [
        {
          "text": "For they that are such serve not our Lord Jesus Christ, but their own belly; and by good words and fair speeches deceive the hearts of the simple.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.19",
      "edition_verse_id": "WEBSTER1833:ROM.16.19",
      "verse": 19,
      "spans": [
        {
          "text": "For your obedience is come abroad to all ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": ". I am glad therefore on your behalf: but yet I would have you wise to that which is good, and simple concerning evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.20",
      "edition_verse_id": "WEBSTER1833:ROM.16.20",
      "verse": 20,
      "spans": [
        {
          "text": "And the God of peace will soon bruise Satan under your feet. The grace of our Lord Jesus Christ ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " with you. Amen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.21",
      "edition_verse_id": "WEBSTER1833:ROM.16.21",
      "verse": 21,
      "spans": [
        {
          "text": "Timothy my work-fellow, and Lucius, and Jason, and Sosipater my kinsmen, salute you.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.22",
      "edition_verse_id": "WEBSTER1833:ROM.16.22",
      "verse": 22,
      "spans": [
        {
          "text": "I Tertius, who wrote ",
          "kind": "text"
        },
        {
          "text": "this",
          "kind": "supplied"
        },
        {
          "text": " epistle, salute you in the Lord.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.23",
      "edition_verse_id": "WEBSTER1833:ROM.16.23",
      "verse": 23,
      "spans": [
        {
          "text": "Gaius my host, and of the whole church, saluteth you. Erastus the chamberlain of the city saluteth you, and Quartus a brother.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.24",
      "edition_verse_id": "WEBSTER1833:ROM.16.24",
      "verse": 24,
      "spans": [
        {
          "text": "The grace of our Lord Jesus Christ ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " with you all. Amen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.25",
      "edition_verse_id": "WEBSTER1833:ROM.16.25",
      "verse": 25,
      "spans": [
        {
          "text": "Now to him that is able to establish you according to my gospel, and the preaching of Jesus Christ, according to the revelation of the mystery, which hath been kept secret since the world began,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.26",
      "edition_verse_id": "WEBSTER1833:ROM.16.26",
      "verse": 26,
      "spans": [
        {
          "text": "But now is made manifest, and by the scriptures of the prophets, according to the commandment of the everlasting God, made known to all nations for the obedience of faith:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ROM.16.27",
      "edition_verse_id": "WEBSTER1833:ROM.16.27",
      "verse": 27,
      "spans": [
        {
          "text": "To God the only wise, ",
          "kind": "text"
        },
        {
          "text": "be",
          "kind": "supplied"
        },
        {
          "text": " glory through Jesus Christ for ever. Amen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
