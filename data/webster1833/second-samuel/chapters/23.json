{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "2SA",
  "chapter": 23,
  "verses": [
    {
      "id": "2SA.23.1",
      "edition_verse_id": "WEBSTER1833:2SA.23.1",
      "verse": 1,
      "spans": [
        {
          "text": "Now these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the last words of David. David the son of Jesse said, and the man ",
          "kind": "text"
        },
        {
          "text": "who was",
          "kind": "supplied"
        },
        {
          "text": " raised on high, the anointed of the God of Jacob, and the sweet psalmist of Israel, said,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "2SA.23.2",
      "edition_verse_id": "WEBSTER1833:2SA.23.2",
      "verse": 2,
      "spans": [
        {
          "text": "The Spirit of the LORD spoke by me, and his word ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " on my tongue.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.3",
      "edition_verse_id": "WEBSTER1833:2SA.23.3",
      "verse": 3,
      "spans": [
        {
          "text": "The God of Israel said, the Rock of Israel spoke to me, He that ruleth over men ",
          "kind": "text"
        },
        {
          "text": "must be",
          "kind": "supplied"
        },
        {
          "text": " just, ruling in the fear of God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.4",
      "edition_verse_id": "WEBSTER1833:2SA.23.4",
      "verse": 4,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "he shall be",
          "kind": "supplied"
        },
        {
          "text": " as the light of the morning, ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " the sun riseth, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " a morning without clouds; ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " the tender grass ",
          "kind": "text"
        },
        {
          "text": "springing",
          "kind": "supplied"
        },
        {
          "text": " out of the earth by clear shining after rain.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.5",
      "edition_verse_id": "WEBSTER1833:2SA.23.5",
      "verse": 5,
      "spans": [
        {
          "text": "Although my house ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " not so with God; yet he hath made with me an everlasting covenant, ordered in all ",
          "kind": "text"
        },
        {
          "text": "things",
          "kind": "supplied"
        },
        {
          "text": ", and sure: for ",
          "kind": "text"
        },
        {
          "text": "this is",
          "kind": "supplied"
        },
        {
          "text": " all my salvation, and all ",
          "kind": "text"
        },
        {
          "text": "my",
          "kind": "supplied"
        },
        {
          "text": " desire, although he maketh ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " not to grow.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.6",
      "edition_verse_id": "WEBSTER1833:2SA.23.6",
      "verse": 6,
      "spans": [
        {
          "text": "But ",
          "kind": "text"
        },
        {
          "text": "the sons",
          "kind": "supplied"
        },
        {
          "text": " of Belial ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " all of them as thorns thrust away, because they cannot be taken with hands:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.7",
      "edition_verse_id": "WEBSTER1833:2SA.23.7",
      "verse": 7,
      "spans": [
        {
          "text": "But the man ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " shall touch them must be fenced with iron and the staff of a spear; and they shall be utterly burned with fire in the ",
          "kind": "text"
        },
        {
          "text": "same",
          "kind": "supplied"
        },
        {
          "text": " place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.8",
      "edition_verse_id": "WEBSTER1833:2SA.23.8",
      "verse": 8,
      "spans": [
        {
          "text": "These ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the names of the mighty men whom David had: The Tachmonite that sat in the seat, chief among the captains; the same ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " Adino the Eznite: ",
          "kind": "text"
        },
        {
          "text": "he lifted up his spear",
          "kind": "supplied"
        },
        {
          "text": " against eight hundred, whom he slew at one time.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.9",
      "edition_verse_id": "WEBSTER1833:2SA.23.9",
      "verse": 9,
      "spans": [
        {
          "text": "And after him ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " Eleazar the son of Dodo the Ahohite, ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " of the three mighty men with David, when they defied the Philistines ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " were there assembled to battle, and the men of Israel had gone away:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.10",
      "edition_verse_id": "WEBSTER1833:2SA.23.10",
      "verse": 10,
      "spans": [
        {
          "text": "He arose, and smote the Philistines until his hand was weary, and his hand adhered to the sword: and the LORD wrought a great victory that day; and the people returned after him only to plunder.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.11",
      "edition_verse_id": "WEBSTER1833:2SA.23.11",
      "verse": 11,
      "spans": [
        {
          "text": "And after him ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " Shammah the son of Agee the Hararite. And the Philistines were collected into a troop, where was a piece of ground full of lentils: and the people fled from the Philistines.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.12",
      "edition_verse_id": "WEBSTER1833:2SA.23.12",
      "verse": 12,
      "spans": [
        {
          "text": "But he stood in the midst of the ground, and defended it, and slew the Philistines: and the LORD wrought a great victory.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.13",
      "edition_verse_id": "WEBSTER1833:2SA.23.13",
      "verse": 13,
      "spans": [
        {
          "text": "And three of the thirty chiefs went down, and came to David in the harvest time to the cave of Adullam: and the troop of the Philistines encamped in the valley of Rephaim.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.14",
      "edition_verse_id": "WEBSTER1833:2SA.23.14",
      "verse": 14,
      "spans": [
        {
          "text": "And David ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " then in a hold, and the garrison of the Philistines ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " then ",
          "kind": "text"
        },
        {
          "text": "in",
          "kind": "supplied"
        },
        {
          "text": " Beth-lehem.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.15",
      "edition_verse_id": "WEBSTER1833:2SA.23.15",
      "verse": 15,
      "spans": [
        {
          "text": "And David longed, and said, Oh that one would give me drink of the water of the well of Beth-lehem, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " by the gate!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.16",
      "edition_verse_id": "WEBSTER1833:2SA.23.16",
      "verse": 16,
      "spans": [
        {
          "text": "And the three mighty men broke through the host of the Philistines, and drew water out of the well of Beth-lehem, that ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " by the gate, and took ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ", and brought ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " to David: nevertheless he would not drink of it, but poured it out to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.17",
      "edition_verse_id": "WEBSTER1833:2SA.23.17",
      "verse": 17,
      "spans": [
        {
          "text": "And he said, Be it far from me, O LORD, that I should do this: ",
          "kind": "text"
        },
        {
          "text": "is not this",
          "kind": "supplied"
        },
        {
          "text": " the blood of the men that went in jeopardy of their lives? therefore he would not drink it. These things did these three mighty men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.18",
      "edition_verse_id": "WEBSTER1833:2SA.23.18",
      "verse": 18,
      "spans": [
        {
          "text": "And Abishai, the brother of Joab, the son of Zeruiah, was chief among three. And he lifted up his spear against three hundred, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " slew ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": ", and had the name among three.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.19",
      "edition_verse_id": "WEBSTER1833:2SA.23.19",
      "verse": 19,
      "spans": [
        {
          "text": "Was he not most honorable of three? therefore he was their captain: yet he attained not to the ",
          "kind": "text"
        },
        {
          "text": "first",
          "kind": "supplied"
        },
        {
          "text": " three.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.20",
      "edition_verse_id": "WEBSTER1833:2SA.23.20",
      "verse": 20,
      "spans": [
        {
          "text": "And Benaiah the son of Jehoiada, the son of a valiant man, of Kabzeel, who had done many acts, he slew two lion-like men of Moab: he went down also and slew a lion in the midst of a pit in time of snow:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.21",
      "edition_verse_id": "WEBSTER1833:2SA.23.21",
      "verse": 21,
      "spans": [
        {
          "text": "And he slew an Egyptian, a goodly man: and the Egyptian had a spear in his hand; but he went down to him with a staff, and plucked the spear out of the Egyptian's hand, and slew him with his own spear.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.22",
      "edition_verse_id": "WEBSTER1833:2SA.23.22",
      "verse": 22,
      "spans": [
        {
          "text": "These ",
          "kind": "text"
        },
        {
          "text": "things",
          "kind": "supplied"
        },
        {
          "text": " did Benaiah the son of Jehoiada, and had a name among three mighty men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.23",
      "edition_verse_id": "WEBSTER1833:2SA.23.23",
      "verse": 23,
      "spans": [
        {
          "text": "He was more honorable than the thirty, but he attained not to the ",
          "kind": "text"
        },
        {
          "text": "first",
          "kind": "supplied"
        },
        {
          "text": " three. And David set him over his guard.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.24",
      "edition_verse_id": "WEBSTER1833:2SA.23.24",
      "verse": 24,
      "spans": [
        {
          "text": "Asahel the brother of Joab ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " one of the thirty; Elhanan the son of Dodo of Beth-lehem,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.25",
      "edition_verse_id": "WEBSTER1833:2SA.23.25",
      "verse": 25,
      "spans": [
        {
          "text": "Shammah the Harodite, Elika the Harodite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.26",
      "edition_verse_id": "WEBSTER1833:2SA.23.26",
      "verse": 26,
      "spans": [
        {
          "text": "Helez the Paltite, Ira the son of Ikkesh the Tekoite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.27",
      "edition_verse_id": "WEBSTER1833:2SA.23.27",
      "verse": 27,
      "spans": [
        {
          "text": "Abiezer the Anethothite, Mebunnai the Hushathite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.28",
      "edition_verse_id": "WEBSTER1833:2SA.23.28",
      "verse": 28,
      "spans": [
        {
          "text": "Zalmon the Ahohite, Maharai the Netophathite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.29",
      "edition_verse_id": "WEBSTER1833:2SA.23.29",
      "verse": 29,
      "spans": [
        {
          "text": "Heleb the son of Baanah, a Netophathite, Ittai the son of Ribai out of Gibeah of the children of Benjamin,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.30",
      "edition_verse_id": "WEBSTER1833:2SA.23.30",
      "verse": 30,
      "spans": [
        {
          "text": "Benaiah the Pirathonite, Hiddai of the brooks of Gaash,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.31",
      "edition_verse_id": "WEBSTER1833:2SA.23.31",
      "verse": 31,
      "spans": [
        {
          "text": "Abi-albon the Arbathite, Azmaveth the Barhumite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.32",
      "edition_verse_id": "WEBSTER1833:2SA.23.32",
      "verse": 32,
      "spans": [
        {
          "text": "Eliahba the Shaalbonite, of the sons of Jashen, Jonathan,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.33",
      "edition_verse_id": "WEBSTER1833:2SA.23.33",
      "verse": 33,
      "spans": [
        {
          "text": "Shammah the Hararite, Ahiam the son of Sharar the Hararite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.34",
      "edition_verse_id": "WEBSTER1833:2SA.23.34",
      "verse": 34,
      "spans": [
        {
          "text": "Eliphelet the son of Ahasbai, the son of the Maachathite, Eliam the son of Ahithophel the Gilonite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.35",
      "edition_verse_id": "WEBSTER1833:2SA.23.35",
      "verse": 35,
      "spans": [
        {
          "text": "Hezrai the Carmelite, Paarai the Arbite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.36",
      "edition_verse_id": "WEBSTER1833:2SA.23.36",
      "verse": 36,
      "spans": [
        {
          "text": "Igal the son of Nathan of Zobah, Bani, the Gadite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.37",
      "edition_verse_id": "WEBSTER1833:2SA.23.37",
      "verse": 37,
      "spans": [
        {
          "text": "Zelek the Ammonite, Naharai the Beerothite, armor-bearer to Joab the son of Zeruiah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.38",
      "edition_verse_id": "WEBSTER1833:2SA.23.38",
      "verse": 38,
      "spans": [
        {
          "text": "Ira an Ithrite, Gareb an Ithrite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "2SA.23.39",
      "edition_verse_id": "WEBSTER1833:2SA.23.39",
      "verse": 39,
      "spans": [
        {
          "text": "Uriah the Hittite: thirty and seven in all.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
