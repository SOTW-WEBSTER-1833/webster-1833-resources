      "verse": 1,
      "spans": [
        {
          "text": "Now these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the children of the province that went up from the captivity, of those who had been carried away, whom Nebuchadnezzar the king of Babylon had carried away to Babylon, and came again to Jerusalem and Judah, every one to his city;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EZR.2.2",
      "edition_verse_id": "WEBSTER1833:EZR.2.2",
      "verse": 2,
      "spans": [
        {
          "text": "Who came with Zerubbabel: Jeshua, Nehemiah, Seraiah, Reelaiah, Mordecai, Bilshan, Mizpar, Bigvai, Rehum, Baanah. The number of the men of the people of Israel:",
          "kind": "text"
        }
