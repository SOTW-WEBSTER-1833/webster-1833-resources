      "edition_verse_id": "WEBSTER1833:EZR.1.9",
      "verse": 9,
      "spans": [
        {
          "text": "And this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the number of them: thirty chargers of gold, a thousand chargers of silver, nine and twenty knives,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
