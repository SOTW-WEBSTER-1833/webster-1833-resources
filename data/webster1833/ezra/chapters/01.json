      "edition_verse_id": "WEBSTER1833:EZR.1.8",
      "verse": 8,
      "spans": [
        {
          "text": "Even those did Cyrus king of Persia bring forth by the hand of Mithredath the treasurer, and numbered them to Sheshbazzar, the prince of Judah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
