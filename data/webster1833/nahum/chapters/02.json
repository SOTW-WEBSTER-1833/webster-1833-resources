      "edition_verse_id": "WEBSTER1833:NAM.2.2",
      "verse": 2,
      "spans": [
        {
          "text": "For the LORD hath turned away the excellence of Jacob, as the excellence of Israel: for the emptiers have emptied them out, and marred their vine branches.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
