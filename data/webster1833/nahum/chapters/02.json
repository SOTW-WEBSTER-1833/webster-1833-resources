      "edition_verse_id": "WEBSTER1833:NAM.2.4",
      "verse": 4,
      "spans": [
        {
          "text": "The chariots shall rage in the streets, they shall jostle one against another in the broad ways: they shall seem like torches, they shall run like the lightnings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
