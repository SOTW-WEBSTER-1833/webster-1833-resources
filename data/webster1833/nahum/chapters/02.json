      "edition_verse_id": "WEBSTER1833:NAM.2.3",
      "verse": 3,
      "spans": [
        {
          "text": "The shield of his mighty men is made red, the valiant men ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " in scarlet: the chariots ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
