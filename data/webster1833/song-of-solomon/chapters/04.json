      "id": "SNG.4.15",
      "edition_verse_id": "WEBSTER1833:SNG.4.15",
      "verse": 15,
      "spans": [
        {
          "text": "A fountain of gardens, a well of living waters, and streams from Lebanon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.4.16",
      "edition_verse_id": "WEBSTER1833:SNG.4.16",
      "verse": 16,
      "spans": [
        {
          "text": "Awake, O north wind; and come, thou south; blow upon my garden, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " its spices may flow out. Let my beloved come into his garden, and eat his pleasant fruits.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
