      "edition_verse_id": "WEBSTER1833:SNG.4.1",
      "verse": 1,
      "spans": [
        {
          "text": "Behold, thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " fair, my love; behold, thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " fair; thou ",
          "kind": "text"
        },
        {
          "text": "hast",
          "kind": "supplied"
        },
        {
          "text": " doves' eyes within thy locks: thy hair ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
