{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "SNG",
  "chapter": 5,
  "verses": [
    {
      "id": "SNG.5.1",
      "edition_verse_id": "WEBSTER1833:SNG.5.1",
      "verse": 1,
      "spans": [
        {
          "text": "I have come into my garden, my sister, ",
          "kind": "text"
        },
        {
          "text": "my",
          "kind": "supplied"
        },
        {
          "text": " spouse: I have gathered my myrrh, with my spice; I have eaten my honey-comb with my honey; I have drank my wine with my milk: eat, O friends; drink, yes, drink abundantly, O beloved.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "SNG.5.2",
      "edition_verse_id": "WEBSTER1833:SNG.5.2",
      "verse": 2,
      "spans": [
        {
          "text": "I sleep, but my heart waketh: ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " the voice of my beloved that knocketh, ",
          "kind": "text"
        },
        {
          "text": "saying",
          "kind": "supplied"
        },
        {
          "text": ", Open to me, my sister, my love, my dove, my undefiled: for my head is filled with dew, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " my locks with the drops of the night.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.3",
      "edition_verse_id": "WEBSTER1833:SNG.5.3",
      "verse": 3,
      "spans": [
        {
          "text": "I have put off my coat; how shall I put it on? I have washed my feet; how shall I defile them?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.4",
      "edition_verse_id": "WEBSTER1833:SNG.5.4",
      "verse": 4,
      "spans": [
        {
          "text": "My beloved put in his hand by the hole ",
          "kind": "text"
        },
        {
          "text": "of the door",
          "kind": "supplied"
        },
        {
          "text": ", and my bowels were moved for him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.5",
      "edition_verse_id": "WEBSTER1833:SNG.5.5",
      "verse": 5,
      "spans": [
        {
          "text": "I rose up to open to my beloved: and my hands dropped ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " myrrh, and my fingers ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " sweet-smelling myrrh, upon the handles of the lock.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.6",
      "edition_verse_id": "WEBSTER1833:SNG.5.6",
      "verse": 6,
      "spans": [
        {
          "text": "I opened to my beloved; but my beloved had withdrawn himself, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " was gone: my soul failed when he spoke: I sought him, but I could not find him; I called him, but he gave me no answer.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.7",
      "edition_verse_id": "WEBSTER1833:SNG.5.7",
      "verse": 7,
      "spans": [
        {
          "text": "The watchmen that went about the city found me, they smote me, they wounded me; the keepers of the walls took away my vail from me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.8",
      "edition_verse_id": "WEBSTER1833:SNG.5.8",
      "verse": 8,
      "spans": [
        {
          "text": "I charge you, O daughters of Jerusalem, if ye find my beloved, that ye tell him, that I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " sick with love.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.9",
      "edition_verse_id": "WEBSTER1833:SNG.5.9",
      "verse": 9,
      "spans": [
        {
          "text": "What ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " thy beloved more than ",
          "kind": "text"
        },
        {
          "text": "another",
          "kind": "supplied"
        },
        {
          "text": " beloved, O thou fairest among women? what ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " thy beloved more than ",
          "kind": "text"
        },
        {
          "text": "another",
          "kind": "supplied"
        },
        {
          "text": " beloved, that thou dost so charge us?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.10",
      "edition_verse_id": "WEBSTER1833:SNG.5.10",
      "verse": 10,
      "spans": [
        {
          "text": "My beloved ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " white and ruddy, the chief among ten thousand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.11",
      "edition_verse_id": "WEBSTER1833:SNG.5.11",
      "verse": 11,
      "spans": [
        {
          "text": "His head ",
          "kind": "text"
        },
        {
          "text": "is as",
          "kind": "supplied"
        },
        {
          "text": " the most fine gold, his locks ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " bushy, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " black as a raven.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.12",
      "edition_verse_id": "WEBSTER1833:SNG.5.12",
      "verse": 12,
      "spans": [
        {
          "text": "His eyes ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " as ",
          "kind": "text"
        },
        {
          "text": "the eyes",
          "kind": "supplied"
        },
        {
          "text": " of doves by the rivers of waters, washed with milk, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " fitly set.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.13",
      "edition_verse_id": "WEBSTER1833:SNG.5.13",
      "verse": 13,
      "spans": [
        {
          "text": "His cheeks ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " as a bed of spices, ",
          "kind": "text"
        },
        {
          "text": "as",
          "kind": "supplied"
        },
        {
          "text": " sweet flowers: his lips ",
          "kind": "text"
        },
        {
          "text": "like",
          "kind": "supplied"
        },
        {
          "text": " lilies, dropping sweet-smelling myrrh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.14",
      "edition_verse_id": "WEBSTER1833:SNG.5.14",
      "verse": 14,
      "spans": [
        {
          "text": "His hands ",
          "kind": "text"
        },
        {
          "text": "are as",
          "kind": "supplied"
        },
        {
          "text": " gold rings set with the beryl: his belly ",
          "kind": "text"
        },
        {
          "text": "is as",
          "kind": "supplied"
        },
        {
          "text": " bright ivory overlaid ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " sapphires.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.15",
      "edition_verse_id": "WEBSTER1833:SNG.5.15",
      "verse": 15,
      "spans": [
        {
          "text": "His legs ",
          "kind": "text"
        },
        {
          "text": "are as",
          "kind": "supplied"
        },
        {
          "text": " pillars of marble, set upon sockets of fine gold: his countenance ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " as Lebanon, excellent as the cedars.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "SNG.5.16",
      "edition_verse_id": "WEBSTER1833:SNG.5.16",
      "verse": 16,
      "spans": [
        {
          "text": "His mouth ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " most sweet: yes, he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " altogether lovely. This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my beloved, and this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my friend, O daughters of Jerusalem.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
