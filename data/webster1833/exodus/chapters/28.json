      "verse": 41,
      "spans": [
        {
          "text": "And thou shalt put them upon Aaron thy brother, and on his sons with him: and shalt anoint them, and consecrate them, and sanctify them, that they may minister to me in the priest's office.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
