{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EXO",
  "chapter": 37,
  "verses": [
    {
      "id": "EXO.37.1",
      "edition_verse_id": "WEBSTER1833:EXO.37.1",
      "verse": 1,
      "spans": [
        {
          "text": "And Bezaleel made the ark ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood: two cubits and a half ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the length of it, and a cubit and a half the breadth of it, and a cubit and a half the hight of it:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EXO.37.2",
      "edition_verse_id": "WEBSTER1833:EXO.37.2",
      "verse": 2,
      "spans": [
        {
          "text": "And he overlaid it with pure gold within and without, and made a crown of gold to it round about.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.3",
      "edition_verse_id": "WEBSTER1833:EXO.37.3",
      "verse": 3,
      "spans": [
        {
          "text": "And he cast for it four rings of gold, ",
          "kind": "text"
        },
        {
          "text": "to be set",
          "kind": "supplied"
        },
        {
          "text": " by the four corners of it; even two rings upon the one side of it, and two rings upon the other side of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.4",
      "edition_verse_id": "WEBSTER1833:EXO.37.4",
      "verse": 4,
      "spans": [
        {
          "text": "And he made staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlaid them with gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.5",
      "edition_verse_id": "WEBSTER1833:EXO.37.5",
      "verse": 5,
      "spans": [
        {
          "text": "And he put the staffs into the rings by the sides of the ark, to bear the ark.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.6",
      "edition_verse_id": "WEBSTER1833:EXO.37.6",
      "verse": 6,
      "spans": [
        {
          "text": "And he made the mercy-seat ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold: two cubits and a half ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the length of it, and one cubit and a half the breadth of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.7",
      "edition_verse_id": "WEBSTER1833:EXO.37.7",
      "verse": 7,
      "spans": [
        {
          "text": "And he made two cherubim ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " gold, beaten out of one piece he made them, on the two ends of the mercy-seat;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.8",
      "edition_verse_id": "WEBSTER1833:EXO.37.8",
      "verse": 8,
      "spans": [
        {
          "text": "One cherub on the end on this side, and another cherub on the ",
          "kind": "text"
        },
        {
          "text": "other",
          "kind": "supplied"
        },
        {
          "text": " end on that side: out of the mercy-seat made he the cherubim on the two ends of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.9",
      "edition_verse_id": "WEBSTER1833:EXO.37.9",
      "verse": 9,
      "spans": [
        {
          "text": "And the cherubim spread out ",
          "kind": "text"
        },
        {
          "text": "their",
          "kind": "supplied"
        },
        {
          "text": " wings on high, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " covered with their wings over the mercy-seat, with their faces one to another; ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " towards the mercy-seat were the faces of the cherubim.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.10",
      "edition_verse_id": "WEBSTER1833:EXO.37.10",
      "verse": 10,
      "spans": [
        {
          "text": "And he made the table ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood: two cubits ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " its length, and a cubit its breadth, and a cubit and a half its hight:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.11",
      "edition_verse_id": "WEBSTER1833:EXO.37.11",
      "verse": 11,
      "spans": [
        {
          "text": "And he overlaid it with pure gold, and made to it a crown of gold round about.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.12",
      "edition_verse_id": "WEBSTER1833:EXO.37.12",
      "verse": 12,
      "spans": [
        {
          "text": "Also he made to it a border of a hand-breadth round about; and made a crown of gold for its border round about.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.13",
      "edition_verse_id": "WEBSTER1833:EXO.37.13",
      "verse": 13,
      "spans": [
        {
          "text": "And he cast for it four rings of gold, and put the rings upon the four corners that ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " in its four feet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.14",
      "edition_verse_id": "WEBSTER1833:EXO.37.14",
      "verse": 14,
      "spans": [
        {
          "text": "Over against the border were the rings, the places for the staffs, to bear the table.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.15",
      "edition_verse_id": "WEBSTER1833:EXO.37.15",
      "verse": 15,
      "spans": [
        {
          "text": "And he made the staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlaid them with gold, to bear the table.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.16",
      "edition_verse_id": "WEBSTER1833:EXO.37.16",
      "verse": 16,
      "spans": [
        {
          "text": "And he made the vessels which ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " upon the table, its dishes, and its spoons, and its bowls, and its covers to cover with, ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.17",
      "edition_verse_id": "WEBSTER1833:EXO.37.17",
      "verse": 17,
      "spans": [
        {
          "text": "And he made the candlestick of pure gold; ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " beaten work he made the candlestick; its shaft, and its branch, its bowls, its knobs, and its flowers were of the same:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.18",
      "edition_verse_id": "WEBSTER1833:EXO.37.18",
      "verse": 18,
      "spans": [
        {
          "text": "And six branches proceeding from its sides; three branches of the candlestick from the one side of it, and three branches of the candlestick from the other side of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.19",
      "edition_verse_id": "WEBSTER1833:EXO.37.19",
      "verse": 19,
      "spans": [
        {
          "text": "Three bowls made after the fashion of almonds in one branch, a knob and a flower; and three bowls made like almonds in another branch, a knob and a flower: so throughout the six branches proceeding from the candlestick.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.20",
      "edition_verse_id": "WEBSTER1833:EXO.37.20",
      "verse": 20,
      "spans": [
        {
          "text": "And in the candlestick ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " four bowls made like almonds, its knobs, and its flowers:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.21",
      "edition_verse_id": "WEBSTER1833:EXO.37.21",
      "verse": 21,
      "spans": [
        {
          "text": "And a knob under two branches of the same, and a knob under two branches of the same, and a knob under two branches of the same, according to the six branches proceeding from it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.22",
      "edition_verse_id": "WEBSTER1833:EXO.37.22",
      "verse": 22,
      "spans": [
        {
          "text": "Their knobs and their branches were of the same: all of it ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " one beaten work ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.23",
      "edition_verse_id": "WEBSTER1833:EXO.37.23",
      "verse": 23,
      "spans": [
        {
          "text": "And he made its seven lamps, and its snuffers, and its snuff-dishes, ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.24",
      "edition_verse_id": "WEBSTER1833:EXO.37.24",
      "verse": 24,
      "spans": [
        {
          "text": "Of",
          "kind": "supplied"
        },
        {
          "text": " a talent of pure gold he made it, and all its vessels.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.25",
      "edition_verse_id": "WEBSTER1833:EXO.37.25",
      "verse": 25,
      "spans": [
        {
          "text": "And he made the incense-altar ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood: the length of it ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " a cubit, and the breadth of it a cubit; ",
          "kind": "text"
        },
        {
          "text": "it was",
          "kind": "supplied"
        },
        {
          "text": " foursquare; and two cubits ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the hight of it; the horns of it were of the same.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.26",
      "edition_verse_id": "WEBSTER1833:EXO.37.26",
      "verse": 26,
      "spans": [
        {
          "text": "And he overlaid it with pure gold, ",
          "kind": "text"
        },
        {
          "text": "both",
          "kind": "supplied"
        },
        {
          "text": " the top of it, and its sides round about, and its horns: also he made to it a crown of gold round about.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.27",
      "edition_verse_id": "WEBSTER1833:EXO.37.27",
      "verse": 27,
      "spans": [
        {
          "text": "And he made two rings of gold for it under its crown, by the two corners of it, upon its two sides, to be places for the staffs to bear it with.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.28",
      "edition_verse_id": "WEBSTER1833:EXO.37.28",
      "verse": 28,
      "spans": [
        {
          "text": "And he made the staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlaid them with gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.37.29",
      "edition_verse_id": "WEBSTER1833:EXO.37.29",
      "verse": 29,
      "spans": [
        {
          "text": "And he made the holy anointing oil, and the pure incense of sweet spices, according to the work of the apothecary.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
