{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EXO",
  "chapter": 27,
  "verses": [
    {
      "id": "EXO.27.1",
      "edition_verse_id": "WEBSTER1833:EXO.27.1",
      "verse": 1,
      "spans": [
        {
          "text": "And thou shalt make an altar ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, five cubits long, and five cubits broad; the altar shall be foursquare: and its hight ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " three cubits.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EXO.27.2",
      "edition_verse_id": "WEBSTER1833:EXO.27.2",
      "verse": 2,
      "spans": [
        {
          "text": "And thou shalt make the horns of it upon the four corners thereof: its horns shall be of the same: and thou shalt overlay it with brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.3",
      "edition_verse_id": "WEBSTER1833:EXO.27.3",
      "verse": 3,
      "spans": [
        {
          "text": "And thou shalt make its pans to receive its ashes, and its shovels, and its basins, and its flesh-hooks, and its fire-pans: all its vessels thou shalt make ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.4",
      "edition_verse_id": "WEBSTER1833:EXO.27.4",
      "verse": 4,
      "spans": [
        {
          "text": "And thou shalt make for it a grate of net-work of brass; and upon the net shalt thou make four brazen rings in its four corners.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.5",
      "edition_verse_id": "WEBSTER1833:EXO.27.5",
      "verse": 5,
      "spans": [
        {
          "text": "And thou shalt put it under the compass of the altar beneath, that the net may be even to the midst of the altar.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.6",
      "edition_verse_id": "WEBSTER1833:EXO.27.6",
      "verse": 6,
      "spans": [
        {
          "text": "And thou shalt make staffs for the altar, staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlay them with brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.7",
      "edition_verse_id": "WEBSTER1833:EXO.27.7",
      "verse": 7,
      "spans": [
        {
          "text": "And the staffs shall be put into the rings, and the staffs shall be upon the two sides of the altar, to bear it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.8",
      "edition_verse_id": "WEBSTER1833:EXO.27.8",
      "verse": 8,
      "spans": [
        {
          "text": "Hollow with boards shalt thou make it: as it was shown thee on the mount, so shall they make ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.9",
      "edition_verse_id": "WEBSTER1833:EXO.27.9",
      "verse": 9,
      "spans": [
        {
          "text": "And thou shalt make the court of the tabernacle: for the south side southward ",
          "kind": "text"
        },
        {
          "text": "there shall be",
          "kind": "supplied"
        },
        {
          "text": " hangings for the court ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " fine twined linen of a hundred cubits long for one side:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.10",
      "edition_verse_id": "WEBSTER1833:EXO.27.10",
      "verse": 10,
      "spans": [
        {
          "text": "And its twenty pillars and their twenty sockets ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " brass: the hooks of the pillars and their fillets ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " silver.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.11",
      "edition_verse_id": "WEBSTER1833:EXO.27.11",
      "verse": 11,
      "spans": [
        {
          "text": "And likewise for the north side in length ",
          "kind": "text"
        },
        {
          "text": "there shall be",
          "kind": "supplied"
        },
        {
          "text": " hangings of a hundred ",
          "kind": "text"
        },
        {
          "text": "cubits",
          "kind": "supplied"
        },
        {
          "text": " long, and its twenty pillars and their twenty sockets ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " brass: the hooks of the pillars and their fillets ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " silver.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.12",
      "edition_verse_id": "WEBSTER1833:EXO.27.12",
      "verse": 12,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " the breadth of the court on the west side ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " hangings of fifty cubits: their pillars ten, and their sockets ten.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.13",
      "edition_verse_id": "WEBSTER1833:EXO.27.13",
      "verse": 13,
      "spans": [
        {
          "text": "And the breadth of the court on the east side eastward ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " fifty cubits.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.14",
      "edition_verse_id": "WEBSTER1833:EXO.27.14",
      "verse": 14,
      "spans": [
        {
          "text": "The hangings of one side ",
          "kind": "text"
        },
        {
          "text": "of the gate shall be",
          "kind": "supplied"
        },
        {
          "text": " fifteen cubits: their pillars three, and their sockets three.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.15",
      "edition_verse_id": "WEBSTER1833:EXO.27.15",
      "verse": 15,
      "spans": [
        {
          "text": "And on the other side ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " hangings, fifteen ",
          "kind": "text"
        },
        {
          "text": "cubits",
          "kind": "supplied"
        },
        {
          "text": ": their pillars three, and their sockets three.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.16",
      "edition_verse_id": "WEBSTER1833:EXO.27.16",
      "verse": 16,
      "spans": [
        {
          "text": "And for the gate of the court ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " a hanging of twenty cubits, ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " blue, and purple, and scarlet, and fine twined linen, wrought with needle-work: ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " their pillars ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " four, and their sockets four.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.17",
      "edition_verse_id": "WEBSTER1833:EXO.27.17",
      "verse": 17,
      "spans": [
        {
          "text": "All the pillars around the court ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " filleted with silver: their hooks ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " silver, and their sockets ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.18",
      "edition_verse_id": "WEBSTER1833:EXO.27.18",
      "verse": 18,
      "spans": [
        {
          "text": "The length of the court ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " a hundred cubits, and the breadth fifty every where, and the hight five cubits ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " fine twined linen, and their sockets ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.19",
      "edition_verse_id": "WEBSTER1833:EXO.27.19",
      "verse": 19,
      "spans": [
        {
          "text": "All the vessels of the tabernacle in all the service thereof, and all the pins thereof, and all the pins of the court, ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " brass.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.20",
      "edition_verse_id": "WEBSTER1833:EXO.27.20",
      "verse": 20,
      "spans": [
        {
          "text": "And thou shalt command the children of Israel, that they bring the pure olive-oil beaten for the light, to cause the lamp to burn always.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.27.21",
      "edition_verse_id": "WEBSTER1833:EXO.27.21",
      "verse": 21,
      "spans": [
        {
          "text": "In the tabernacle of the congregation without the vail, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " before the testimony, Aaron and his sons shall order it from evening to morning before the LORD: ",
          "kind": "text"
        },
        {
          "text": "It shall be",
          "kind": "supplied"
        },
        {
          "text": " a statute for ever to their generations on the behalf of the children of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
