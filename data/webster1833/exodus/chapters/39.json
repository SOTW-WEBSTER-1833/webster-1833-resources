      "paragraph_start": false
    },
    {
      "id": "EXO.39.7",
      "edition_verse_id": "WEBSTER1833:EXO.39.7",
      "verse": 7,
      "spans": [
        {
          "text": "And he put them on the shoulders of the ephod, ",
          "kind": "text"
        },
        {
          "text": "that they should be",
          "kind": "supplied"
        },
        {
          "text": " stones for a memorial to the children of Israel; as the LORD commanded Moses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.8",
      "edition_verse_id": "WEBSTER1833:EXO.39.8",
      "verse": 8,
      "spans": [
        {
          "text": "And he made the breast-plate ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " curious work, like the work of the ephod; ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " gold, blue, and purple, and scarlet, and fine twined linen.",
