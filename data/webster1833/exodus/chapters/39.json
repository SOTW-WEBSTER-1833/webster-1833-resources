      "edition_verse_id": "WEBSTER1833:EXO.39.39",
      "verse": 39,
      "spans": [
        {
          "text": "The brazen altar, and its grate of brass, its staffs, and all its vessels, the laver and its foot,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.40",
      "edition_verse_id": "WEBSTER1833:EXO.39.40",
      "verse": 40,
      "spans": [
        {
          "text": "The hangings of the court, its pillars, and its sockets, and the hanging for the court-gate, its cords, and its pins, and all the vessels of the service of the tabernacle, for the tent of the congregation,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
