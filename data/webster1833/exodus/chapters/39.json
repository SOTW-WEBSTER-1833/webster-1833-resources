      "id": "EXO.39.35",
      "edition_verse_id": "WEBSTER1833:EXO.39.35",
      "verse": 35,
      "spans": [
        {
          "text": "The ark of the testimony, and its staffs, and the mercy-seat,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
