      "id": "EXO.39.33",
      "edition_verse_id": "WEBSTER1833:EXO.39.33",
      "verse": 33,
      "spans": [
        {
          "text": "And they brought the tabernacle to Moses, the tent, and all its furniture, its buttons, its boards, its bars, and its pillars, and its sockets,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
