        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " on the two ends of the breast-plate, upon the border of it, which ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " on the side of the ephod inward.",
          "kind": "text"
        }
