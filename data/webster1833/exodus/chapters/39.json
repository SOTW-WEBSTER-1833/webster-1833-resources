      "id": "EXO.39.20",
      "edition_verse_id": "WEBSTER1833:EXO.39.20",
      "verse": 20,
      "spans": [
        {
          "text": "And they made two ",
          "kind": "text"
        },
        {
          "text": "other",
          "kind": "supplied"
        },
        {
