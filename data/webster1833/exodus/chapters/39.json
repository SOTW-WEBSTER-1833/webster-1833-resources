      "edition_verse_id": "WEBSTER1833:EXO.39.1",
      "verse": 1,
      "spans": [
        {
          "text": "And of the blue, and purple, and scarlet, they made clothes of service, to do service in the holy ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
