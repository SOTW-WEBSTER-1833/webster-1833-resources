      "edition_verse_id": "WEBSTER1833:EXO.39.24",
      "verse": 24,
      "spans": [
        {
          "text": "And they made upon the hems of the robe pomegranates ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " blue, and purple, and scarlet, ",
          "kind": "text"
        },
        {
          "text": "and",
