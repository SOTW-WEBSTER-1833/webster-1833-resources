        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " wreathed work ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.16",
      "edition_verse_id": "WEBSTER1833:EXO.39.16",
      "verse": 16,
      "spans": [
        {
          "text": "And they made two ouches ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " gold, and two gold rings, and put the two rings in the two ends of the breast-plate.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.17",
      "edition_verse_id": "WEBSTER1833:EXO.39.17",
      "verse": 17,
      "spans": [
        {
          "text": "And they put the two wreathed chains of gold in the two rings on the ends of the breast-plate.",
