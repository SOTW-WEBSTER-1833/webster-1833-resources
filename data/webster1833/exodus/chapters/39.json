      "paragraph_start": false
    },
    {
      "id": "EXO.39.12",
      "edition_verse_id": "WEBSTER1833:EXO.39.12",
      "verse": 12,
      "spans": [
        {
          "text": "And the third row, a ligure, an agate, and an amethyst.",
