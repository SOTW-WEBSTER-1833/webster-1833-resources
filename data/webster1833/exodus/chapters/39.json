      "edition_verse_id": "WEBSTER1833:EXO.39.4",
      "verse": 4,
      "spans": [
        {
          "text": "They made shoulder-pieces for it, to couple ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " together: by the two edges was it coupled together.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
