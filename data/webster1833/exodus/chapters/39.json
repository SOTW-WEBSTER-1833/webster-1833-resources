      "id": "EXO.39.36",
      "edition_verse_id": "WEBSTER1833:EXO.39.36",
      "verse": 36,
      "spans": [
        {
          "text": "The table, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " all its vessels, and the show-bread,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.37",
      "edition_verse_id": "WEBSTER1833:EXO.39.37",
      "verse": 37,
      "spans": [
        {
          "text": "The pure candlestick, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " its lamps, ",
          "kind": "text"
        },
        {
          "text": "even with",
          "kind": "supplied"
        },
        {
          "text": " the lamps to be set in order, and all its vessels, and the oil for light,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
