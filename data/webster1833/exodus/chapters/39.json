      "edition_verse_id": "WEBSTER1833:EXO.39.2",
      "verse": 2,
      "spans": [
        {
          "text": "And he made the ephod ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " gold, blue, and purple, and scarlet, and fine twined linen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.39.3",
      "edition_verse_id": "WEBSTER1833:EXO.39.3",
