{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "JOS",
  "chapter": 12,
  "verses": [
    {
      "id": "JOS.12.1",
      "edition_verse_id": "WEBSTER1833:JOS.12.1",
      "verse": 1,
      "spans": [
        {
          "text": "Now these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the kings of the land, whom the children of Israel smote, and possessed their land on the other side of Jordan towards the rising of the sun, from the river Arnon, to mount Hermon, and all the plain on the east:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "JOS.12.2",
      "edition_verse_id": "WEBSTER1833:JOS.12.2",
      "verse": 2,
      "spans": [
        {
          "text": "Sihon king of the Amorites, who dwelt in Heshbon, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " ruled from Aroer, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " upon the bank of the river Arnon, and from the middle of the river, and from half Gilead, even to the river Jabbok, ",
          "kind": "text"
        },
        {
          "text": "which is",
          "kind": "supplied"
        },
        {
          "text": " the border of the children of Ammon;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.3",
      "edition_verse_id": "WEBSTER1833:JOS.12.3",
      "verse": 3,
      "spans": [
        {
          "text": "And from the plain to the sea of Cinneroth on the east, and to the sea of the plain, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " the salt sea on the east, the way to Beth-jeshimoth; and from the south, under Ashdoth-pisgah:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.4",
      "edition_verse_id": "WEBSTER1833:JOS.12.4",
      "verse": 4,
      "spans": [
        {
          "text": "And the coast of Og king of Bashan, ",
          "kind": "text"
        },
        {
          "text": "who was",
          "kind": "supplied"
        },
        {
          "text": " of the remnant of the giants, that dwelt at Ashtaroth and at Edrei,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.5",
      "edition_verse_id": "WEBSTER1833:JOS.12.5",
      "verse": 5,
      "spans": [
        {
          "text": "And reigned in mount Hermon, and in Salcah, and in all Bashan, to the border of the Geshurites, and the Maachathites, and half Gilead, the border of Sihon king of Heshbon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.6",
      "edition_verse_id": "WEBSTER1833:JOS.12.6",
      "verse": 6,
      "spans": [
        {
          "text": "Them did Moses the servant of the LORD, and the children of Israel smite: and Moses the servant of the LORD gave it ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a possession to the Reubenites, and the Gadites, and the half-tribe of Manasseh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.7",
      "edition_verse_id": "WEBSTER1833:JOS.12.7",
      "verse": 7,
      "spans": [
        {
          "text": "And these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the kings of the country whom Joshua and the children of Israel smote on this side of Jordan on the west, from Baal-gad in the valley of Lebanon, even to the mount Halak that goeth up to Seir; which Joshua gave to the tribes of Israel ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a possession according to their divisions;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.8",
      "edition_verse_id": "WEBSTER1833:JOS.12.8",
      "verse": 8,
      "spans": [
        {
          "text": "In the mountains, and in the valleys, and in the plains, and in the springs, and in the wilderness, and in the south country; the Hittites, the Amorites, and the Canaanites, the Perizzites, the Hivites, and the Jebusites:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.9",
      "edition_verse_id": "WEBSTER1833:JOS.12.9",
      "verse": 9,
      "spans": [
        {
          "text": "The king of Jericho one; the king of Ai, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " beside Beth-el, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.10",
      "edition_verse_id": "WEBSTER1833:JOS.12.10",
      "verse": 10,
      "spans": [
        {
          "text": "The king of Jerusalem, one; the king of Hebron, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.11",
      "edition_verse_id": "WEBSTER1833:JOS.12.11",
      "verse": 11,
      "spans": [
        {
          "text": "The king of Jarmuth, one; the king of Lachish, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.12",
      "edition_verse_id": "WEBSTER1833:JOS.12.12",
      "verse": 12,
      "spans": [
        {
          "text": "The king of Eglon, one; the king of Gezer, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.13",
      "edition_verse_id": "WEBSTER1833:JOS.12.13",
      "verse": 13,
      "spans": [
        {
          "text": "The king of Debir, one; the king of Geder, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.14",
      "edition_verse_id": "WEBSTER1833:JOS.12.14",
      "verse": 14,
      "spans": [
        {
          "text": "The king of Hormah, one; the king of Arad, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.15",
      "edition_verse_id": "WEBSTER1833:JOS.12.15",
      "verse": 15,
      "spans": [
        {
          "text": "The king of Libnah, one; the king of Adullam, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.16",
      "edition_verse_id": "WEBSTER1833:JOS.12.16",
      "verse": 16,
      "spans": [
        {
          "text": "The king of Makkedah, one; the king of Beth-el, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.17",
      "edition_verse_id": "WEBSTER1833:JOS.12.17",
      "verse": 17,
      "spans": [
        {
          "text": "The king of Tappuah, one; the king of Hepher, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.18",
      "edition_verse_id": "WEBSTER1833:JOS.12.18",
      "verse": 18,
      "spans": [
        {
          "text": "The king of Aphek, one; the king of Lasharon, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.19",
      "edition_verse_id": "WEBSTER1833:JOS.12.19",
      "verse": 19,
      "spans": [
        {
          "text": "The king of Madon, one; the king of Hazor, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.20",
      "edition_verse_id": "WEBSTER1833:JOS.12.20",
      "verse": 20,
      "spans": [
        {
          "text": "The king of Shimron-meron, one; the king of Achshaph, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.21",
      "edition_verse_id": "WEBSTER1833:JOS.12.21",
      "verse": 21,
      "spans": [
        {
          "text": "The king of Taanach, one; the king of Megiddo, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.22",
      "edition_verse_id": "WEBSTER1833:JOS.12.22",
      "verse": 22,
      "spans": [
        {
          "text": "The king of Kedesh, one; the king of Jokneam of Carmel, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.23",
      "edition_verse_id": "WEBSTER1833:JOS.12.23",
      "verse": 23,
      "spans": [
        {
          "text": "The king of Dor in the border of Dor, one; the king of the nations of Gilgal, one;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "JOS.12.24",
      "edition_verse_id": "WEBSTER1833:JOS.12.24",
      "verse": 24,
      "spans": [
        {
          "text": "The king of Tirzah, one: all the kings thirty and one.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
