{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EZK",
  "chapter": 48,
  "verses": [
    {
      "id": "EZK.48.1",
      "edition_verse_id": "WEBSTER1833:EZK.48.1",
      "verse": 1,
      "spans": [
        {
          "text": "Now these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the names of the tribes. From the north end to the border of the way of Hethlon, as one goeth to Hamath, Hazar-enan, the border of Damascus northward, to the limit of Hamath; for these are his sides east ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " west; a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Dan.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EZK.48.2",
      "edition_verse_id": "WEBSTER1833:EZK.48.2",
      "verse": 2,
      "spans": [
        {
          "text": "And by the border of Dan, from the east side to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Asher.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.3",
      "edition_verse_id": "WEBSTER1833:EZK.48.3",
      "verse": 3,
      "spans": [
        {
          "text": "And by the border of Asher, from the east side even to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Naphtali.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.4",
      "edition_verse_id": "WEBSTER1833:EZK.48.4",
      "verse": 4,
      "spans": [
        {
          "text": "And by the border of Naphtali, from the east side to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Manasseh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.5",
      "edition_verse_id": "WEBSTER1833:EZK.48.5",
      "verse": 5,
      "spans": [
        {
          "text": "And by the border of Manasseh, from the east side to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Ephraim.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.6",
      "edition_verse_id": "WEBSTER1833:EZK.48.6",
      "verse": 6,
      "spans": [
        {
          "text": "And by the border of Ephraim, from the east side even to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Reuben.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.7",
      "edition_verse_id": "WEBSTER1833:EZK.48.7",
      "verse": 7,
      "spans": [
        {
          "text": "And by the border of Reuben, from the east side to the west side, a ",
          "kind": "text"
        },
        {
          "text": "portion for",
          "kind": "supplied"
        },
        {
          "text": " Judah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.8",
      "edition_verse_id": "WEBSTER1833:EZK.48.8",
      "verse": 8,
      "spans": [
        {
          "text": "And by the border of Judah, from the east side to the west side, shall be the offering which ye shall offer of five and twenty thousand ",
          "kind": "text"
        },
        {
          "text": "reeds in",
          "kind": "supplied"
        },
        {
          "text": " breadth, and ",
          "kind": "text"
        },
        {
          "text": "in",
          "kind": "supplied"
        },
        {
          "text": " length as one of the ",
          "kind": "text"
        },
        {
          "text": "other",
          "kind": "supplied"
        },
        {
          "text": " parts, from the east side to the west side: and the sanctuary shall be in the midst of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.9",
      "edition_verse_id": "WEBSTER1833:EZK.48.9",
      "verse": 9,
      "spans": [
        {
          "text": "The oblation that ye shall offer to the LORD ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " of five and twenty thousand in length, and of ten thousand in breadth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.10",
      "edition_verse_id": "WEBSTER1833:EZK.48.10",
      "verse": 10,
      "spans": [
        {
          "text": "And for them, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " for the priests, shall be ",
          "kind": "text"
        },
        {
          "text": "this",
          "kind": "supplied"
        },
        {
          "text": " holy oblation; towards the north five and twenty thousand ",
          "kind": "text"
        },
        {
          "text": "in length",
          "kind": "supplied"
        },
        {
          "text": ", and towards the west ten thousand in breadth, and towards the east ten thousand in breadth, and towards the south five and twenty thousand in length: and the sanctuary of the LORD shall be in the midst of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.11",
      "edition_verse_id": "WEBSTER1833:EZK.48.11",
      "verse": 11,
      "spans": [
        {
          "text": "It shall be",
          "kind": "supplied"
        },
        {
          "text": " for the priests that are sanctified of the sons of Zadok; who have kept my charge, who went not astray when the children of Israel went astray, as the Levites went astray.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.12",
      "edition_verse_id": "WEBSTER1833:EZK.48.12",
      "verse": 12,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "this",
          "kind": "supplied"
        },
        {
          "text": " oblation of the land that is offered shall be to them a thing most holy, by the border of the Levites.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.13",
      "edition_verse_id": "WEBSTER1833:EZK.48.13",
      "verse": 13,
      "spans": [
        {
          "text": "And over against the border of the priests the Levites ",
          "kind": "text"
        },
        {
          "text": "shall have",
          "kind": "supplied"
        },
        {
          "text": " five and twenty thousand in length, and ten thousand in breadth: all the length ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " five and twenty thousand, and the breadth ten thousand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.14",
      "edition_verse_id": "WEBSTER1833:EZK.48.14",
      "verse": 14,
      "spans": [
        {
          "text": "And they shall not sell of it, neither exchange, nor alienate the first-fruits of the land: for ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " holy to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.15",
      "edition_verse_id": "WEBSTER1833:EZK.48.15",
      "verse": 15,
      "spans": [
        {
          "text": "And the five thousand, that are left in the breadth over against the five and twenty thousand, shall be a profane ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
          "text": " for the city, for dwelling, and for suburbs, and the city shall be in the midst of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.16",
      "edition_verse_id": "WEBSTER1833:EZK.48.16",
      "verse": 16,
      "spans": [
        {
          "text": "And these ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " the measures of it; the north side four thousand and five hundred, and the south side four thousand and five hundred, and on the east side four thousand and five hundred, and the west side four thousand and five hundred.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.17",
      "edition_verse_id": "WEBSTER1833:EZK.48.17",
      "verse": 17,
      "spans": [
        {
          "text": "And the suburbs of the city shall be towards the north two hundred and fifty, and towards the south two hundred and fifty, and towards the east two hundred and fifty, and towards the west two hundred and fifty.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.18",
      "edition_verse_id": "WEBSTER1833:EZK.48.18",
      "verse": 18,
      "spans": [
        {
          "text": "And the residue in length over against the oblation of the holy ",
          "kind": "text"
        },
        {
          "text": "portion shall be",
          "kind": "supplied"
        },
        {
          "text": " ten thousand eastward, and ten thousand westward: and it shall be over against the oblation of the holy ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": "; and its increase shall be for food to them that serve the city.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.19",
      "edition_verse_id": "WEBSTER1833:EZK.48.19",
      "verse": 19,
      "spans": [
        {
          "text": "And they that serve the city shall serve it out of all the tribes of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.20",
      "edition_verse_id": "WEBSTER1833:EZK.48.20",
      "verse": 20,
      "spans": [
        {
          "text": "All the oblation ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " five and twenty thousand by five and twenty thousand: ye shall offer the holy oblation foursquare, with the possession of the city.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.21",
      "edition_verse_id": "WEBSTER1833:EZK.48.21",
      "verse": 21,
      "spans": [
        {
          "text": "And the residue ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " for the prince, on the one side and on the other of the holy oblation, and of the possession of the city, over against the five and twenty thousand of the oblation towards the east border, and westward over against the five and twenty thousand towards the west border, over against the portions for the prince: and it shall be the holy oblation; and the sanctuary of the house ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " in the midst of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.22",
      "edition_verse_id": "WEBSTER1833:EZK.48.22",
      "verse": 22,
      "spans": [
        {
          "text": "Moreover from the possession of the Levites, and from the possession of the city, ",
          "kind": "text"
        },
        {
          "text": "being",
          "kind": "supplied"
        },
        {
          "text": " in the midst ",
          "kind": "text"
        },
        {
          "text": "of that",
          "kind": "supplied"
        },
        {
          "text": " which is the prince's, between the border of Judah and the border of Benjamin, shall be for the prince.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.23",
      "edition_verse_id": "WEBSTER1833:EZK.48.23",
      "verse": 23,
      "spans": [
        {
          "text": "As for the rest of the tribes, from the east side to the west side, Benjamin ",
          "kind": "text"
        },
        {
          "text": "shall have",
          "kind": "supplied"
        },
        {
          "text": " a ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.24",
      "edition_verse_id": "WEBSTER1833:EZK.48.24",
      "verse": 24,
      "spans": [
        {
          "text": "And by the border of Benjamin, from the east side to the west side, Simeon ",
          "kind": "text"
        },
        {
          "text": "shall have",
          "kind": "supplied"
        },
        {
          "text": " a ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.25",
      "edition_verse_id": "WEBSTER1833:EZK.48.25",
      "verse": 25,
      "spans": [
        {
          "text": "And by the border of Simeon, from the east side to the west side, Issachar a ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.26",
      "edition_verse_id": "WEBSTER1833:EZK.48.26",
      "verse": 26,
      "spans": [
        {
          "text": "And by the border of Issachar, from the east side to the west side, Zebulun a ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.27",
      "edition_verse_id": "WEBSTER1833:EZK.48.27",
      "verse": 27,
      "spans": [
        {
          "text": "And by the border of Zebulun, from the east side to the west side, Gad a ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.28",
      "edition_verse_id": "WEBSTER1833:EZK.48.28",
      "verse": 28,
      "spans": [
        {
          "text": "And by the border of Gad, at the south side southward, the border shall be even from Tamar ",
          "kind": "text"
        },
        {
          "text": "to",
          "kind": "supplied"
        },
        {
          "text": " the waters of strife ",
          "kind": "text"
        },
        {
          "text": "in",
          "kind": "supplied"
        },
        {
          "text": " Kadesh, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " to the river towards the great sea.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.29",
      "edition_verse_id": "WEBSTER1833:EZK.48.29",
      "verse": 29,
      "spans": [
        {
          "text": "This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the land which ye shall divide by lot to the tribes of Israel for inheritance, and these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " their portions, saith the Lord GOD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.30",
      "edition_verse_id": "WEBSTER1833:EZK.48.30",
      "verse": 30,
      "spans": [
        {
          "text": "And these ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the goings out of the city on the north side, four thousand and five hundred measures.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.31",
      "edition_verse_id": "WEBSTER1833:EZK.48.31",
      "verse": 31,
      "spans": [
        {
          "text": "And the gates of the city ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " after the names of the tribes of Israel: three gates northward; one gate of Reuben, one gate of Judah, one gate of Levi.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.32",
      "edition_verse_id": "WEBSTER1833:EZK.48.32",
      "verse": 32,
      "spans": [
        {
          "text": "And at the east side four thousand and five hundred: and three gates; one gate of Joseph, one gate of Benjamin, one gate of Dan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.33",
      "edition_verse_id": "WEBSTER1833:EZK.48.33",
      "verse": 33,
      "spans": [
        {
          "text": "And at the south side four thousand and five hundred measures: and three gates; one gate of Simeon, one gate of Issachar, one gate of Zebulun.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.34",
      "edition_verse_id": "WEBSTER1833:EZK.48.34",
      "verse": 34,
      "spans": [
        {
          "text": "And the west side four thousand and five hundred, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " their three gates: one gate of Gad, one gate of Asher, one gate of Naphtali.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.48.35",
      "edition_verse_id": "WEBSTER1833:EZK.48.35",
      "verse": 35,
      "spans": [
        {
          "text": "The circuit ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " eighteen thousand ",
          "kind": "text"
        },
        {
          "text": "measures",
          "kind": "supplied"
        },
        {
          "text": ": and the name of the city from ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " day ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": ", The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " there.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
