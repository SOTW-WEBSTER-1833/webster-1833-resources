{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EZK",
  "chapter": 45,
  "verses": [
    {
      "id": "EZK.45.1",
      "edition_verse_id": "WEBSTER1833:EZK.45.1",
      "verse": 1,
      "spans": [
        {
          "text": "Moreover, when ye shall divide by lot the land for inheritance, ye shall offer an oblation to the LORD, a holy portion of the land: the length ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " the length of five and twenty thousand ",
          "kind": "text"
        },
        {
          "text": "reeds",
          "kind": "supplied"
        },
        {
          "text": ", and the breadth ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " ten thousand. This ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " holy in all its borders on every side.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EZK.45.2",
      "edition_verse_id": "WEBSTER1833:EZK.45.2",
      "verse": 2,
      "spans": [
        {
          "text": "Of this there shall be for the sanctuary five hundred ",
          "kind": "text"
        },
        {
          "text": "in length",
          "kind": "supplied"
        },
        {
          "text": ", with five hundred ",
          "kind": "text"
        },
        {
          "text": "in breadth",
          "kind": "supplied"
        },
        {
          "text": ", square around; and fifty cubits around for the suburbs of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.3",
      "edition_verse_id": "WEBSTER1833:EZK.45.3",
      "verse": 3,
      "spans": [
        {
          "text": "And of this measure shalt thou measure the length of five and twenty thousand, and the breadth of ten thousand: and in it shall be the sanctuary ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " the most holy ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.4",
      "edition_verse_id": "WEBSTER1833:EZK.45.4",
      "verse": 4,
      "spans": [
        {
          "text": "The holy ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": " of the land shall be for the priests the ministers of the sanctuary, who shall come near to minister to the LORD: and it shall be a place for their houses, and a holy place for the sanctuary.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.5",
      "edition_verse_id": "WEBSTER1833:EZK.45.5",
      "verse": 5,
      "spans": [
        {
          "text": "And the five and twenty thousand of length, and the ten thousand of breadth, shall also the Levites, the ministers of the house, have for themselves, for a possession for twenty chambers.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.6",
      "edition_verse_id": "WEBSTER1833:EZK.45.6",
      "verse": 6,
      "spans": [
        {
          "text": "And ye shall appoint the possession of the city five thousand broad, and five and twenty thousand long, over against the oblation of the holy ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ": it shall be for the whole house of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.7",
      "edition_verse_id": "WEBSTER1833:EZK.45.7",
      "verse": 7,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "a portion shall be",
          "kind": "supplied"
        },
        {
          "text": " for the prince on the one side and on the other side of the oblation of the holy ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ", and of the possession of the city, before the oblation of the holy ",
          "kind": "text"
        },
        {
          "text": "portion",
          "kind": "supplied"
        },
        {
          "text": ", and before the possession of the city, from the west side westward, and from the east side eastward: and the length ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " over against one of the portions, from the west border to the east border.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.8",
      "edition_verse_id": "WEBSTER1833:EZK.45.8",
      "verse": 8,
      "spans": [
        {
          "text": "In the land shall be his possession in Israel: and my princes shall no more oppress my people; and ",
          "kind": "text"
        },
        {
          "text": "the rest of",
          "kind": "supplied"
        },
        {
          "text": " the land shall they give to the house of Israel according to their tribes.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.9",
      "edition_verse_id": "WEBSTER1833:EZK.45.9",
      "verse": 9,
      "spans": [
        {
          "text": "Thus saith the Lord GOD; Let it suffice you, O princes of Israel: remove violence and spoil, and execute judgment and justice, take away your exactions from my people, saith the Lord GOD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.10",
      "edition_verse_id": "WEBSTER1833:EZK.45.10",
      "verse": 10,
      "spans": [
        {
          "text": "Ye shall have just balances, and a just ephah, and a just bath.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.11",
      "edition_verse_id": "WEBSTER1833:EZK.45.11",
      "verse": 11,
      "spans": [
        {
          "text": "The ephah and the bath shall be of one measure, that the bath may contain the tenth part of a homer, and the ephah the tenth part of a homer: the measure of it shall be after the homer.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.12",
      "edition_verse_id": "WEBSTER1833:EZK.45.12",
      "verse": 12,
      "spans": [
        {
          "text": "And the shekel ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " twenty gerahs: twenty shekels, five and twenty shekels, fifteen shekels, shall be your maneh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.13",
      "edition_verse_id": "WEBSTER1833:EZK.45.13",
      "verse": 13,
      "spans": [
        {
          "text": "This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the oblation that ye shall offer; the sixth part of an ephah of a homer of wheat, and ye shall give the sixth part of an ephah of a homer of barley;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.14",
      "edition_verse_id": "WEBSTER1833:EZK.45.14",
      "verse": 14,
      "spans": [
        {
          "text": "Concerning the ordinance of oil, the bath of oil, ",
          "kind": "text"
        },
        {
          "text": "ye shall offer",
          "kind": "supplied"
        },
        {
          "text": " the tenth part of a bath out of the cor, ",
          "kind": "text"
        },
        {
          "text": "which is",
          "kind": "supplied"
        },
        {
          "text": " a homer of ten baths: for ten baths ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " a homer:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.15",
      "edition_verse_id": "WEBSTER1833:EZK.45.15",
      "verse": 15,
      "spans": [
        {
          "text": "And one lamb out of the flock, out of two hundred, out of the fat pastures of Israel; for a meat-offering, and for a burnt-offering, and for peace-offerings, to make reconciliation for them, saith the Lord GOD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.16",
      "edition_verse_id": "WEBSTER1833:EZK.45.16",
      "verse": 16,
      "spans": [
        {
          "text": "All the people of the land shall give this oblation for the prince in Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.17",
      "edition_verse_id": "WEBSTER1833:EZK.45.17",
      "verse": 17,
      "spans": [
        {
          "text": "And it shall be the prince's part ",
          "kind": "text"
        },
        {
          "text": "to give",
          "kind": "supplied"
        },
        {
          "text": " burnt-offerings, and meat-offerings, and drink-offerings, in the feasts, and in the new moons, and in the sabbaths, in all solemnities of the house of Israel: he shall prepare the sin-offering, and the meat-offering, and the burnt-offering, and the peace-offerings, to make reconciliation for the house of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.18",
      "edition_verse_id": "WEBSTER1833:EZK.45.18",
      "verse": 18,
      "spans": [
        {
          "text": "Thus saith the Lord GOD; In the first ",
          "kind": "text"
        },
        {
          "text": "month",
          "kind": "supplied"
        },
        {
          "text": ", in the first ",
          "kind": "text"
        },
        {
          "text": "day",
          "kind": "supplied"
        },
        {
          "text": " of the month, thou shalt take a young bullock without blemish, and cleanse the sanctuary:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.19",
      "edition_verse_id": "WEBSTER1833:EZK.45.19",
      "verse": 19,
      "spans": [
        {
          "text": "And the priest shall take of the blood of the sin-offering, and put ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": " upon the posts of the house, and upon the four corners of the settle of the altar, and upon the posts of the gate of the inner court.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.20",
      "edition_verse_id": "WEBSTER1833:EZK.45.20",
      "verse": 20,
      "spans": [
        {
          "text": "And so thou shalt do the seventh ",
          "kind": "text"
        },
        {
          "text": "day",
          "kind": "supplied"
        },
        {
          "text": " of the month for every one that erreth, and for ",
          "kind": "text"
        },
        {
          "text": "him that is",
          "kind": "supplied"
        },
        {
          "text": " simple: so shall ye reconcile the house.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.21",
      "edition_verse_id": "WEBSTER1833:EZK.45.21",
      "verse": 21,
      "spans": [
        {
          "text": "In the first ",
          "kind": "text"
        },
        {
          "text": "month",
          "kind": "supplied"
        },
        {
          "text": ", in the fourteenth day of the month, ye shall have the passover, a feast of seven days; unleavened bread shall be eaten.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.22",
      "edition_verse_id": "WEBSTER1833:EZK.45.22",
      "verse": 22,
      "spans": [
        {
          "text": "And upon that day shall the prince prepare for himself and for all the people of the land a bullock ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a sin-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.23",
      "edition_verse_id": "WEBSTER1833:EZK.45.23",
      "verse": 23,
      "spans": [
        {
          "text": "And seven days of the feast he shall prepare a burnt-offering to the LORD, seven bullocks and seven rams without blemish daily the seven days; and a kid of the goats daily ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " a sin-offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.24",
      "edition_verse_id": "WEBSTER1833:EZK.45.24",
      "verse": 24,
      "spans": [
        {
          "text": "And he shall prepare a meat-offering of an ephah for a bullock, and an ephah for a ram, and a hin of oil for an ephah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EZK.45.25",
      "edition_verse_id": "WEBSTER1833:EZK.45.25",
      "verse": 25,
      "spans": [
        {
          "text": "In the seventh ",
          "kind": "text"
        },
        {
          "text": "month",
          "kind": "supplied"
        },
        {
          "text": ", in the fifteenth day of the month, shall he do the like in the feast of the seven days, according to the sin-offering, according to the burnt-offering, and according to the meat-offering, and according to the oil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
