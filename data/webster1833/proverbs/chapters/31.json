{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 31,
  "verses": [
    {
      "id": "PRO.31.1",
      "edition_verse_id": "WEBSTER1833:PRO.31.1",
      "verse": 1,
      "spans": [
        {
          "text": "The words of king Lemuel, the prophecy that his mother taught him.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.31.2",
      "edition_verse_id": "WEBSTER1833:PRO.31.2",
      "verse": 2,
      "spans": [
        {
          "text": "What, my son? and what, the son of my womb? and what, the son of my vows?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.3",
      "edition_verse_id": "WEBSTER1833:PRO.31.3",
      "verse": 3,
      "spans": [
        {
          "text": "Give not thy strength to women, nor thy ways to that which destroyeth kings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.4",
      "edition_verse_id": "WEBSTER1833:PRO.31.4",
      "verse": 4,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " not for kings, O Lemuel, ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " not for kings to drink wine; nor for princes strong drink:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.5",
      "edition_verse_id": "WEBSTER1833:PRO.31.5",
      "verse": 5,
      "spans": [
        {
          "text": "Lest they drink, and forget the law, and pervert the judgment of any of the afflicted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.6",
      "edition_verse_id": "WEBSTER1833:PRO.31.6",
      "verse": 6,
      "spans": [
        {
          "text": "Give strong drink to him that is ready to perish, and wine to those that are of heavy hearts.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.7",
      "edition_verse_id": "WEBSTER1833:PRO.31.7",
      "verse": 7,
      "spans": [
        {
          "text": "Let him drink, and forget his poverty, and remember his misery no more.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.8",
      "edition_verse_id": "WEBSTER1833:PRO.31.8",
      "verse": 8,
      "spans": [
        {
          "text": "Open thy mouth for the dumb in the cause of all such as are appointed to destruction.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.9",
      "edition_verse_id": "WEBSTER1833:PRO.31.9",
      "verse": 9,
      "spans": [
        {
          "text": "Open thy mouth, judge righteously, and plead the cause of the poor and needy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.10",
      "edition_verse_id": "WEBSTER1833:PRO.31.10",
      "verse": 10,
      "spans": [
        {
          "text": "Who can find a virtuous woman? for her price ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " far above rubies.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.11",
      "edition_verse_id": "WEBSTER1833:PRO.31.11",
      "verse": 11,
      "spans": [
        {
          "text": "The heart of her husband doth safely trust in her, so that he shall have no need of spoil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.12",
      "edition_verse_id": "WEBSTER1833:PRO.31.12",
      "verse": 12,
      "spans": [
        {
          "text": "She will do him good and not evil all the days of her life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.13",
      "edition_verse_id": "WEBSTER1833:PRO.31.13",
      "verse": 13,
      "spans": [
        {
          "text": "She seeketh wool, and flax, and worketh willingly with her hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.14",
      "edition_verse_id": "WEBSTER1833:PRO.31.14",
      "verse": 14,
      "spans": [
        {
          "text": "She is like the merchant's ships; she bringeth her food from afar.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.15",
      "edition_verse_id": "WEBSTER1833:PRO.31.15",
      "verse": 15,
      "spans": [
        {
          "text": "She riseth also while it is yet night, and giveth food to her household, and a portion to her maidens.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.16",
      "edition_verse_id": "WEBSTER1833:PRO.31.16",
      "verse": 16,
      "spans": [
        {
          "text": "She considereth a field, and buyeth it: with the fruit of her hands she planteth a vineyard.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.17",
      "edition_verse_id": "WEBSTER1833:PRO.31.17",
      "verse": 17,
      "spans": [
        {
          "text": "She girdeth her loins with strength, and strengtheneth her arms.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.18",
      "edition_verse_id": "WEBSTER1833:PRO.31.18",
      "verse": 18,
      "spans": [
        {
          "text": "She perceiveth that her merchandise ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " good: her candle goeth not out by night.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.19",
      "edition_verse_id": "WEBSTER1833:PRO.31.19",
      "verse": 19,
      "spans": [
        {
          "text": "She layeth her hands to the spindle, and her hands hold the distaff.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.20",
      "edition_verse_id": "WEBSTER1833:PRO.31.20",
      "verse": 20,
      "spans": [
        {
          "text": "She stretcheth out her hand to the poor; yes, she reacheth forth her hands to the needy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.21",
      "edition_verse_id": "WEBSTER1833:PRO.31.21",
      "verse": 21,
      "spans": [
        {
          "text": "She is not afraid of the snow for her household: for all her household ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " clothed with scarlet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.22",
      "edition_verse_id": "WEBSTER1833:PRO.31.22",
      "verse": 22,
      "spans": [
        {
          "text": "She maketh herself coverings of tapestry; her clothing ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " silk and purple.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.23",
      "edition_verse_id": "WEBSTER1833:PRO.31.23",
      "verse": 23,
      "spans": [
        {
          "text": "Her husband is known in the gates, when he sitteth among the elders of the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.24",
      "edition_verse_id": "WEBSTER1833:PRO.31.24",
      "verse": 24,
      "spans": [
        {
          "text": "She maketh fine linen, and selleth ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": "; and delivereth girdles to the merchant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.25",
      "edition_verse_id": "WEBSTER1833:PRO.31.25",
      "verse": 25,
      "spans": [
        {
          "text": "Strength and honor ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " her clothing; and she shall rejoice in time to come.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.26",
      "edition_verse_id": "WEBSTER1833:PRO.31.26",
      "verse": 26,
      "spans": [
        {
          "text": "She openeth her mouth with wisdom; and on her tongue ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the law of kindness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.27",
      "edition_verse_id": "WEBSTER1833:PRO.31.27",
      "verse": 27,
      "spans": [
        {
          "text": "She looketh well to the ways of her household, and eateth not the bread of idleness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.28",
      "edition_verse_id": "WEBSTER1833:PRO.31.28",
      "verse": 28,
      "spans": [
        {
          "text": "Her children rise up, and call her blessed; her husband ",
          "kind": "text"
        },
        {
          "text": "also",
          "kind": "supplied"
        },
        {
          "text": ", and he praiseth her.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.29",
      "edition_verse_id": "WEBSTER1833:PRO.31.29",
      "verse": 29,
      "spans": [
        {
          "text": "Many daughters have done virtuously, but thou excellest them all.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.30",
      "edition_verse_id": "WEBSTER1833:PRO.31.30",
      "verse": 30,
      "spans": [
        {
          "text": "Favor ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " deceitful, and beauty ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " vain: ",
          "kind": "text"
        },
        {
          "text": "but",
          "kind": "supplied"
        },
        {
          "text": " a woman ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " feareth the LORD, she shall be praised.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.31.31",
      "edition_verse_id": "WEBSTER1833:PRO.31.31",
      "verse": 31,
      "spans": [
        {
          "text": "Give her of the fruit of her hands; and let her own works praise her in the gates.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
