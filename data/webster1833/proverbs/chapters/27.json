{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 27,
  "verses": [
    {
      "id": "PRO.27.1",
      "edition_verse_id": "WEBSTER1833:PRO.27.1",
      "verse": 1,
      "spans": [
        {
          "text": "Boast not thyself of to-morrow; for thou knowest not what a day may bring forth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.27.2",
      "edition_verse_id": "WEBSTER1833:PRO.27.2",
      "verse": 2,
      "spans": [
        {
          "text": "Let another man praise thee, and not thy own mouth; a stranger, and not thy own lips.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.3",
      "edition_verse_id": "WEBSTER1833:PRO.27.3",
      "verse": 3,
      "spans": [
        {
          "text": "A stone ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " heavy, and the sand weighty; but a fool's wrath ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " heavier than both.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.4",
      "edition_verse_id": "WEBSTER1833:PRO.27.4",
      "verse": 4,
      "spans": [
        {
          "text": "Wrath ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " cruel, and anger ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " outrageous; but who ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " able to stand before envy?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.5",
      "edition_verse_id": "WEBSTER1833:PRO.27.5",
      "verse": 5,
      "spans": [
        {
          "text": "Open rebuke ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " better than secret love.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.6",
      "edition_verse_id": "WEBSTER1833:PRO.27.6",
      "verse": 6,
      "spans": [
        {
          "text": "Faithful ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the wounds of a friend; but the kisses of an enemy ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " deceitful.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.7",
      "edition_verse_id": "WEBSTER1833:PRO.27.7",
      "verse": 7,
      "spans": [
        {
          "text": "The full soul lotheth a honey-comb; but to the hungry soul every bitter thing is sweet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.8",
      "edition_verse_id": "WEBSTER1833:PRO.27.8",
      "verse": 8,
      "spans": [
        {
          "text": "As a bird that wandereth from her nest, so ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a man that wandereth from his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.9",
      "edition_verse_id": "WEBSTER1833:PRO.27.9",
      "verse": 9,
      "spans": [
        {
          "text": "Ointment and perfume rejoice the heart: so ",
          "kind": "text"
        },
        {
          "text": "doth",
          "kind": "supplied"
        },
        {
          "text": " the sweetness of a man's friend by hearty counsel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.10",
      "edition_verse_id": "WEBSTER1833:PRO.27.10",
      "verse": 10,
      "spans": [
        {
          "text": "Thy own friend, and thy father's friend, forsake not; neither go into thy brother's house in the day of thy calamity: ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " better ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a neighbor ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": " near, than a brother far off.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.11",
      "edition_verse_id": "WEBSTER1833:PRO.27.11",
      "verse": 11,
      "spans": [
        {
          "text": "My son, be wise, and make my heart glad, that I may answer him that reproacheth me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.12",
      "edition_verse_id": "WEBSTER1833:PRO.27.12",
      "verse": 12,
      "spans": [
        {
          "text": "A prudent ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": " foreseeth the evil, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " hideth himself; ",
          "kind": "text"
        },
        {
          "text": "but",
          "kind": "supplied"
        },
        {
          "text": " the simple pass on, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " are punished.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.13",
      "edition_verse_id": "WEBSTER1833:PRO.27.13",
      "verse": 13,
      "spans": [
        {
          "text": "Take his garment that is surety for a stranger, and take a pledge of him for a strange woman.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.14",
      "edition_verse_id": "WEBSTER1833:PRO.27.14",
      "verse": 14,
      "spans": [
        {
          "text": "He that blesseth his friend with a loud voice, rising early in the morning, it shall be counted a curse to him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.15",
      "edition_verse_id": "WEBSTER1833:PRO.27.15",
      "verse": 15,
      "spans": [
        {
          "text": "A continual dropping in a very rainy day and a contentious woman are alike.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.16",
      "edition_verse_id": "WEBSTER1833:PRO.27.16",
      "verse": 16,
      "spans": [
        {
          "text": "Whoever hideth her hideth the wind, and the ointment of his right hand ",
          "kind": "text"
        },
        {
          "text": "which",
          "kind": "supplied"
        },
        {
          "text": " bewrayeth ",
          "kind": "text"
        },
        {
          "text": "itself",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.17",
      "edition_verse_id": "WEBSTER1833:PRO.27.17",
      "verse": 17,
      "spans": [
        {
          "text": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.18",
      "edition_verse_id": "WEBSTER1833:PRO.27.18",
      "verse": 18,
      "spans": [
        {
          "text": "He that keepeth the fig-tree shall eat the fruit of it: so he that waiteth on his master shall be honored.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.19",
      "edition_verse_id": "WEBSTER1833:PRO.27.19",
      "verse": 19,
      "spans": [
        {
          "text": "As in water face ",
          "kind": "text"
        },
        {
          "text": "answereth",
          "kind": "supplied"
        },
        {
          "text": " to face, so the heart of man to man.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.20",
      "edition_verse_id": "WEBSTER1833:PRO.27.20",
      "verse": 20,
      "spans": [
        {
          "text": "Hell and destruction are never full; so the eyes of man are never satisfied.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.21",
      "edition_verse_id": "WEBSTER1833:PRO.27.21",
      "verse": 21,
      "spans": [
        {
          "text": "As",
          "kind": "supplied"
        },
        {
          "text": " the fining-pot for silver, and the furnace for gold; so ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a man to his praise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.22",
      "edition_verse_id": "WEBSTER1833:PRO.27.22",
      "verse": 22,
      "spans": [
        {
          "text": "Though thou shouldst bray a fool in a mortar among wheat with a pestle, ",
          "kind": "text"
        },
        {
          "text": "yet",
          "kind": "supplied"
        },
        {
          "text": " his foolishness will not depart from him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.23",
      "edition_verse_id": "WEBSTER1833:PRO.27.23",
      "verse": 23,
      "spans": [
        {
          "text": "Be thou diligent to know the state of thy flocks, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " look well to thy herds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.24",
      "edition_verse_id": "WEBSTER1833:PRO.27.24",
      "verse": 24,
      "spans": [
        {
          "text": "For riches ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " not for ever: and doth the crown ",
          "kind": "text"
        },
        {
          "text": "endure",
          "kind": "supplied"
        },
        {
          "text": " to every generation?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.25",
      "edition_verse_id": "WEBSTER1833:PRO.27.25",
      "verse": 25,
      "spans": [
        {
          "text": "The plant appeareth, and the tender grass showeth itself, and herbs of the mountains are gathered.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.26",
      "edition_verse_id": "WEBSTER1833:PRO.27.26",
      "verse": 26,
      "spans": [
        {
          "text": "The lambs ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " for thy clothing, and the goats ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the price of the field.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.27.27",
      "edition_verse_id": "WEBSTER1833:PRO.27.27",
      "verse": 27,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "thou shalt have",
          "kind": "supplied"
        },
        {
          "text": " goats milk enough for thy food, for the food of thy household, and ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " maintenance for thy maidens.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
