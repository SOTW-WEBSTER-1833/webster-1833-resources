{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 22,
  "verses": [
    {
      "id": "PRO.22.1",
      "edition_verse_id": "WEBSTER1833:PRO.22.1",
      "verse": 1,
      "spans": [
        {
          "text": "A ",
          "kind": "text"
        },
        {
          "text": "good",
          "kind": "supplied"
        },
        {
          "text": " name ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " rather to be chosen than great riches, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " loving favor rather than silver and gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.22.2",
      "edition_verse_id": "WEBSTER1833:PRO.22.2",
      "verse": 2,
      "spans": [
        {
          "text": "The rich and poor meet together: the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the maker of them all.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.3",
      "edition_verse_id": "WEBSTER1833:PRO.22.3",
      "verse": 3,
      "spans": [
        {
          "text": "A prudent ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": " foreseeth the evil, and hideth himself: but the simple pass on, and are punished.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.4",
      "edition_verse_id": "WEBSTER1833:PRO.22.4",
      "verse": 4,
      "spans": [
        {
          "text": "By humility ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " the fear of the LORD ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " riches, and honor, and life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.5",
      "edition_verse_id": "WEBSTER1833:PRO.22.5",
      "verse": 5,
      "spans": [
        {
          "text": "Thorns ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " snares ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " in the way of the froward: he that doth keep his soul shall be far from them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.6",
      "edition_verse_id": "WEBSTER1833:PRO.22.6",
      "verse": 6,
      "spans": [
        {
          "text": "Train up a child in the way he should go: and when he is old, he will not depart from it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.7",
      "edition_verse_id": "WEBSTER1833:PRO.22.7",
      "verse": 7,
      "spans": [
        {
          "text": "The rich ruleth over the poor, and the borrower ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " servant to the lender.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.8",
      "edition_verse_id": "WEBSTER1833:PRO.22.8",
      "verse": 8,
      "spans": [
        {
          "text": "He that soweth iniquity shall reap vanity: and the rod of his anger shall fail.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.9",
      "edition_verse_id": "WEBSTER1833:PRO.22.9",
      "verse": 9,
      "spans": [
        {
          "text": "He that hath a bountiful eye shall be blessed; for he giveth of his bread to the poor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.10",
      "edition_verse_id": "WEBSTER1833:PRO.22.10",
      "verse": 10,
      "spans": [
        {
          "text": "Cast out the scorner, and contention shall end; yes, strife and reproach shall cease.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.11",
      "edition_verse_id": "WEBSTER1833:PRO.22.11",
      "verse": 11,
      "spans": [
        {
          "text": "He that loveth pureness of heart, ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " the grace of his lips the king ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " his friend.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.12",
      "edition_verse_id": "WEBSTER1833:PRO.22.12",
      "verse": 12,
      "spans": [
        {
          "text": "The eyes of the LORD preserve knowledge, and he overthroweth the words of the transgressor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.13",
      "edition_verse_id": "WEBSTER1833:PRO.22.13",
      "verse": 13,
      "spans": [
        {
          "text": "The slothful ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": " saith, ",
          "kind": "text"
        },
        {
          "text": "There is",
          "kind": "supplied"
        },
        {
          "text": " a lion without, I shall be slain in the streets.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.14",
      "edition_verse_id": "WEBSTER1833:PRO.22.14",
      "verse": 14,
      "spans": [
        {
          "text": "The mouth of strange women ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a deep pit: he that is abhorred by the LORD shall fall therein.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.15",
      "edition_verse_id": "WEBSTER1833:PRO.22.15",
      "verse": 15,
      "spans": [
        {
          "text": "Foolishness ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " bound in the heart of a child; ",
          "kind": "text"
        },
        {
          "text": "but",
          "kind": "supplied"
        },
        {
          "text": " the rod of correction shall drive it far from him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.16",
      "edition_verse_id": "WEBSTER1833:PRO.22.16",
      "verse": 16,
      "spans": [
        {
          "text": "He that oppresseth the poor to increase his ",
          "kind": "text"
        },
        {
          "text": "riches",
          "kind": "supplied"
        },
        {
          "text": ", ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " he that giveth to the rich, ",
          "kind": "text"
        },
        {
          "text": "shall",
          "kind": "supplied"
        },
        {
          "text": " surely ",
          "kind": "text"
        },
        {
          "text": "come",
          "kind": "supplied"
        },
        {
          "text": " to want.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.17",
      "edition_verse_id": "WEBSTER1833:PRO.22.17",
      "verse": 17,
      "spans": [
        {
          "text": "Bow down thy ear, and hear the words of the wise, and apply thy heart to my knowledge.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.18",
      "edition_verse_id": "WEBSTER1833:PRO.22.18",
      "verse": 18,
      "spans": [
        {
          "text": "For ",
          "kind": "text"
        },
        {
          "text": "it is",
          "kind": "supplied"
        },
        {
          "text": " a pleasant thing if thou keepest them within thee; they shall withal be fitted in thy lips.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.19",
      "edition_verse_id": "WEBSTER1833:PRO.22.19",
      "verse": 19,
      "spans": [
        {
          "text": "That thy trust may be in the LORD, I have made known to thee this day, even to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.20",
      "edition_verse_id": "WEBSTER1833:PRO.22.20",
      "verse": 20,
      "spans": [
        {
          "text": "Have not I written to thee excellent things in counsels and knowledge,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.21",
      "edition_verse_id": "WEBSTER1833:PRO.22.21",
      "verse": 21,
      "spans": [
        {
          "text": "That I might make thee know the certainty of the words of truth; that thou mightest answer the words of truth to them that send to thee?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.22",
      "edition_verse_id": "WEBSTER1833:PRO.22.22",
      "verse": 22,
      "spans": [
        {
          "text": "Rob not the poor, because he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " poor: neither oppress the afflicted in the gate:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.23",
      "edition_verse_id": "WEBSTER1833:PRO.22.23",
      "verse": 23,
      "spans": [
        {
          "text": "For the LORD will plead their cause, and spoil the soul of those that spoiled them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.24",
      "edition_verse_id": "WEBSTER1833:PRO.22.24",
      "verse": 24,
      "spans": [
        {
          "text": "Make no friendship with an angry man; and with a furious man thou shalt not go:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.25",
      "edition_verse_id": "WEBSTER1833:PRO.22.25",
      "verse": 25,
      "spans": [
        {
          "text": "Lest thou learn his ways, and get a snare to thy soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.26",
      "edition_verse_id": "WEBSTER1833:PRO.22.26",
      "verse": 26,
      "spans": [
        {
          "text": "Be not thou ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " of them that strike hands, ",
          "kind": "text"
        },
        {
          "text": "or",
          "kind": "supplied"
        },
        {
          "text": " of them that are sureties for debts.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.27",
      "edition_verse_id": "WEBSTER1833:PRO.22.27",
      "verse": 27,
      "spans": [
        {
          "text": "If thou hast nothing to pay, why should he take away thy bed from under thee?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.28",
      "edition_verse_id": "WEBSTER1833:PRO.22.28",
      "verse": 28,
      "spans": [
        {
          "text": "Remove not the ancient landmark, which thy fathers have set.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.22.29",
      "edition_verse_id": "WEBSTER1833:PRO.22.29",
      "verse": 29,
      "spans": [
        {
          "text": "Seest thou a man diligent in his business? he shall stand before kings; he shall not stand before mean ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
