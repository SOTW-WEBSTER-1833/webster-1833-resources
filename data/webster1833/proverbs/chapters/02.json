{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 2,
  "verses": [
    {
      "id": "PRO.2.1",
      "edition_verse_id": "WEBSTER1833:PRO.2.1",
      "verse": 1,
      "spans": [
        {
          "text": "My son, if thou wilt receive my words, and hide my commandments with thee;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.2.2",
      "edition_verse_id": "WEBSTER1833:PRO.2.2",
      "verse": 2,
      "spans": [
        {
          "text": "So that thou incline thy ear to wisdom, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " apply thy heart to understanding;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.3",
      "edition_verse_id": "WEBSTER1833:PRO.2.3",
      "verse": 3,
      "spans": [
        {
          "text": "Yes, if thou criest after knowledge, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " liftest up thy voice for understanding;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.4",
      "edition_verse_id": "WEBSTER1833:PRO.2.4",
      "verse": 4,
      "spans": [
        {
          "text": "If thou seekest her as silver, and searchest for her as ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " hid treasures;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.5",
      "edition_verse_id": "WEBSTER1833:PRO.2.5",
      "verse": 5,
      "spans": [
        {
          "text": "Then shalt thou understand the fear of the LORD, and find the knowledge of God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.6",
      "edition_verse_id": "WEBSTER1833:PRO.2.6",
      "verse": 6,
      "spans": [
        {
          "text": "For the LORD giveth wisdom: out of his mouth ",
          "kind": "text"
        },
        {
          "text": "cometh",
          "kind": "supplied"
        },
        {
          "text": " knowledge and understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.7",
      "edition_verse_id": "WEBSTER1833:PRO.2.7",
      "verse": 7,
      "spans": [
        {
          "text": "He layeth up sound wisdom for the righteous: ",
          "kind": "text"
        },
        {
          "text": "he is",
          "kind": "supplied"
        },
        {
          "text": " a buckler to them that walk uprightly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.8",
      "edition_verse_id": "WEBSTER1833:PRO.2.8",
      "verse": 8,
      "spans": [
        {
          "text": "He keepeth the paths of judgment, and preserveth the way of his saints.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.9",
      "edition_verse_id": "WEBSTER1833:PRO.2.9",
      "verse": 9,
      "spans": [
        {
          "text": "Then shalt thou understand righteousness, and judgment, and equity; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " every good path.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.10",
      "edition_verse_id": "WEBSTER1833:PRO.2.10",
      "verse": 10,
      "spans": [
        {
          "text": "When wisdom entereth into thy heart, and knowledge is pleasant to thy soul;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.11",
      "edition_verse_id": "WEBSTER1833:PRO.2.11",
      "verse": 11,
      "spans": [
        {
          "text": "Discretion shall preserve thee, understanding shall keep thee:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.12",
      "edition_verse_id": "WEBSTER1833:PRO.2.12",
      "verse": 12,
      "spans": [
        {
          "text": "To deliver thee from the way of the evil ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": ", from the man that speaketh froward things;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.13",
      "edition_verse_id": "WEBSTER1833:PRO.2.13",
      "verse": 13,
      "spans": [
        {
          "text": "Who leave the paths of uprightness, to walk in the ways of darkness;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.14",
      "edition_verse_id": "WEBSTER1833:PRO.2.14",
      "verse": 14,
      "spans": [
        {
          "text": "Who rejoice to do evil, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " delight in the frowardness of the wicked;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.15",
      "edition_verse_id": "WEBSTER1833:PRO.2.15",
      "verse": 15,
      "spans": [
        {
          "text": "Whose ways ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " crooked, and ",
          "kind": "text"
        },
        {
          "text": "they",
          "kind": "supplied"
        },
        {
          "text": " froward in their paths:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.16",
      "edition_verse_id": "WEBSTER1833:PRO.2.16",
      "verse": 16,
      "spans": [
        {
          "text": "To deliver thee from the strange woman, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " from the stranger ",
          "kind": "text"
        },
        {
          "text": "who",
          "kind": "supplied"
        },
        {
          "text": " flattereth with her words;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.17",
      "edition_verse_id": "WEBSTER1833:PRO.2.17",
      "verse": 17,
      "spans": [
        {
          "text": "Who forsaketh the guide of her youth, and forgetteth the covenant of her God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.18",
      "edition_verse_id": "WEBSTER1833:PRO.2.18",
      "verse": 18,
      "spans": [
        {
          "text": "For her house inclineth to death, and her paths to the dead.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.19",
      "edition_verse_id": "WEBSTER1833:PRO.2.19",
      "verse": 19,
      "spans": [
        {
          "text": "None that go to her return again, neither do they take hold of the paths of life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.20",
      "edition_verse_id": "WEBSTER1833:PRO.2.20",
      "verse": 20,
      "spans": [
        {
          "text": "That thou mayest walk in the way of good ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": ", and keep the paths of the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.21",
      "edition_verse_id": "WEBSTER1833:PRO.2.21",
      "verse": 21,
      "spans": [
        {
          "text": "For the upright shall dwell in the land, and the perfect shall remain in it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.2.22",
      "edition_verse_id": "WEBSTER1833:PRO.2.22",
      "verse": 22,
      "spans": [
        {
          "text": "But the wicked shall be cut off from the earth, and the transgressors shall be rooted out of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
