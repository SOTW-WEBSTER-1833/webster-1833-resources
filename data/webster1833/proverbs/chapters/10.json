{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 10,
  "verses": [
    {
      "id": "PRO.10.1",
      "edition_verse_id": "WEBSTER1833:PRO.10.1",
      "verse": 1,
      "spans": [
        {
          "text": "The proverbs of Solomon. A wise son maketh a glad father: but a foolish son ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the heaviness of his mother.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.10.2",
      "edition_verse_id": "WEBSTER1833:PRO.10.2",
      "verse": 2,
      "spans": [
        {
          "text": "Treasures of wickedness profit nothing: but righteousness delivereth from death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.3",
      "edition_verse_id": "WEBSTER1833:PRO.10.3",
      "verse": 3,
      "spans": [
        {
          "text": "The LORD will not suffer the soul of the righteous to famish: but he casteth away the substance of the wicked.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.4",
      "edition_verse_id": "WEBSTER1833:PRO.10.4",
      "verse": 4,
      "spans": [
        {
          "text": "He becometh poor that dealeth ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " a slack hand: but the hand of the diligent maketh rich.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.5",
      "edition_verse_id": "WEBSTER1833:PRO.10.5",
      "verse": 5,
      "spans": [
        {
          "text": "He that gathereth in summer ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a wise son: ",
          "kind": "text"
        },
        {
          "text": "but",
          "kind": "supplied"
        },
        {
          "text": " he that sleepeth in harvest ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a son that causeth shame.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.6",
      "edition_verse_id": "WEBSTER1833:PRO.10.6",
      "verse": 6,
      "spans": [
        {
          "text": "Blessings ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " upon the head of the just: but violence covereth the mouth of the wicked.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.7",
      "edition_verse_id": "WEBSTER1833:PRO.10.7",
      "verse": 7,
      "spans": [
        {
          "text": "The memory of the just ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " blessed: but the name of the wicked shall perish.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.8",
      "edition_verse_id": "WEBSTER1833:PRO.10.8",
      "verse": 8,
      "spans": [
        {
          "text": "The wise in heart will receive commandments: but a prating fool shall fall.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.9",
      "edition_verse_id": "WEBSTER1833:PRO.10.9",
      "verse": 9,
      "spans": [
        {
          "text": "He that walketh uprightly walketh surely: but he that perverteth his ways shall be known.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.10",
      "edition_verse_id": "WEBSTER1833:PRO.10.10",
      "verse": 10,
      "spans": [
        {
          "text": "He that winketh with the eye causeth sorrow: but a prating fool shall fall.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.11",
      "edition_verse_id": "WEBSTER1833:PRO.10.11",
      "verse": 11,
      "spans": [
        {
          "text": "The mouth of a righteous ",
          "kind": "text"
        },
        {
          "text": "man is",
          "kind": "supplied"
        },
        {
          "text": " a well of life: but violence covereth the mouth of the wicked.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.12",
      "edition_verse_id": "WEBSTER1833:PRO.10.12",
      "verse": 12,
      "spans": [
        {
          "text": "Hatred stirreth up strifes: but love covereth all sins.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.13",
      "edition_verse_id": "WEBSTER1833:PRO.10.13",
      "verse": 13,
      "spans": [
        {
          "text": "In the lips of him that hath understanding wisdom is found: but a rod ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " for the back of him that is void of understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.14",
      "edition_verse_id": "WEBSTER1833:PRO.10.14",
      "verse": 14,
      "spans": [
        {
          "text": "Wise ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": " lay up knowledge: but the mouth of the foolish ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " near destruction.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.15",
      "edition_verse_id": "WEBSTER1833:PRO.10.15",
      "verse": 15,
      "spans": [
        {
          "text": "The rich man's wealth ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " his strong city: the destruction of the poor ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " their poverty.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.16",
      "edition_verse_id": "WEBSTER1833:PRO.10.16",
      "verse": 16,
      "spans": [
        {
          "text": "The labor of the righteous ",
          "kind": "text"
        },
        {
          "text": "tendeth",
          "kind": "supplied"
        },
        {
          "text": " to life: the fruit of the wicked to sin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.17",
      "edition_verse_id": "WEBSTER1833:PRO.10.17",
      "verse": 17,
      "spans": [
        {
          "text": "He ",
          "kind": "text"
        },
        {
          "text": "is in",
          "kind": "supplied"
        },
        {
          "text": " the way of life that keepeth instruction: but he that refuseth reproof erreth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.18",
      "edition_verse_id": "WEBSTER1833:PRO.10.18",
      "verse": 18,
      "spans": [
        {
          "text": "He that hideth hatred ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " lying lips, and he that uttereth a slander, ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a fool.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.19",
      "edition_verse_id": "WEBSTER1833:PRO.10.19",
      "verse": 19,
      "spans": [
        {
          "text": "In the multitude of words there wanteth not sin: but he that restraineth his lips ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " wise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.20",
      "edition_verse_id": "WEBSTER1833:PRO.10.20",
      "verse": 20,
      "spans": [
        {
          "text": "The tongue of the just ",
          "kind": "text"
        },
        {
          "text": "is as",
          "kind": "supplied"
        },
        {
          "text": " choice silver: the heart of the wicked ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " little worth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.21",
      "edition_verse_id": "WEBSTER1833:PRO.10.21",
      "verse": 21,
      "spans": [
        {
          "text": "The lips of the righteous feed many: but fools die for want of wisdom.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.22",
      "edition_verse_id": "WEBSTER1833:PRO.10.22",
      "verse": 22,
      "spans": [
        {
          "text": "The blessing of the LORD, it maketh rich, and he addeth no sorrow with it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.23",
      "edition_verse_id": "WEBSTER1833:PRO.10.23",
      "verse": 23,
      "spans": [
        {
          "text": "It is",
          "kind": "supplied"
        },
        {
          "text": " as sport to a fool to do mischief: but a man of understanding hath wisdom.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.24",
      "edition_verse_id": "WEBSTER1833:PRO.10.24",
      "verse": 24,
      "spans": [
        {
          "text": "The fear of the wicked, it shall come upon him: but the desire of the righteous shall be granted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.25",
      "edition_verse_id": "WEBSTER1833:PRO.10.25",
      "verse": 25,
      "spans": [
        {
          "text": "As the whirlwind passeth, so ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the wicked no ",
          "kind": "text"
        },
        {
          "text": "more",
          "kind": "supplied"
        },
        {
          "text": ": but the righteous ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " an everlasting foundation.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.26",
      "edition_verse_id": "WEBSTER1833:PRO.10.26",
      "verse": 26,
      "spans": [
        {
          "text": "As vinegar to the teeth, and as smoke to the eyes, so ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the sluggard to them that send him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.27",
      "edition_verse_id": "WEBSTER1833:PRO.10.27",
      "verse": 27,
      "spans": [
        {
          "text": "The fear of the LORD prolongeth days: but the years of the wicked shall be shortened.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.28",
      "edition_verse_id": "WEBSTER1833:PRO.10.28",
      "verse": 28,
      "spans": [
        {
          "text": "The hope of the righteous ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " gladness: but the expectation of the wicked shall perish.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.29",
      "edition_verse_id": "WEBSTER1833:PRO.10.29",
      "verse": 29,
      "spans": [
        {
          "text": "The way of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " strength to the upright: but destruction ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " to the workers of iniquity.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.30",
      "edition_verse_id": "WEBSTER1833:PRO.10.30",
      "verse": 30,
      "spans": [
        {
          "text": "The righteous shall never be removed: but the wicked shall not inhabit the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.31",
      "edition_verse_id": "WEBSTER1833:PRO.10.31",
      "verse": 31,
      "spans": [
        {
          "text": "The mouth of the just bringeth forth wisdom: but the froward tongue shall be cut out.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.10.32",
      "edition_verse_id": "WEBSTER1833:PRO.10.32",
      "verse": 32,
      "spans": [
        {
          "text": "The lips of the righteous know what is acceptable: but the mouth of the wicked ",
          "kind": "text"
        },
        {
          "text": "speaketh",
          "kind": "supplied"
        },
        {
          "text": " frowardness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
