{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 6,
  "verses": [
    {
      "id": "PRO.6.1",
      "edition_verse_id": "WEBSTER1833:PRO.6.1",
      "verse": 1,
      "spans": [
        {
          "text": "My son, if thou art surety for thy friend, ",
          "kind": "text"
        },
        {
          "text": "if",
          "kind": "supplied"
        },
        {
          "text": " thou hast stricken thy hand with a stranger,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.6.2",
      "edition_verse_id": "WEBSTER1833:PRO.6.2",
      "verse": 2,
      "spans": [
        {
          "text": "Thou art snared with the words of thy mouth, thou art taken with the words of thy mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.3",
      "edition_verse_id": "WEBSTER1833:PRO.6.3",
      "verse": 3,
      "spans": [
        {
          "text": "Do this now, my son, and deliver thyself, when thou art come into the hand of thy friend; go, humble thyself, and make sure thy friend.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.4",
      "edition_verse_id": "WEBSTER1833:PRO.6.4",
      "verse": 4,
      "spans": [
        {
          "text": "Give not sleep to thy eyes, nor slumber to thy eyelids.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.5",
      "edition_verse_id": "WEBSTER1833:PRO.6.5",
      "verse": 5,
      "spans": [
        {
          "text": "Deliver thyself as a roe from the hand ",
          "kind": "text"
        },
        {
          "text": "of the hunter",
          "kind": "supplied"
        },
        {
          "text": ", and as a bird from the hand of the fowler.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.6",
      "edition_verse_id": "WEBSTER1833:PRO.6.6",
      "verse": 6,
      "spans": [
        {
          "text": "Go to the ant, thou sluggard; consider her ways, and be wise:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.7",
      "edition_verse_id": "WEBSTER1833:PRO.6.7",
      "verse": 7,
      "spans": [
        {
          "text": "Which having no guide, overseer, or ruler,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.8",
      "edition_verse_id": "WEBSTER1833:PRO.6.8",
      "verse": 8,
      "spans": [
        {
          "text": "Provideth her provisions in the summer, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " gathereth her food in the harvest.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.9",
      "edition_verse_id": "WEBSTER1833:PRO.6.9",
      "verse": 9,
      "spans": [
        {
          "text": "How long wilt thou sleep, O sluggard? when wilt thou arise out of thy sleep?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.10",
      "edition_verse_id": "WEBSTER1833:PRO.6.10",
      "verse": 10,
      "spans": [
        {
          "text": "Yet",
          "kind": "supplied"
        },
        {
          "text": " a little sleep, a little slumber, a little folding of the hands to sleep:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.11",
      "edition_verse_id": "WEBSTER1833:PRO.6.11",
      "verse": 11,
      "spans": [
        {
          "text": "So shall thy poverty come as one that traveleth, and thy want as an armed man.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.12",
      "edition_verse_id": "WEBSTER1833:PRO.6.12",
      "verse": 12,
      "spans": [
        {
          "text": "A naughty person, a wicked man, walketh with a froward mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.13",
      "edition_verse_id": "WEBSTER1833:PRO.6.13",
      "verse": 13,
      "spans": [
        {
          "text": "He winketh with his eyes, he speaketh with his feet, he teacheth with his fingers;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.14",
      "edition_verse_id": "WEBSTER1833:PRO.6.14",
      "verse": 14,
      "spans": [
        {
          "text": "Frowardness ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in his heart, he deviseth mischief continually; he soweth discord.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.15",
      "edition_verse_id": "WEBSTER1833:PRO.6.15",
      "verse": 15,
      "spans": [
        {
          "text": "Therefore shall his calamity come suddenly; suddenly shall he be broken without remedy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.16",
      "edition_verse_id": "WEBSTER1833:PRO.6.16",
      "verse": 16,
      "spans": [
        {
          "text": "These six ",
          "kind": "text"
        },
        {
          "text": "things",
          "kind": "supplied"
        },
        {
          "text": " doth the LORD hate: yes, seven ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " an abomination to him:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.17",
      "edition_verse_id": "WEBSTER1833:PRO.6.17",
      "verse": 17,
      "spans": [
        {
          "text": "A proud look, a lying tongue, and hands that shed innocent blood.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.18",
      "edition_verse_id": "WEBSTER1833:PRO.6.18",
      "verse": 18,
      "spans": [
        {
          "text": "A heart that deviseth wicked imaginations, feet that are swift in running to mischief,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.19",
      "edition_verse_id": "WEBSTER1833:PRO.6.19",
      "verse": 19,
      "spans": [
        {
          "text": "A false witness ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " speaketh lies, and him that soweth discord among brethren.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.20",
      "edition_verse_id": "WEBSTER1833:PRO.6.20",
      "verse": 20,
      "spans": [
        {
          "text": "My son, keep thy father's commandment, and forsake not the law of thy mother:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.21",
      "edition_verse_id": "WEBSTER1833:PRO.6.21",
      "verse": 21,
      "spans": [
        {
          "text": "Bind them continually upon thy heart, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " tie them about thy neck.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.22",
      "edition_verse_id": "WEBSTER1833:PRO.6.22",
      "verse": 22,
      "spans": [
        {
          "text": "When thou goest, it shall lead thee; when thou sleepest, it shall keep thee; and ",
          "kind": "text"
        },
        {
          "text": "when",
          "kind": "supplied"
        },
        {
          "text": " thou awakest, it shall talk with thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.23",
      "edition_verse_id": "WEBSTER1833:PRO.6.23",
      "verse": 23,
      "spans": [
        {
          "text": "For the commandment ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a lamp; and the law ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " light; and reproofs of instruction ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the way of life:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.24",
      "edition_verse_id": "WEBSTER1833:PRO.6.24",
      "verse": 24,
      "spans": [
        {
          "text": "To keep thee from the evil woman, from the flattery of the tongue of a strange woman.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.25",
      "edition_verse_id": "WEBSTER1833:PRO.6.25",
      "verse": 25,
      "spans": [
        {
          "text": "Lust not after her beauty in thy heart; neither let her take thee with her eyelids.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.26",
      "edition_verse_id": "WEBSTER1833:PRO.6.26",
      "verse": 26,
      "spans": [
        {
          "text": "For by means of a lewd woman ",
          "kind": "text"
        },
        {
          "text": "a man is brought",
          "kind": "supplied"
        },
        {
          "text": " to a piece of bread: and the adulteress will hunt for the precious life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.27",
      "edition_verse_id": "WEBSTER1833:PRO.6.27",
      "verse": 27,
      "spans": [
        {
          "text": "Can a man take fire in his bosom, and his clothes not be burned?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.28",
      "edition_verse_id": "WEBSTER1833:PRO.6.28",
      "verse": 28,
      "spans": [
        {
          "text": "Can one go upon hot coals, and his feet not be burned?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.29",
      "edition_verse_id": "WEBSTER1833:PRO.6.29",
      "verse": 29,
      "spans": [
        {
          "text": "So he that goeth in to his neighbor's wife; whoever toucheth her shall not be innocent.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.30",
      "edition_verse_id": "WEBSTER1833:PRO.6.30",
      "verse": 30,
      "spans": [
        {
          "text": "Men",
          "kind": "supplied"
        },
        {
          "text": " do not despise a thief, if he stealeth to satisfy his soul when he is hungry;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.31",
      "edition_verse_id": "WEBSTER1833:PRO.6.31",
      "verse": 31,
      "spans": [
        {
          "text": "But ",
          "kind": "text"
        },
        {
          "text": "if",
          "kind": "supplied"
        },
        {
          "text": " he is found, he shall restore seven-fold; he shall give all the substance of his house.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.32",
      "edition_verse_id": "WEBSTER1833:PRO.6.32",
      "verse": 32,
      "spans": [
        {
          "text": "But",
          "kind": "supplied"
        },
        {
          "text": " whoever committeth adultery with a woman lacketh understanding: he ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " doeth it destroyeth his own soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.33",
      "edition_verse_id": "WEBSTER1833:PRO.6.33",
      "verse": 33,
      "spans": [
        {
          "text": "A wound and dishonor shall he get; and his reproach shall not be wiped away.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.34",
      "edition_verse_id": "WEBSTER1833:PRO.6.34",
      "verse": 34,
      "spans": [
        {
          "text": "For jealousy ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the rage of a man: therefore he will not spare in the day of vengeance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.6.35",
      "edition_verse_id": "WEBSTER1833:PRO.6.35",
      "verse": 35,
      "spans": [
        {
          "text": "He will not regard any ransom; neither will he rest content, though thou givest many gifts.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
