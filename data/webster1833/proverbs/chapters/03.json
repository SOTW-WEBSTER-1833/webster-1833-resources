{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 3,
  "verses": [
    {
      "id": "PRO.3.1",
      "edition_verse_id": "WEBSTER1833:PRO.3.1",
      "verse": 1,
      "spans": [
        {
          "text": "My son, forget not my law; but let thy heart keep my commandments;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.3.2",
      "edition_verse_id": "WEBSTER1833:PRO.3.2",
      "verse": 2,
      "spans": [
        {
          "text": "For length of days, and long life, and peace, shall they add to thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.3",
      "edition_verse_id": "WEBSTER1833:PRO.3.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let not mercy and truth forsake thee: bind them about thy neck; write them upon the table of thy heart:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.4",
      "edition_verse_id": "WEBSTER1833:PRO.3.4",
      "verse": 4,
      "spans": [
        {
          "text": "So shalt thou find favor and good understanding in the sight of God and man.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.5",
      "edition_verse_id": "WEBSTER1833:PRO.3.5",
      "verse": 5,
      "spans": [
        {
          "text": "Trust in the LORD with all thy heart; and lean not to thy own understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.6",
      "edition_verse_id": "WEBSTER1833:PRO.3.6",
      "verse": 6,
      "spans": [
        {
          "text": "In all thy ways acknowledge him, and he will direct thy paths.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.7",
      "edition_verse_id": "WEBSTER1833:PRO.3.7",
      "verse": 7,
      "spans": [
        {
          "text": "Be not wise in thy own eyes: fear the LORD, and depart from evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.8",
      "edition_verse_id": "WEBSTER1833:PRO.3.8",
      "verse": 8,
      "spans": [
        {
          "text": "It shall be health to thy navel, and marrow to thy bones.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.9",
      "edition_verse_id": "WEBSTER1833:PRO.3.9",
      "verse": 9,
      "spans": [
        {
          "text": "Honor the LORD with thy substance, and with the first-fruits of all thy increase:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.10",
      "edition_verse_id": "WEBSTER1833:PRO.3.10",
      "verse": 10,
      "spans": [
        {
          "text": "So shall thy barns be filled with plenty, and thy presses shall burst out with new wine.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.11",
      "edition_verse_id": "WEBSTER1833:PRO.3.11",
      "verse": 11,
      "spans": [
        {
          "text": "My son, despise not the chastening of the LORD; neither be weary of his correction:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.12",
      "edition_verse_id": "WEBSTER1833:PRO.3.12",
      "verse": 12,
      "spans": [
        {
          "text": "For whom the LORD loveth he correcteth; even as a father the son ",
          "kind": "text"
        },
        {
          "text": "in whom",
          "kind": "supplied"
        },
        {
          "text": " he delighteth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.13",
      "edition_verse_id": "WEBSTER1833:PRO.3.13",
      "verse": 13,
      "spans": [
        {
          "text": "Happy ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the man ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " findeth wisdom, and the man ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " getteth understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.14",
      "edition_verse_id": "WEBSTER1833:PRO.3.14",
      "verse": 14,
      "spans": [
        {
          "text": "For the merchandise of it ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " better than the merchandise of silver, and the gain of it than fine gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.15",
      "edition_verse_id": "WEBSTER1833:PRO.3.15",
      "verse": 15,
      "spans": [
        {
          "text": "She is more precious than rubies: and all the things thou canst desire are not to be compared to her.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.16",
      "edition_verse_id": "WEBSTER1833:PRO.3.16",
      "verse": 16,
      "spans": [
        {
          "text": "Length of days ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in her right hand; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " in her left hand riches and honor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.17",
      "edition_verse_id": "WEBSTER1833:PRO.3.17",
      "verse": 17,
      "spans": [
        {
          "text": "Her ways ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " ways of pleasantness, and all her paths ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " peace.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.18",
      "edition_verse_id": "WEBSTER1833:PRO.3.18",
      "verse": 18,
      "spans": [
        {
          "text": "She ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " a tree of life to them that lay hold upon her: and happy ",
          "kind": "text"
        },
        {
          "text": "is every one",
          "kind": "supplied"
        },
        {
          "text": " that retaineth her.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.19",
      "edition_verse_id": "WEBSTER1833:PRO.3.19",
      "verse": 19,
      "spans": [
        {
          "text": "The LORD by wisdom hath founded the earth; by understanding hath he established the heavens.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.20",
      "edition_verse_id": "WEBSTER1833:PRO.3.20",
      "verse": 20,
      "spans": [
        {
          "text": "By his knowledge the depths are broken up, and the clouds drop down the dew.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.21",
      "edition_verse_id": "WEBSTER1833:PRO.3.21",
      "verse": 21,
      "spans": [
        {
          "text": "My son, let not them depart from thy eyes: keep sound wisdom and discretion:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.22",
      "edition_verse_id": "WEBSTER1833:PRO.3.22",
      "verse": 22,
      "spans": [
        {
          "text": "So shall they be life to thy soul, and grace to thy neck.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.23",
      "edition_verse_id": "WEBSTER1833:PRO.3.23",
      "verse": 23,
      "spans": [
        {
          "text": "Then shalt thou walk in thy way safely, and thy foot shall not stumble.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.24",
      "edition_verse_id": "WEBSTER1833:PRO.3.24",
      "verse": 24,
      "spans": [
        {
          "text": "When thou liest down, thou shalt not be afraid: but thou shalt lie down, and thy sleep shall be sweet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.25",
      "edition_verse_id": "WEBSTER1833:PRO.3.25",
      "verse": 25,
      "spans": [
        {
          "text": "Be not afraid of sudden fear, neither of the desolation of the wicked, when it cometh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.26",
      "edition_verse_id": "WEBSTER1833:PRO.3.26",
      "verse": 26,
      "spans": [
        {
          "text": "For the LORD will be thy confidence, and will keep thy foot from being taken.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.27",
      "edition_verse_id": "WEBSTER1833:PRO.3.27",
      "verse": 27,
      "spans": [
        {
          "text": "Withhold not good from them to whom it is due, when it is in the power of thy hand to do ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.28",
      "edition_verse_id": "WEBSTER1833:PRO.3.28",
      "verse": 28,
      "spans": [
        {
          "text": "Say not to thy neighbor, Go, and come again, and to-morrow I will give; when thou hast it by thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.29",
      "edition_verse_id": "WEBSTER1833:PRO.3.29",
      "verse": 29,
      "spans": [
        {
          "text": "Devise not evil against thy neighbor, seeing he dwelleth securely by thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.30",
      "edition_verse_id": "WEBSTER1833:PRO.3.30",
      "verse": 30,
      "spans": [
        {
          "text": "Strive not with a man without cause, if he hath done thee no harm.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.31",
      "edition_verse_id": "WEBSTER1833:PRO.3.31",
      "verse": 31,
      "spans": [
        {
          "text": "Envy thou not the oppressor, and choose none of his ways.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.32",
      "edition_verse_id": "WEBSTER1833:PRO.3.32",
      "verse": 32,
      "spans": [
        {
          "text": "For the froward ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " abomination to the LORD: but his secret ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " with the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.33",
      "edition_verse_id": "WEBSTER1833:PRO.3.33",
      "verse": 33,
      "spans": [
        {
          "text": "The curse of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " in the house of the wicked: but he blesseth the habitation of the just.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.34",
      "edition_verse_id": "WEBSTER1833:PRO.3.34",
      "verse": 34,
      "spans": [
        {
          "text": "Surely he scorneth the scorners: but he giveth grace to the lowly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.3.35",
      "edition_verse_id": "WEBSTER1833:PRO.3.35",
      "verse": 35,
      "spans": [
        {
          "text": "The wise shall inherit glory: but shame shall be the promotion of fools.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
