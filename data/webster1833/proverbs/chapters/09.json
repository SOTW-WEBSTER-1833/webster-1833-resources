{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "PRO",
  "chapter": 9,
  "verses": [
    {
      "id": "PRO.9.1",
      "edition_verse_id": "WEBSTER1833:PRO.9.1",
      "verse": 1,
      "spans": [
        {
          "text": "Wisdom hath built her house, she hath hewn out her seven pillars:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.9.2",
      "edition_verse_id": "WEBSTER1833:PRO.9.2",
      "verse": 2,
      "spans": [
        {
          "text": "She hath killed her beasts; she hath mingled her wine; she hath also furnished her table.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.3",
      "edition_verse_id": "WEBSTER1833:PRO.9.3",
      "verse": 3,
      "spans": [
        {
          "text": "She hath sent forth her maidens: she crieth upon the highest places of the city,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.4",
      "edition_verse_id": "WEBSTER1833:PRO.9.4",
      "verse": 4,
      "spans": [
        {
          "text": "Whoever ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " simple, let him turn in hither: ",
          "kind": "text"
        },
        {
          "text": "as for",
          "kind": "supplied"
        },
        {
          "text": " him that wanteth understanding, she saith to him,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.5",
      "edition_verse_id": "WEBSTER1833:PRO.9.5",
      "verse": 5,
      "spans": [
        {
          "text": "Come, eat of my bread, and drink of the wine ",
          "kind": "text"
        },
        {
          "text": "which",
          "kind": "supplied"
        },
        {
          "text": " I have mingled.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.6",
      "edition_verse_id": "WEBSTER1833:PRO.9.6",
      "verse": 6,
      "spans": [
        {
          "text": "Forsake the foolish, and live; and go in the way of understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.7",
      "edition_verse_id": "WEBSTER1833:PRO.9.7",
      "verse": 7,
      "spans": [
        {
          "text": "He that reproveth a scorner, getteth to himself shame: and he that rebuketh a wicked ",
          "kind": "text"
        },
        {
          "text": "man getteth",
          "kind": "supplied"
        },
        {
          "text": " himself a blot.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.8",
      "edition_verse_id": "WEBSTER1833:PRO.9.8",
      "verse": 8,
      "spans": [
        {
          "text": "Reprove not a scorner, lest he shall hate thee: rebuke a wise man, and he will love thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.9",
      "edition_verse_id": "WEBSTER1833:PRO.9.9",
      "verse": 9,
      "spans": [
        {
          "text": "Give ",
          "kind": "text"
        },
        {
          "text": "instruction",
          "kind": "supplied"
        },
        {
          "text": " to a wise ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": ", and he will be yet wiser: teach a just ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": ", and he will increase in learning.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.10",
      "edition_verse_id": "WEBSTER1833:PRO.9.10",
      "verse": 10,
      "spans": [
        {
          "text": "The fear of the LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the beginning of wisdom: and the knowledge of the holy ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.11",
      "edition_verse_id": "WEBSTER1833:PRO.9.11",
      "verse": 11,
      "spans": [
        {
          "text": "For by me thy days shall be multiplied, and the years of thy life shall be increased.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.12",
      "edition_verse_id": "WEBSTER1833:PRO.9.12",
      "verse": 12,
      "spans": [
        {
          "text": "If thou art wise, thou shalt be wise for thyself: but ",
          "kind": "text"
        },
        {
          "text": "if",
          "kind": "supplied"
        },
        {
          "text": " thou scornest, thou alone shalt bear ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.13",
      "edition_verse_id": "WEBSTER1833:PRO.9.13",
      "verse": 13,
      "spans": [
        {
          "text": "A foolish woman ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " clamorous: ",
          "kind": "text"
        },
        {
          "text": "she is",
          "kind": "supplied"
        },
        {
          "text": " simple, and knoweth nothing.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.14",
      "edition_verse_id": "WEBSTER1833:PRO.9.14",
      "verse": 14,
      "spans": [
        {
          "text": "For she sitteth at the door of her house, on a seat in the high places of the city,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.15",
      "edition_verse_id": "WEBSTER1833:PRO.9.15",
      "verse": 15,
      "spans": [
        {
          "text": "To call passengers who go right on their ways:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.16",
      "edition_verse_id": "WEBSTER1833:PRO.9.16",
      "verse": 16,
      "spans": [
        {
          "text": "Whoever ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " simple, let him turn in hither: and ",
          "kind": "text"
        },
        {
          "text": "as for",
          "kind": "supplied"
        },
        {
          "text": " him that wanteth understanding, she saith to him,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.17",
      "edition_verse_id": "WEBSTER1833:PRO.9.17",
      "verse": 17,
      "spans": [
        {
          "text": "Stolen waters are sweet, and bread ",
          "kind": "text"
        },
        {
          "text": "eaten",
          "kind": "supplied"
        },
        {
          "text": " in secret is pleasant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.9.18",
      "edition_verse_id": "WEBSTER1833:PRO.9.18",
      "verse": 18,
      "spans": [
        {
          "text": "But he knoweth not that the dead ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " there; ",
          "kind": "text"
        },
        {
          "text": "and that",
          "kind": "supplied"
        },
        {
          "text": " her guests ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " in the depths of hell.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
