{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "1CH",
  "chapter": 3,
  "verses": [
    {
      "id": "1CH.3.1",
      "edition_verse_id": "WEBSTER1833:1CH.3.1",
      "verse": 1,
      "spans": [
        {
          "text": "Now these were the sons of David, who were born to him in Hebron; the first-born Amnon, of Ahinoam the Jezreelitess; the second Daniel, of Abigail the Carmelitess:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.3.2",
      "edition_verse_id": "WEBSTER1833:1CH.3.2",
      "verse": 2,
      "spans": [
        {
          "text": "The third, Absalom the son of Maachah the daughter of Talmai king of Geshur: the fourth, Adonijah the son of Haggith:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.3",
      "edition_verse_id": "WEBSTER1833:1CH.3.3",
      "verse": 3,
      "spans": [
        {
          "text": "The fifth, Shephatiah of Abital: the sixth, Ithream by Eglah his wife.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.4",
      "edition_verse_id": "WEBSTER1833:1CH.3.4",
      "verse": 4,
      "spans": [
        {
          "text": "These",
          "kind": "supplied"
        },
        {
          "text": " six were born to him in Hebron; and there he reigned seven years and six months: and in Jerusalem he reigned thirty and three years.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.5",
      "edition_verse_id": "WEBSTER1833:1CH.3.5",
      "verse": 5,
      "spans": [
        {
          "text": "And these were born to him in Jerusalem; Shimea, and Shobab, and Nathan, and Solomon, four, of Bath-shua the daughter of Ammiel:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.6",
      "edition_verse_id": "WEBSTER1833:1CH.3.6",
      "verse": 6,
      "spans": [
        {
          "text": "Ibhar also, and Elishama, and Eliphelet,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.7",
      "edition_verse_id": "WEBSTER1833:1CH.3.7",
      "verse": 7,
      "spans": [
        {
          "text": "And Nogah, and Nepheg, and Japhia,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.8",
      "edition_verse_id": "WEBSTER1833:1CH.3.8",
      "verse": 8,
      "spans": [
        {
          "text": "And Elishama, and Eliada, and Eliphelet, nine.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.9",
      "edition_verse_id": "WEBSTER1833:1CH.3.9",
      "verse": 9,
      "spans": [
        {
          "text": "These were",
          "kind": "supplied"
        },
        {
          "text": " all the sons of David, besides the sons of the concubines, and Tamar their sister.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.10",
      "edition_verse_id": "WEBSTER1833:1CH.3.10",
      "verse": 10,
      "spans": [
        {
          "text": "And Solomon's son ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " Rehoboam, Abia his son, Asa his son, Jehoshaphat his son,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.11",
      "edition_verse_id": "WEBSTER1833:1CH.3.11",
      "verse": 11,
      "spans": [
        {
          "text": "Joram his son, Ahaziah his son, Joash his son,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.12",
      "edition_verse_id": "WEBSTER1833:1CH.3.12",
      "verse": 12,
      "spans": [
        {
          "text": "Amaziah his son, Azariah his son, Jotham his son,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.13",
      "edition_verse_id": "WEBSTER1833:1CH.3.13",
      "verse": 13,
      "spans": [
        {
          "text": "Ahaz his son, Hezekiah his son, Manasseh his son,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.14",
      "edition_verse_id": "WEBSTER1833:1CH.3.14",
      "verse": 14,
      "spans": [
        {
          "text": "Amon his son, Josiah his son.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.15",
      "edition_verse_id": "WEBSTER1833:1CH.3.15",
      "verse": 15,
      "spans": [
        {
          "text": "And the sons of Josiah ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": ", the first-born Johanan, the second Jehoiakim, the third Zedekiah, the fourth Shallum.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.16",
      "edition_verse_id": "WEBSTER1833:1CH.3.16",
      "verse": 16,
      "spans": [
        {
          "text": "And the sons of Jehoiakim; Jeconiah his son, Zedekiah his son.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.17",
      "edition_verse_id": "WEBSTER1833:1CH.3.17",
      "verse": 17,
      "spans": [
        {
          "text": "And the sons of Jeconiah; Assir, Salathiel his son.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.18",
      "edition_verse_id": "WEBSTER1833:1CH.3.18",
      "verse": 18,
      "spans": [
        {
          "text": "Malchiram also, and Pedaiah, and Shenazar, Jecamiah, Hoshama, and Nedabiah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.19",
      "edition_verse_id": "WEBSTER1833:1CH.3.19",
      "verse": 19,
      "spans": [
        {
          "text": "And the sons of Pedaiah ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": ", Zerubbabel, and Shimei: and the sons of Zerubbabel; Meshullam, and Hananiah, and Shelomith their sister:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.20",
      "edition_verse_id": "WEBSTER1833:1CH.3.20",
      "verse": 20,
      "spans": [
        {
          "text": "And Hashubah, and Ohel, and Berechiah, and Hasadiah, and Jushab-hesed, five.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.21",
      "edition_verse_id": "WEBSTER1833:1CH.3.21",
      "verse": 21,
      "spans": [
        {
          "text": "And the sons of Hananiah; Pelatiah, and Jesaiah: the sons of Rephaiah, the sons of Arnan, the sons of Obadiah, the sons of Shechaniah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.22",
      "edition_verse_id": "WEBSTER1833:1CH.3.22",
      "verse": 22,
      "spans": [
        {
          "text": "And the sons of Shechaniah; Shemaiah; and the sons of Shemaiah; Hattush, and Igeal, and Bariah, and Neariah, and Shaphat, six.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.23",
      "edition_verse_id": "WEBSTER1833:1CH.3.23",
      "verse": 23,
      "spans": [
        {
          "text": "And the sons of Neariah; Elioenai, and Hezekiah, and Azrikam, three.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.3.24",
      "edition_verse_id": "WEBSTER1833:1CH.3.24",
      "verse": 24,
      "spans": [
        {
          "text": "And the sons of Elioenai ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": ", Hodaiah, and Eliashib, and Pelaiah, and Akkub, and Johanan, and Delaiah, and Anani, seven.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
