      "edition_verse_id": "WEBSTER1833:1CH.11.35",
      "verse": 35,
      "spans": [
        {
          "text": "Ahiam the son of Sacar the Hararite, Eliphel the son of Ur,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.36",
      "edition_verse_id": "WEBSTER1833:1CH.11.36",
      "verse": 36,
      "spans": [
        {
          "text": "Hepher the Mecherathite, Ahijah the Pelonite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.37",
      "edition_verse_id": "WEBSTER1833:1CH.11.37",
      "verse": 37,
      "spans": [
        {
          "text": "Hezro the Carmelite, Naarai the son of Ezbai,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.38",
      "edition_verse_id": "WEBSTER1833:1CH.11.38",
      "verse": 38,
      "spans": [
        {
          "text": "Joel the brother of Nathan, Mibhar the son of Haggeri,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.39",
      "edition_verse_id": "WEBSTER1833:1CH.11.39",
      "verse": 39,
      "spans": [
        {
          "text": "Zelek the Ammonite, Naharai the Berothite, the armor-bearer of Joab the son of Zeruiah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.40",
      "edition_verse_id": "WEBSTER1833:1CH.11.40",
      "verse": 40,
      "spans": [
        {
          "text": "Ira the Ithrite, Gareb the Ithrite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.41",
      "edition_verse_id": "WEBSTER1833:1CH.11.41",
      "verse": 41,
      "spans": [
        {
          "text": "Uriah the Hittite, Zabad the son of Ahlai,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.42",
      "edition_verse_id": "WEBSTER1833:1CH.11.42",
      "verse": 42,
      "spans": [
        {
          "text": "Adina the son of Shiza the Reubenite, a captain of the Reubenites, and thirty with him,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.43",
      "edition_verse_id": "WEBSTER1833:1CH.11.43",
      "verse": 43,
      "spans": [
        {
          "text": "Hanan the son of Maachah, and Joshaphat the Mithnite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.44",
      "edition_verse_id": "WEBSTER1833:1CH.11.44",
      "verse": 44,
      "spans": [
        {
          "text": "Uzzia the Ashterathite, Shama and Jehiel the sons of Hothan the Aroerite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.45",
      "edition_verse_id": "WEBSTER1833:1CH.11.45",
      "verse": 45,
      "spans": [
        {
          "text": "Jediael the son of Shimri, and Joha his brother, the Tizite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.46",
      "edition_verse_id": "WEBSTER1833:1CH.11.46",
