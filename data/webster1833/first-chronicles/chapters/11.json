      "edition_verse_id": "WEBSTER1833:1CH.11.33",
      "verse": 33,
      "spans": [
        {
          "text": "Azmaveth the Baharumite, Eliahba the Shaalbonite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.11.34",
      "edition_verse_id": "WEBSTER1833:1CH.11.34",
      "verse": 34,
      "spans": [
        {
          "text": "The sons of Hashem the Gizonite, Jonathan the son of Shage the Hararite,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
