{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "ZEC",
  "chapter": 13,
  "verses": [
    {
      "id": "ZEC.13.1",
      "edition_verse_id": "WEBSTER1833:ZEC.13.1",
      "verse": 1,
      "spans": [
        {
          "text": "In that day there shall be a fountain opened to the house of David and to the inhabitants of Jerusalem for sin and for uncleanness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "ZEC.13.2",
      "edition_verse_id": "WEBSTER1833:ZEC.13.2",
      "verse": 2,
      "spans": [
        {
          "text": "And it shall come to pass in that day, saith the LORD of hosts, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " I will cut off the names of the idols out of the land, and they shall no more be remembered: and also I will cause the prophets and the unclean spirit to pass out of the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.3",
      "edition_verse_id": "WEBSTER1833:ZEC.13.3",
      "verse": 3,
      "spans": [
        {
          "text": "And it shall come to pass, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " when any shall yet prophesy, then his father and his mother that begat him shall say to him, Thou shalt not live; for thou speakest lies in the name of the LORD: and his father and his mother that begat him shall thrust him through when he prophesieth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.4",
      "edition_verse_id": "WEBSTER1833:ZEC.13.4",
      "verse": 4,
      "spans": [
        {
          "text": "And it shall come to pass in that day, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " the prophets shall be ashamed every one of his vision, when he hath prophesied; neither shall they wear a rough garment to deceive:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.5",
      "edition_verse_id": "WEBSTER1833:ZEC.13.5",
      "verse": 5,
      "spans": [
        {
          "text": "But he shall say, I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " no prophet, I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " a husbandman; for man taught me to keep cattle from my youth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.6",
      "edition_verse_id": "WEBSTER1833:ZEC.13.6",
      "verse": 6,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " shall say to him, What ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " these wounds in thy hands? Then he shall answer, ",
          "kind": "text"
        },
        {
          "text": "Those",
          "kind": "supplied"
        },
        {
          "text": " with which I was wounded ",
          "kind": "text"
        },
        {
          "text": "in",
          "kind": "supplied"
        },
        {
          "text": " the house of my friends.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.7",
      "edition_verse_id": "WEBSTER1833:ZEC.13.7",
      "verse": 7,
      "spans": [
        {
          "text": "Awake, O sword, against my shepherd, and against the man ",
          "kind": "text"
        },
        {
          "text": "that is",
          "kind": "supplied"
        },
        {
          "text": " my fellow, saith the LORD of hosts: smite the shepherd, and the sheep shall be scattered: and I will turn my hand upon the little ones.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.8",
      "edition_verse_id": "WEBSTER1833:ZEC.13.8",
      "verse": 8,
      "spans": [
        {
          "text": "And it shall come to pass, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " in all the land, saith the LORD, two parts therein shall be cut off ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " die; but the third shall be left therein.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "ZEC.13.9",
      "edition_verse_id": "WEBSTER1833:ZEC.13.9",
      "verse": 9,
      "spans": [
        {
          "text": "And I will bring the third part through the fire, and will refine them as silver is refined, and will try them as gold is tried: they shall call on my name, and I will hear them: I will say, It ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my people; and they shall say, The LORD ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
