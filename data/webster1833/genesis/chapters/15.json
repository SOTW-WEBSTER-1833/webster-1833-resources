      "edition_verse_id": "WEBSTER1833:GEN.15.18",
      "verse": 18,
      "spans": [
        {
          "text": "In that same day the LORD made a covenant with Abram, saying, To thy seed have I given this land, from the river of Egypt to the great river, the river Euphrates:",
          "kind": "text"
        }
      ],
