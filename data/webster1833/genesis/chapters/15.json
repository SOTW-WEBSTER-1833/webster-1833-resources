      "verse": 1,
      "spans": [
        {
          "text": "After these things the word of the LORD came to Abram in a vision, saying, Fear not, Abram: I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " thy shield, ",
          "kind": "text"
        },
        {
          "text": "and",
