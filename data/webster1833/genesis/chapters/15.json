      ],
      "paragraph_start": true
    },
    {
      "id": "GEN.15.2",
      "edition_verse_id": "WEBSTER1833:GEN.15.2",
      "verse": 2,
      "spans": [
        {
          "text": "And Abram said, LORD God, what wilt thou give me, seeing I go childless, and the steward of my house ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " this Eliezer of Damascus?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
