      "paragraph_start": false
    },
    {
      "id": "GEN.38.12",
      "edition_verse_id": "WEBSTER1833:GEN.38.12",
      "verse": 12,
      "spans": [
        {
          "text": "And in process of time, the daughter of Shuah Judah's wife died: and Judah was comforted, and went up to his sheep-shearers to Timnath, he and his friend Hirah the Adullamite.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
