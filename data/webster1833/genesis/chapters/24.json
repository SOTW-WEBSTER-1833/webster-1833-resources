    {
      "id": "GEN.24.2",
      "edition_verse_id": "WEBSTER1833:GEN.24.2",
      "verse": 2,
      "spans": [
        {
          "text": "And Abraham said to his eldest servant of his house, that ruled over all that he had, Put, I pray thee, thy hand under my thigh:",
          "kind": "text"
        }
