    {
      "id": "GEN.24.4",
      "edition_verse_id": "WEBSTER1833:GEN.24.4",
      "verse": 4,
      "spans": [
        {
          "text": "But thou shalt go to my country, and to my kindred, and take a wife for my son Isaac.",
          "kind": "text"
        }
