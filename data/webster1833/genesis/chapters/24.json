      "paragraph_start": false
    },
    {
      "id": "GEN.24.5",
      "edition_verse_id": "WEBSTER1833:GEN.24.5",
      "verse": 5,
      "spans": [
        {
          "text": "And the servant said to him, It may be the woman will not be willing to follow me to this land: must I needs bring thy son again to the land from whence thou camest?",
