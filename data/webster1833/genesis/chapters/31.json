        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.31.15",
      "edition_verse_id": "WEBSTER1833:GEN.31.15",
      "verse": 15,
      "spans": [
        {
          "text": "Are we not counted by him strangers; for he hath sold us, and hath quite consumed also our money.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.31.16",
      "edition_verse_id": "WEBSTER1833:GEN.31.16",
      "verse": 16,
      "spans": [
        {
          "text": "For all the riches which God hath taken from our father, that ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " ours, and our children's: now then whatever God hath said to thee, do.",
