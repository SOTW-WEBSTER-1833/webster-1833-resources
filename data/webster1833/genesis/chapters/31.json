      "edition_verse_id": "WEBSTER1833:GEN.31.12",
      "verse": 12,
      "spans": [
        {
          "text": "And he said, Lift up now thy eyes and see, all the rams which leap upon the cattle ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
