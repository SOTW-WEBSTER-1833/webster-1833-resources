    },
    {
      "id": "GEN.31.14",
      "edition_verse_id": "WEBSTER1833:GEN.31.14",
      "verse": 14,
      "spans": [
        {
          "text": "And Rachel and Leah answered, and said to him, ",
          "kind": "text"
        },
        {
          "text": "Is there",
          "kind": "supplied"
        },
        {
          "text": " yet any portion or inheritance for us in our father's house?",
