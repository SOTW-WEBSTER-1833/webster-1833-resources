      "edition_verse_id": "WEBSTER1833:GEN.31.54",
      "verse": 54,
      "spans": [
        {
          "text": "Then Jacob offered sacrifice upon the mount, and called his brethren to eat bread: and they ate bread, and tarried all night in the mount.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
