        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.31.24",
      "edition_verse_id": "WEBSTER1833:GEN.31.24",
      "verse": 24,
      "spans": [
        {
          "text": "And God came to Laban, the Syrian, in a dream by night, and said to him, Take heed that thou speak not to Jacob either good or bad.",
