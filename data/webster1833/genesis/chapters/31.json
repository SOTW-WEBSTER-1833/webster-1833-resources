      "edition_verse_id": "WEBSTER1833:GEN.31.36",
      "verse": 36,
      "spans": [
        {
          "text": "And Jacob was wroth, and chid with Laban: and Jacob answered, and said to Laban, What ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my trespass? what ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " my sin, that thou hast so eagerly pursued after me?",
