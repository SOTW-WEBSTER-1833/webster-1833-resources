      "edition_verse_id": "WEBSTER1833:GEN.31.13",
      "verse": 13,
      "spans": [
        {
          "text": "I ",
          "kind": "text"
        },
        {
          "text": "am",
          "kind": "supplied"
        },
        {
          "text": " the God of Beth-el, where thou anointedst the pillar, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
