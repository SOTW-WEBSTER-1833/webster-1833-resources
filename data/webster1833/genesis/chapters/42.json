      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.20",
      "edition_verse_id": "WEBSTER1833:GEN.42.20",
      "verse": 20,
      "spans": [
        {
          "text": "But bring your youngest brother to me; so shall your words be verified, and ye shall not die. And they did so.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.21",
      "edition_verse_id": "WEBSTER1833:GEN.42.21",
      "verse": 21,
      "spans": [
        {
          "text": "And they said one to another, We ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
