      "edition_verse_id": "WEBSTER1833:GEN.42.10",
      "verse": 10,
      "spans": [
        {
          "text": "And they said to him, No, my lord, but to buy food have thy servants come.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.11",
      "edition_verse_id": "WEBSTER1833:GEN.42.11",
