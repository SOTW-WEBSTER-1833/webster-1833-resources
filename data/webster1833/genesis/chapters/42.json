    {
      "id": "GEN.42.15",
      "edition_verse_id": "WEBSTER1833:GEN.42.15",
      "verse": 15,
      "spans": [
        {
          "text": "By this ye shall be proved: By the life of Pharaoh ye shall not go forth hence, except your youngest brother shall come hither.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.16",
      "edition_verse_id": "WEBSTER1833:GEN.42.16",
      "verse": 16,
      "spans": [
        {
          "text": "Send one of you, and let him bring your brother, and ye shall be kept in prison, that your words may be proved, whether ",
          "kind": "text"
        },
        {
          "text": "there is any",
          "kind": "supplied"
        },
        {
          "text": " truth in you: or else by the life of Pharaoh surely ye ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
