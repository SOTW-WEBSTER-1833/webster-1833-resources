      "edition_verse_id": "WEBSTER1833:GEN.42.19",
      "verse": 19,
      "spans": [
        {
          "text": "If ye ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " true ",
          "kind": "text"
        },
        {
          "text": "men",
          "kind": "supplied"
        },
        {
          "text": ", let one of your brethren be bound in the house of your prison: go ye, carry corn for the famine of your houses:",
