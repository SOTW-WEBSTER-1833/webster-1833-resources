      "edition_verse_id": "WEBSTER1833:GEN.42.38",
      "verse": 38,
      "spans": [
        {
          "text": "And he said, My son shall not go down with you; for his brother is dead, and he is left alone: if mischief shall befall him by the way in which ye go, then will ye bring down my gray hairs with sorrow to the grave.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
