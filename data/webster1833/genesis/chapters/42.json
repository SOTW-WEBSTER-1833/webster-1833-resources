      "edition_verse_id": "WEBSTER1833:GEN.42.37",
      "verse": 37,
      "spans": [
        {
          "text": "And Reuben spoke to his father, saying, Slay my two sons, if I bring him not to thee: deliver him into my hand, and I will bring him to thee again.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
