{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "GEN",
  "chapter": 42,
  "verses": [
    {
      "id": "GEN.42.1",
      "edition_verse_id": "WEBSTER1833:GEN.42.1",
      "verse": 1,
      "spans": [
        {
          "text": "Now when Jacob saw that there was corn in Egypt, Jacob said to his sons, Why do ye look one upon another?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "GEN.42.2",
      "edition_verse_id": "WEBSTER1833:GEN.42.2",
      "verse": 2,
      "spans": [
        {
          "text": "And he said, Behold, I have heard that there is corn in Egypt: go down thither, and buy for us from thence; that we may live, and not die.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.3",
      "edition_verse_id": "WEBSTER1833:GEN.42.3",
      "verse": 3,
      "spans": [
        {
          "text": "And Joseph's ten brethren went down to buy corn in Egypt.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.4",
      "edition_verse_id": "WEBSTER1833:GEN.42.4",
      "verse": 4,
      "spans": [
        {
          "text": "But Benjamin, Joseph's brother, Jacob sent not with his brethren: for he said, Lest perhaps mischief shall befall him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.5",
      "edition_verse_id": "WEBSTER1833:GEN.42.5",
      "verse": 5,
      "spans": [
        {
          "text": "And the sons of Israel came to buy ",
          "kind": "text"
        },
        {
          "text": "corn",
          "kind": "supplied"
        },
        {
          "text": " among those that came: for the famine was in the land of Canaan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.42.6",
      "edition_verse_id": "WEBSTER1833:GEN.42.6",
      "verse": 6,
      "spans": [
