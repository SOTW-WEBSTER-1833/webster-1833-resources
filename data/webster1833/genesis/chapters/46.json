      "edition_verse_id": "WEBSTER1833:GEN.46.18",
      "verse": 18,
      "spans": [
        {
          "text": "These ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the sons of Zilpah, whom Laban gave to Leah his daughter: and these she bore to Jacob, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " sixteen souls.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
