      "spans": [
        {
          "text": "And the sons of Benjamin ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " Belah, and Becher, and Ashbel, Gera, and Naaman, Ehi, and Rosh, Muppim, and Huppim, and Ard.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.46.22",
      "edition_verse_id": "WEBSTER1833:GEN.46.22",
      "verse": 22,
      "spans": [
        {
          "text": "These ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the sons of Rachel, who were born to Jacob; all the souls ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " fourteen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
