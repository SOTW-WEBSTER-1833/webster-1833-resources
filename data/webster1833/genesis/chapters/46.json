      "id": "GEN.46.13",
      "edition_verse_id": "WEBSTER1833:GEN.46.13",
      "verse": 13,
      "spans": [
        {
          "text": "And the sons of Issachar; Tola, and Phuvah, and Job, and Shimron.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.46.14",
      "edition_verse_id": "WEBSTER1833:GEN.46.14",
      "verse": 14,
      "spans": [
        {
          "text": "And the sons of Zebulun; Sered, and Elon, and Jahleel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
