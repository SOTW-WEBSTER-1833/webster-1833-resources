{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "GEN",
  "chapter": 5,
  "verses": [
    {
      "id": "GEN.5.1",
      "edition_verse_id": "WEBSTER1833:GEN.5.1",
      "verse": 1,
      "spans": [
        {
          "text": "This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the book of the generations of Adam: In the day that God created man, in the likeness of God made he him:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "GEN.5.2",
      "edition_verse_id": "WEBSTER1833:GEN.5.2",
      "verse": 2,
      "spans": [
        {
          "text": "Male and female created he them; and blessed them, and called their name Adam, in the day when they were created.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.3",
      "edition_verse_id": "WEBSTER1833:GEN.5.3",
      "verse": 3,
      "spans": [
        {
          "text": "And Adam lived a hundred and thirty years, and begat ",
          "kind": "text"
        },
        {
          "text": "a son",
          "kind": "supplied"
        },
        {
          "text": " in his own likeness, after his image; and called his name Seth:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.4",
      "edition_verse_id": "WEBSTER1833:GEN.5.4",
      "verse": 4,
      "spans": [
        {
          "text": "And the days of Adam after he had begotten Seth were eight hundred years: and he begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.5",
      "edition_verse_id": "WEBSTER1833:GEN.5.5",
      "verse": 5,
      "spans": [
        {
          "text": "And all the days that Adam lived were nine hundred and thirty years: and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.6",
      "edition_verse_id": "WEBSTER1833:GEN.5.6",
      "verse": 6,
      "spans": [
        {
          "text": "And Seth lived a hundred and five years, and begat Enos:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.7",
      "edition_verse_id": "WEBSTER1833:GEN.5.7",
      "verse": 7,
      "spans": [
        {
          "text": "And Seth lived after he begat Enos eight hundred and seven years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.8",
      "edition_verse_id": "WEBSTER1833:GEN.5.8",
      "verse": 8,
      "spans": [
        {
          "text": "And all the days of Seth were nine hundred and twelve years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.9",
      "edition_verse_id": "WEBSTER1833:GEN.5.9",
      "verse": 9,
      "spans": [
        {
          "text": "And Enos lived ninety years, and begat Cainan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.10",
      "edition_verse_id": "WEBSTER1833:GEN.5.10",
      "verse": 10,
      "spans": [
        {
          "text": "And Enos lived after he begat Cainan eight hundred and fifteen years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.11",
      "edition_verse_id": "WEBSTER1833:GEN.5.11",
      "verse": 11,
      "spans": [
        {
          "text": "And all the days of Enos were nine hundred and five years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.12",
      "edition_verse_id": "WEBSTER1833:GEN.5.12",
      "verse": 12,
      "spans": [
        {
          "text": "And Cainan lived seventy years, and begat Mahalaleel:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.13",
      "edition_verse_id": "WEBSTER1833:GEN.5.13",
      "verse": 13,
      "spans": [
        {
          "text": "And Cainan lived after he begat Mahalaleel eight hundred and forty years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.14",
      "edition_verse_id": "WEBSTER1833:GEN.5.14",
      "verse": 14,
      "spans": [
        {
          "text": "And all the days of Cainan were nine hundred and ten years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.15",
      "edition_verse_id": "WEBSTER1833:GEN.5.15",
      "verse": 15,
      "spans": [
        {
          "text": "And Mahalaleel lived sixty and five years, and begat Jared:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.16",
      "edition_verse_id": "WEBSTER1833:GEN.5.16",
      "verse": 16,
      "spans": [
        {
          "text": "And Mahalaleel lived after he begat Jared eight hundred and thirty years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.17",
      "edition_verse_id": "WEBSTER1833:GEN.5.17",
      "verse": 17,
      "spans": [
        {
          "text": "And all the days of Mahalaleel were eight hundred ninety and five years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.18",
      "edition_verse_id": "WEBSTER1833:GEN.5.18",
      "verse": 18,
      "spans": [
        {
          "text": "And Jared lived a hundred sixty and two years, and he begat Enoch:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.19",
      "edition_verse_id": "WEBSTER1833:GEN.5.19",
      "verse": 19,
      "spans": [
        {
          "text": "And Jared lived after he begat Enoch eight hundred years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.20",
      "edition_verse_id": "WEBSTER1833:GEN.5.20",
      "verse": 20,
      "spans": [
        {
          "text": "And all the days of Jared were nine hundred sixty and two years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.21",
      "edition_verse_id": "WEBSTER1833:GEN.5.21",
      "verse": 21,
      "spans": [
        {
          "text": "And Enoch lived sixty and five years, and begat Methuselah:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.22",
      "edition_verse_id": "WEBSTER1833:GEN.5.22",
      "verse": 22,
      "spans": [
        {
          "text": "And Enoch walked with God after he begat Methuselah three hundred years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.23",
      "edition_verse_id": "WEBSTER1833:GEN.5.23",
      "verse": 23,
      "spans": [
        {
          "text": "And all the days of Enoch were three hundred sixty and five years:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.24",
      "edition_verse_id": "WEBSTER1833:GEN.5.24",
      "verse": 24,
      "spans": [
        {
          "text": "And Enoch walked with God, and he ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " not: for God took him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.25",
      "edition_verse_id": "WEBSTER1833:GEN.5.25",
      "verse": 25,
      "spans": [
        {
          "text": "And Methuselah lived a hundred eighty and seven years, and begat Lamech:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.26",
      "edition_verse_id": "WEBSTER1833:GEN.5.26",
      "verse": 26,
      "spans": [
        {
          "text": "And Methuselah lived after he begat Lamech seven hundred eighty and two years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.27",
      "edition_verse_id": "WEBSTER1833:GEN.5.27",
      "verse": 27,
      "spans": [
        {
          "text": "And all the days of Methuselah were nine hundred sixty and nine years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.28",
      "edition_verse_id": "WEBSTER1833:GEN.5.28",
      "verse": 28,
      "spans": [
        {
          "text": "And Lamech lived a hundred eighty and two years; and begat a son:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.29",
      "edition_verse_id": "WEBSTER1833:GEN.5.29",
      "verse": 29,
      "spans": [
        {
          "text": "And he called his name Noah, saying, This ",
          "kind": "text"
        },
        {
          "text": "same",
          "kind": "supplied"
        },
        {
          "text": " shall comfort us concerning our work and toil of our hands, because of the ground which the LORD hath cursed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.30",
      "edition_verse_id": "WEBSTER1833:GEN.5.30",
      "verse": 30,
      "spans": [
        {
          "text": "And Lamech lived after he begat Noah five hundred ninety and five years, and begat sons and daughters:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.31",
      "edition_verse_id": "WEBSTER1833:GEN.5.31",
      "verse": 31,
      "spans": [
        {
          "text": "And all the days of Lamech were seven hundred seventy and seven years; and he died.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.5.32",
      "edition_verse_id": "WEBSTER1833:GEN.5.32",
      "verse": 32,
      "spans": [
        {
          "text": "And Noah was five hundred years old: and Noah begat Shem, Ham, and Japheth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
