      "edition_verse_id": "WEBSTER1833:GEN.39.17",
      "verse": 17,
      "spans": [
        {
          "text": "And she spoke to him according to these words, saying, The Hebrew servant, which thou hast brought to us, came in to me to mock me.",
          "kind": "text"
        }
