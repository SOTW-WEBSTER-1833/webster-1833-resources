      "id": "GEN.39.8",
      "edition_verse_id": "WEBSTER1833:GEN.39.8",
      "verse": 8,
      "spans": [
        {
          "text": "But he refused, and said to his master's wife, Behold, my master knoweth not what ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " with me in the house, and he hath committed all that he hath to my hand:",
          "kind": "text"
        }
