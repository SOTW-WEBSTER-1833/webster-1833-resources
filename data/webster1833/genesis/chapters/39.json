      "edition_verse_id": "WEBSTER1833:GEN.39.15",
      "verse": 15,
      "spans": [
        {
          "text": "And it came to pass, when he heard that I raised my voice and cried, that he left his garment with me, and fled, and went out.",
          "kind": "text"
