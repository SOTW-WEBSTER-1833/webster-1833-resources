      "edition_verse_id": "WEBSTER1833:GEN.39.11",
      "verse": 11,
      "spans": [
        {
          "text": "And it came to pass, about this time, that ",
          "kind": "text"
        },
        {
          "text": "Joseph",
          "kind": "supplied"
        },
        {
          "text": " went into the house to do his business; and ",
          "kind": "text"
        },
        {
