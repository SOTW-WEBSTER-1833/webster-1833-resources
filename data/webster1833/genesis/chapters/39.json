      "edition_verse_id": "WEBSTER1833:GEN.39.12",
      "verse": 12,
      "spans": [
        {
          "text": "And she caught him by his garment, saying, Lie with me: and he left his garment in her hand, and fled, and went out.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "GEN.39.13",
      "edition_verse_id": "WEBSTER1833:GEN.39.13",
      "verse": 13,
      "spans": [
        {
          "text": "And it came to pass, when she saw that he had left his garment in her hand, and had fled forth,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
