      "paragraph_start": false
    },
    {
      "id": "GEN.39.9",
      "edition_verse_id": "WEBSTER1833:GEN.39.9",
      "verse": 9,
      "spans": [
        {
          "text": "There is",
          "kind": "supplied"
        },
        {
          "text": " none greater in his house than I; neither hath he kept back any thing from me but thee, because thou ",
          "kind": "text"
        },
        {
          "text": "art",
          "kind": "supplied"
        },
        {
          "text": " his wife: how then can I do this great wickedness, and sin against God?",
          "kind": "text"
