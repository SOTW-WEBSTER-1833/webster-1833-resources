      "edition_verse_id": "WEBSTER1833:GEN.39.14",
      "verse": 14,
      "spans": [
        {
          "text": "That she called to the men of her house, and spoke to them, saying, See, he hath brought in a Hebrew to us to mock us: he came in to me to lie with me, and I cried with a loud voice:",
          "kind": "text"
        }
      ],
