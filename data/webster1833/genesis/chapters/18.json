      "paragraph_start": false
    },
    {
      "id": "GEN.18.19",
      "edition_verse_id": "WEBSTER1833:GEN.18.19",
      "verse": 19,
      "spans": [
        {
          "text": "For I know him, that he will command his children and his household after him, and they will keep the way of the LORD, to do justice and judgment; that the LORD may bring upon Abraham that which he hath spoken of him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
