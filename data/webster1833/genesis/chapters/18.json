    {
      "id": "GEN.18.28",
      "edition_verse_id": "WEBSTER1833:GEN.18.28",
      "verse": 28,
      "spans": [
        {
          "text": "Peradventure there will lack five of the fifty righteous: wilt thou destroy all the city for ",
          "kind": "text"
        },
        {
          "text": "lack of",
          "kind": "supplied"
        },
