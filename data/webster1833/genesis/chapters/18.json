      "edition_verse_id": "WEBSTER1833:GEN.18.11",
      "verse": 11,
      "spans": [
        {
          "text": "Now Abraham and Sarah ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " old ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " far advanced in age; ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " it ceased to be with Sarah after the manner of women.",
