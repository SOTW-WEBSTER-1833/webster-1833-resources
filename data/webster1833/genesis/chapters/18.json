      "paragraph_start": false
    },
    {
      "id": "GEN.18.27",
      "edition_verse_id": "WEBSTER1833:GEN.18.27",
      "verse": 27,
      "spans": [
        {
          "text": "And Abraham answered and said, Behold now, I, who ",
