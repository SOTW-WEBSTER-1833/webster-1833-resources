{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EXO",
  "chapter": 25,
  "verses": [
    {
      "id": "EXO.25.1",
      "edition_verse_id": "WEBSTER1833:EXO.25.1",
      "verse": 1,
      "spans": [
        {
          "text": "And the LORD spoke to Moses, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EXO.25.2",
      "edition_verse_id": "WEBSTER1833:EXO.25.2",
      "verse": 2,
      "spans": [
        {
          "text": "Speak to the children of Israel, that they bring me an offering: of every man that giveth it willingly with his heart ye shall take my offering.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.3",
      "edition_verse_id": "WEBSTER1833:EXO.25.3",
      "verse": 3,
      "spans": [
        {
          "text": "And this ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the offering which ye shall take of them; gold, and silver and brass,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.4",
      "edition_verse_id": "WEBSTER1833:EXO.25.4",
      "verse": 4,
      "spans": [
        {
          "text": "And blue, and purple, and scarlet, and fine linen, and goats' ",
          "kind": "text"
        },
        {
          "text": "hair",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.5",
      "edition_verse_id": "WEBSTER1833:EXO.25.5",
      "verse": 5,
      "spans": [
        {
          "text": "And rams' skins dyed red, and badgers' skins, and shittim wood.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.6",
      "edition_verse_id": "WEBSTER1833:EXO.25.6",
      "verse": 6,
      "spans": [
        {
          "text": "Oil for the light, spices for anointing oil, and for sweet incense,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.7",
      "edition_verse_id": "WEBSTER1833:EXO.25.7",
      "verse": 7,
      "spans": [
        {
          "text": "Onyx stones, and stones to be set in the ephod, and in the breast-plate.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.8",
      "edition_verse_id": "WEBSTER1833:EXO.25.8",
      "verse": 8,
      "spans": [
        {
          "text": "And let them make me a sanctuary; that I may dwell among them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.9",
      "edition_verse_id": "WEBSTER1833:EXO.25.9",
      "verse": 9,
      "spans": [
        {
          "text": "According to all that I show thee ",
          "kind": "text"
        },
        {
          "text": "after",
          "kind": "supplied"
        },
        {
          "text": " the pattern of the tabernacle, and the pattern of all its instruments, even so shall ye make ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.10",
      "edition_verse_id": "WEBSTER1833:EXO.25.10",
      "verse": 10,
      "spans": [
        {
          "text": "And they shall make an ark ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood: two cubits and a half ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " its length, and a cubit and a half its breadth, and a cubit and a half its hight.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.11",
      "edition_verse_id": "WEBSTER1833:EXO.25.11",
      "verse": 11,
      "spans": [
        {
          "text": "And thou shalt overlay it with pure gold, within and without shalt thou overlay it, and shalt make upon it a crown of gold around it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.12",
      "edition_verse_id": "WEBSTER1833:EXO.25.12",
      "verse": 12,
      "spans": [
        {
          "text": "And thou shalt cast four rings of gold for it, and put ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " in its four corners; and two rings ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " in the one side of it, and two rings in the other side of it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.13",
      "edition_verse_id": "WEBSTER1833:EXO.25.13",
      "verse": 13,
      "spans": [
        {
          "text": "And thou shalt make staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlay them with gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.14",
      "edition_verse_id": "WEBSTER1833:EXO.25.14",
      "verse": 14,
      "spans": [
        {
          "text": "And thou shalt put the staffs into the rings by the sides of the ark, that the ark may be borne with them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.15",
      "edition_verse_id": "WEBSTER1833:EXO.25.15",
      "verse": 15,
      "spans": [
        {
          "text": "The staffs shall be in the rings of the ark: they shall not be taken from it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.16",
      "edition_verse_id": "WEBSTER1833:EXO.25.16",
      "verse": 16,
      "spans": [
        {
          "text": "And thou shalt put into the ark the testimony which I shall give thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.17",
      "edition_verse_id": "WEBSTER1833:EXO.25.17",
      "verse": 17,
      "spans": [
        {
          "text": "And thou shalt make a mercy-seat ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold: two cubits and a half ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " its length, and a cubit and a half its breadth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.18",
      "edition_verse_id": "WEBSTER1833:EXO.25.18",
      "verse": 18,
      "spans": [
        {
          "text": "And thou shalt make two cherubim ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " gold, ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " beaten work shalt thou make them, in the two ends of the mercy-seat.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.19",
      "edition_verse_id": "WEBSTER1833:EXO.25.19",
      "verse": 19,
      "spans": [
        {
          "text": "And make one cherub on the one end, and the other cherub on the other end: ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " of the mercy-seat shall ye make the cherubim on its two ends.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.20",
      "edition_verse_id": "WEBSTER1833:EXO.25.20",
      "verse": 20,
      "spans": [
        {
          "text": "And the cherubim shall stretch forth ",
          "kind": "text"
        },
        {
          "text": "their",
          "kind": "supplied"
        },
        {
          "text": " wings on high, covering the mercy-seat with their wings, and their faces ",
          "kind": "text"
        },
        {
          "text": "shall look",
          "kind": "supplied"
        },
        {
          "text": " one to another; towards the mercy-seat shall the faces of the cherubim be.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.21",
      "edition_verse_id": "WEBSTER1833:EXO.25.21",
      "verse": 21,
      "spans": [
        {
          "text": "And thou shalt put the mercy-seat above upon the ark; and in the ark thou shalt put the testimony that I shall give thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.22",
      "edition_verse_id": "WEBSTER1833:EXO.25.22",
      "verse": 22,
      "spans": [
        {
          "text": "And there I will meet with thee, and I will commune with thee from above the mercy-seat, from between the two cherubim which ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " upon the ark of the testimony, of all ",
          "kind": "text"
        },
        {
          "text": "things",
          "kind": "supplied"
        },
        {
          "text": " which I will give thee in commandment to the children of Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.23",
      "edition_verse_id": "WEBSTER1833:EXO.25.23",
      "verse": 23,
      "spans": [
        {
          "text": "Thou shalt also make a table ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood: its length shall be two cubits, and its breadth a cubit, and its hight a cubit and a half.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.24",
      "edition_verse_id": "WEBSTER1833:EXO.25.24",
      "verse": 24,
      "spans": [
        {
          "text": "And thou shalt overlay it with pure gold, and make to it a crown of gold around it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.25",
      "edition_verse_id": "WEBSTER1833:EXO.25.25",
      "verse": 25,
      "spans": [
        {
          "text": "And thou shalt make to it a border of an hand-breadth around it, and thou shalt make a golden crown to its border around it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.26",
      "edition_verse_id": "WEBSTER1833:EXO.25.26",
      "verse": 26,
      "spans": [
        {
          "text": "And thou shalt make for it four rings of gold, and put the rings in the four corners that ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " on its four feet.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.27",
      "edition_verse_id": "WEBSTER1833:EXO.25.27",
      "verse": 27,
      "spans": [
        {
          "text": "Over against the border shall the rings be for places of the staffs to bear the table.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.28",
      "edition_verse_id": "WEBSTER1833:EXO.25.28",
      "verse": 28,
      "spans": [
        {
          "text": "And thou shalt make the staffs ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " shittim wood, and overlay them with gold, that the table may be borne with them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.29",
      "edition_verse_id": "WEBSTER1833:EXO.25.29",
      "verse": 29,
      "spans": [
        {
          "text": "And thou shalt make its dishes, and its spoons, and its covers, and its bowls, to cover it with: ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold shalt thou make them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.30",
      "edition_verse_id": "WEBSTER1833:EXO.25.30",
      "verse": 30,
      "spans": [
        {
          "text": "And thou shalt set upon the table show-bread before me always.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.31",
      "edition_verse_id": "WEBSTER1833:EXO.25.31",
      "verse": 31,
      "spans": [
        {
          "text": "And thou shalt make a candlestick ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold: ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " beaten work shall the candlestick be made: its shaft, and its branches, its bowls, its knobs, and its flowers, shall be of the same.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.32",
      "edition_verse_id": "WEBSTER1833:EXO.25.32",
      "verse": 32,
      "spans": [
        {
          "text": "And six branches shall extend from the sides of it; three branches of the candlestick from the one side, and three branches of the candlestick from the other side:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.33",
      "edition_verse_id": "WEBSTER1833:EXO.25.33",
      "verse": 33,
      "spans": [
        {
          "text": "Three bowls made like to almonds, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " a knob and a flower in one branch; and three bowls made like almonds in the other branch, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " a knob and a flower: so in the six branches that project from the candlestick.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.34",
      "edition_verse_id": "WEBSTER1833:EXO.25.34",
      "verse": 34,
      "spans": [
        {
          "text": "And in the candlesticks ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " four bowls made like to almonds, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " their knobs and their flowers.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.35",
      "edition_verse_id": "WEBSTER1833:EXO.25.35",
      "verse": 35,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "there shall be",
          "kind": "supplied"
        },
        {
          "text": " a knob under two branches of the same, and a knob under two branches of the same, and a knob under two branches of the same, according to the six branches that project from the candlestick.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.36",
      "edition_verse_id": "WEBSTER1833:EXO.25.36",
      "verse": 36,
      "spans": [
        {
          "text": "Their knobs and their branches shall be of the same: all of it ",
          "kind": "text"
        },
        {
          "text": "shall be",
          "kind": "supplied"
        },
        {
          "text": " one beaten work ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.37",
      "edition_verse_id": "WEBSTER1833:EXO.25.37",
      "verse": 37,
      "spans": [
        {
          "text": "And thou shalt make its seven lamps: and they shall light its lamps, that they may give light over against it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.38",
      "edition_verse_id": "WEBSTER1833:EXO.25.38",
      "verse": 38,
      "spans": [
        {
          "text": "And its tongs, and its snuff-dishes, ",
          "kind": "text"
        },
        {
          "text": "shall be of",
          "kind": "supplied"
        },
        {
          "text": " pure gold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.39",
      "edition_verse_id": "WEBSTER1833:EXO.25.39",
      "verse": 39,
      "spans": [
        {
          "text": "Of",
          "kind": "supplied"
        },
        {
          "text": " a talent of pure gold shall he make it, with all these vessels.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.25.40",
      "edition_verse_id": "WEBSTER1833:EXO.25.40",
      "verse": 40,
      "spans": [
        {
          "text": "And look that thou make ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": " after their pattern, which was shown thee on the mount.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
