{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "EXO",
  "chapter": 35,
  "verses": [
    {
      "id": "EXO.35.1",
      "edition_verse_id": "WEBSTER1833:EXO.35.1",
      "verse": 1,
      "spans": [
        {
          "text": "And Moses assembled all the congregation of the children of Israel, and said to them, These ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " the words which the LORD hath commanded, that ",
          "kind": "text"
        },
        {
          "text": "ye",
          "kind": "supplied"
        },
        {
          "text": " should do them.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "EXO.35.2",
      "edition_verse_id": "WEBSTER1833:EXO.35.2",
      "verse": 2,
      "spans": [
        {
          "text": "Six days shall work be done; but on the seventh day there shall be to you a holy day, a sabbath of rest to the LORD: whoever doth work therein shall be put to death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.3",
      "edition_verse_id": "WEBSTER1833:EXO.35.3",
      "verse": 3,
      "spans": [
        {
          "text": "Ye shall kindle no fire throughout your habitations upon the sabbath-day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.4",
      "edition_verse_id": "WEBSTER1833:EXO.35.4",
      "verse": 4,
      "spans": [
        {
          "text": "And Moses spoke to all the congregation of the children of Israel, saying, This ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the thing which the LORD commanded, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.5",
      "edition_verse_id": "WEBSTER1833:EXO.35.5",
      "verse": 5,
      "spans": [
        {
          "text": "Take ye from among you an offering to the LORD: whoever ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " of a willing heart, let him bring it, an offering of the LORD; gold, and silver, and brass,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.6",
      "edition_verse_id": "WEBSTER1833:EXO.35.6",
      "verse": 6,
      "spans": [
        {
          "text": "And blue, and purple, and scarlet, and fine linen, and goats' ",
          "kind": "text"
        },
        {
          "text": "hair",
          "kind": "supplied"
        },
        {
          "text": ",",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.7",
      "edition_verse_id": "WEBSTER1833:EXO.35.7",
      "verse": 7,
      "spans": [
        {
          "text": "And rams' skins dyed red, and badgers' skins, and shittim wood,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.8",
      "edition_verse_id": "WEBSTER1833:EXO.35.8",
      "verse": 8,
      "spans": [
        {
          "text": "And oil for the light, and spices for anointing oil, and for the sweet incense,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.9",
      "edition_verse_id": "WEBSTER1833:EXO.35.9",
      "verse": 9,
      "spans": [
        {
          "text": "And onyx stones, and stones to be set for the ephod, and for the breast-plate.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.10",
      "edition_verse_id": "WEBSTER1833:EXO.35.10",
      "verse": 10,
      "spans": [
        {
          "text": "And every wise-hearted among you shall come, and make all that the LORD hath commanded;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.11",
      "edition_verse_id": "WEBSTER1833:EXO.35.11",
      "verse": 11,
      "spans": [
        {
          "text": "The tabernacle, its tent, and its covering, its buttons, and its boards, its bars, its pillars, and its sockets,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.12",
      "edition_verse_id": "WEBSTER1833:EXO.35.12",
      "verse": 12,
      "spans": [
        {
          "text": "The ark, and its staffs, ",
          "kind": "text"
        },
        {
          "text": "with",
          "kind": "supplied"
        },
        {
          "text": " the mercy-seat, and the vail of the covering,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.13",
      "edition_verse_id": "WEBSTER1833:EXO.35.13",
      "verse": 13,
      "spans": [
        {
          "text": "The table, and its staffs, and all its vessels, and the show-bread,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.14",
      "edition_verse_id": "WEBSTER1833:EXO.35.14",
      "verse": 14,
      "spans": [
        {
          "text": "The candlestick also for the light, and its furniture, and its lamps, with the oil for the light,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.15",
      "edition_verse_id": "WEBSTER1833:EXO.35.15",
      "verse": 15,
      "spans": [
        {
          "text": "And the incense-altar, and its staffs, and the anointing oil, and the sweet incense, and the hanging for the door at the entrance of the tabernacle,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.16",
      "edition_verse_id": "WEBSTER1833:EXO.35.16",
      "verse": 16,
      "spans": [
        {
          "text": "The altar of burnt-offering, with its brazen grate, its staffs, and all its vessels, the laver and its foot,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.17",
      "edition_verse_id": "WEBSTER1833:EXO.35.17",
      "verse": 17,
      "spans": [
        {
          "text": "The hangings of the court, its pillars, and their sockets, and the hanging for the door of the court,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.18",
      "edition_verse_id": "WEBSTER1833:EXO.35.18",
      "verse": 18,
      "spans": [
        {
          "text": "The pins of the tabernacle, and the pins of the court, and their cords,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.19",
      "edition_verse_id": "WEBSTER1833:EXO.35.19",
      "verse": 19,
      "spans": [
        {
          "text": "The clothes of service, to do service in the holy ",
          "kind": "text"
        },
        {
          "text": "place",
          "kind": "supplied"
        },
        {
          "text": ", the holy garments for Aaron the priest, and the garments of his sons, to minister in the priest's office.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.20",
      "edition_verse_id": "WEBSTER1833:EXO.35.20",
      "verse": 20,
      "spans": [
        {
          "text": "And all the congregation of the children of Israel departed from the presence of Moses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.21",
      "edition_verse_id": "WEBSTER1833:EXO.35.21",
      "verse": 21,
      "spans": [
        {
          "text": "And they came, every one whose heart excited him, and every one whom his spirit made willing, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " they brought the LORD'S offering to the work of the tabernacle of the congregation, and for all his service, and for the holy garments.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.22",
      "edition_verse_id": "WEBSTER1833:EXO.35.22",
      "verse": 22,
      "spans": [
        {
          "text": "And they came, both men and women, as many as were willing-hearted, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " brought bracelets, and ear-rings, and rings, and tablets, all jewels of gold; and every man that offered, ",
          "kind": "text"
        },
        {
          "text": "offered",
          "kind": "supplied"
        },
        {
          "text": " an offering of gold to the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.23",
      "edition_verse_id": "WEBSTER1833:EXO.35.23",
      "verse": 23,
      "spans": [
        {
          "text": "And every man, with whom was found blue, and purple, and scarlet, and fine linen, and goats' ",
          "kind": "text"
        },
        {
          "text": "hair",
          "kind": "supplied"
        },
        {
          "text": ", and red skins of rams, and badgers' skins, brought ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.24",
      "edition_verse_id": "WEBSTER1833:EXO.35.24",
      "verse": 24,
      "spans": [
        {
          "text": "Every one that offered an offering of silver and brass brought the LORD'S offering: and every man with whom was found shittim wood for any work of the service, brought ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.25",
      "edition_verse_id": "WEBSTER1833:EXO.35.25",
      "verse": 25,
      "spans": [
        {
          "text": "And all the women that were wise-hearted spun with their hands, and brought that which they had spun, ",
          "kind": "text"
        },
        {
          "text": "both",
          "kind": "supplied"
        },
        {
          "text": " of blue, and of purple, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " of scarlet, and of fine linen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.26",
      "edition_verse_id": "WEBSTER1833:EXO.35.26",
      "verse": 26,
      "spans": [
        {
          "text": "And all the women whose heart moved them in wisdom spun goats' ",
          "kind": "text"
        },
        {
          "text": "hair",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.27",
      "edition_verse_id": "WEBSTER1833:EXO.35.27",
      "verse": 27,
      "spans": [
        {
          "text": "And the rulers brought onyx stones, and stones to be set, for the ephod, and for the breast-plate;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.28",
      "edition_verse_id": "WEBSTER1833:EXO.35.28",
      "verse": 28,
      "spans": [
        {
          "text": "And spice, and oil for the light, and for the anointing oil, and for the sweet incense.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.29",
      "edition_verse_id": "WEBSTER1833:EXO.35.29",
      "verse": 29,
      "spans": [
        {
          "text": "The children of Israel brought a willing offering to the LORD, every man and woman, whose heart made them willing to bring for all manner of work, which the LORD had commanded to be made by the hand of Moses.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.30",
      "edition_verse_id": "WEBSTER1833:EXO.35.30",
      "verse": 30,
      "spans": [
        {
          "text": "And Moses said to the children of Israel, See, the LORD hath called by name Bezaleel, the son of Uri, the son of Hur, of the tribe of Judah;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.31",
      "edition_verse_id": "WEBSTER1833:EXO.35.31",
      "verse": 31,
      "spans": [
        {
          "text": "And he hath filled him with the spirit of God, in wisdom, in understanding, and in knowledge, and in all manner of workmanship;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.32",
      "edition_verse_id": "WEBSTER1833:EXO.35.32",
      "verse": 32,
      "spans": [
        {
          "text": "And to devise curious works, to work in gold, and in silver, and in brass,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.33",
      "edition_verse_id": "WEBSTER1833:EXO.35.33",
      "verse": 33,
      "spans": [
        {
          "text": "And in the cutting of stones, to set ",
          "kind": "text"
        },
        {
          "text": "them",
          "kind": "supplied"
        },
        {
          "text": ", and in carving of wood, to make any manner of curious work.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.34",
      "edition_verse_id": "WEBSTER1833:EXO.35.34",
      "verse": 34,
      "spans": [
        {
          "text": "And he hath put in his heart that he may teach, ",
          "kind": "text"
        },
        {
          "text": "both",
          "kind": "supplied"
        },
        {
          "text": " he and Aholiab, the son of Ahisamach, of the tribe of Dan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.35.35",
      "edition_verse_id": "WEBSTER1833:EXO.35.35",
      "verse": 35,
      "spans": [
        {
          "text": "Them hath he filled with wisdom of heart, to work all manner of work, of the engraver, and of the skillful workmen, and of the embroiderer, in blue, and in purple, in scarlet, and in fine linen, and of the weaver, ",
          "kind": "text"
        },
        {
          "text": "even",
          "kind": "supplied"
        },
        {
          "text": " of them that do any work, and of those that devise curious work.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
