          "kind": "text"
        },
        {
          "text": "the hangings were",
          "kind": "supplied"
        },
        {
          "text": " a hundred cubits, their pillars ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
