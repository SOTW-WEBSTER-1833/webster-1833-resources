          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " of fine twined linen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "EXO.38.17",
      "edition_verse_id": "WEBSTER1833:EXO.38.17",
      "verse": 17,
      "spans": [
