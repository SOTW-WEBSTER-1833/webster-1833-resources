      "edition_verse_id": "WEBSTER1833:EXO.38.13",
      "verse": 13,
      "spans": [
        {
          "text": "And for the east side eastward fifty cubits.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
