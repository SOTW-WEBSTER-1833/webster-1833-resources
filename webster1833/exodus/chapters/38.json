          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " needle-work, ",
          "kind": "text"
        },
        {
          "text": "of",
          "kind": "supplied"
        },
        {
          "text": " blue, and purple, and scarlet, and fine twined linen: and twenty cubits ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " the length, and the hight in the breadth ",
          "kind": "text"
        },
        {
          "text": "was",
          "kind": "supplied"
        },
        {
          "text": " five cubits, answerable to the hangings of the court.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
