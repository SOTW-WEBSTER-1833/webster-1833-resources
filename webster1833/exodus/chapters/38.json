      "edition_verse_id": "WEBSTER1833:EXO.38.10",
      "verse": 10,
      "spans": [
        {
          "text": "Their pillars ",
          "kind": "text"
        },
        {
          "text": "were",
          "kind": "supplied"
        },
        {
          "text": " twenty, and their brazen sockets twenty; the hooks of the pillars, and their fillets, ",
          "kind": "text"
        },
        {
          "text": "were of",
          "kind": "supplied"
        },
        {
          "text": " silver.",
          "kind": "text"
