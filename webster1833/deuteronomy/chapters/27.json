{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "DEU",
  "chapter": 27,
  "verses": [
    {
      "id": "DEU.27.1",
      "edition_verse_id": "WEBSTER1833:DEU.27.1",
      "verse": 1,
      "spans": [
        {
          "text": "And Moses with the elders of Israel commanded the people, saying, Keep all the commandments which I command you this day.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "DEU.27.2",
      "edition_verse_id": "WEBSTER1833:DEU.27.2",
      "verse": 2,
      "spans": [
        {
          "text": "And it shall be on the day when ye shall pass over Jordan to the land which the LORD thy God giveth thee, that thou shalt set thee up great stones, and plaster them with plaster:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.3",
      "edition_verse_id": "WEBSTER1833:DEU.27.3",
      "verse": 3,
      "spans": [
        {
          "text": "And thou shalt write upon them all the words of this law, when thou hast passed over, that thou mayest enter in to the land which the LORD thy God giveth thee, a land that floweth with milk and honey; as the LORD God of thy fathers hath promised thee.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.4",
      "edition_verse_id": "WEBSTER1833:DEU.27.4",
      "verse": 4,
      "spans": [
        {
          "text": "Therefore it shall be when ye have gone over Jordan, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " ye shall set up these stones, which I command you this day, in mount Ebal, and thou shalt plaster them with plaster.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.5",
      "edition_verse_id": "WEBSTER1833:DEU.27.5",
      "verse": 5,
      "spans": [
        {
          "text": "And there shalt thou build an altar to the LORD thy God, an altar of stones: thou shalt not lift up ",
          "kind": "text"
        },
        {
          "text": "any",
          "kind": "supplied"
        },
        {
          "text": " iron ",
          "kind": "text"
        },
        {
          "text": "tool",
          "kind": "supplied"
        },
        {
          "text": " upon them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.6",
      "edition_verse_id": "WEBSTER1833:DEU.27.6",
      "verse": 6,
      "spans": [
        {
          "text": "Thou shalt build the altar of the LORD thy God of whole stones: and thou shalt offer on it burnt-offerings to the LORD thy God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.7",
      "edition_verse_id": "WEBSTER1833:DEU.27.7",
      "verse": 7,
      "spans": [
        {
          "text": "And thou shalt offer peace-offerings, and shalt eat there, and rejoice before the LORD thy God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.8",
      "edition_verse_id": "WEBSTER1833:DEU.27.8",
      "verse": 8,
      "spans": [
        {
          "text": "And thou shalt write upon the stones all the words of this law, very plainly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.9",
      "edition_verse_id": "WEBSTER1833:DEU.27.9",
      "verse": 9,
      "spans": [
        {
          "text": "And Moses and the priests the Levites spoke to all Israel, saying, Take heed and hearken, O Israel, this day thou art become the people of the LORD thy God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.10",
      "edition_verse_id": "WEBSTER1833:DEU.27.10",
      "verse": 10,
      "spans": [
        {
          "text": "Thou shalt therefore obey the voice of the LORD thy God, and do his commandments and his statutes which I command thee this day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.11",
      "edition_verse_id": "WEBSTER1833:DEU.27.11",
      "verse": 11,
      "spans": [
        {
          "text": "And Moses charged the people the same day, saying,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.12",
      "edition_verse_id": "WEBSTER1833:DEU.27.12",
      "verse": 12,
      "spans": [
        {
          "text": "These shall stand upon mount Gerizim to bless the people, when ye have come over Jordan; Simeon, and Levi, and Judah, and Issachar, and Joseph, and Benjamin:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.13",
      "edition_verse_id": "WEBSTER1833:DEU.27.13",
      "verse": 13,
      "spans": [
        {
          "text": "And these shall stand upon mount Ebal to curse; Reuben, Gad, and Asher, and Zebulun, Dan, and Naphtali.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.27.14",
      "edition_verse_id": "WEBSTER1833:DEU.27.14",
      "verse": 14,
      "spans": [
        {
          "text": "And the Levites shall speak, and say to all the men of Israel with a loud voice,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
