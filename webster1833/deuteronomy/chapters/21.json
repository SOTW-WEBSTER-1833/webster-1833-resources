{
  "schema_version": "1.0.0",
  "edition_id": "WEBSTER1833",
  "book_code": "DEU",
  "chapter": 21,
  "verses": [
    {
      "id": "DEU.21.1",
      "edition_verse_id": "WEBSTER1833:DEU.21.1",
      "verse": 1,
      "spans": [
        {
          "text": "If ",
          "kind": "text"
        },
        {
          "text": "one",
          "kind": "supplied"
        },
        {
          "text": " shall be found slain in the land which the LORD thy God giveth thee to possess it, lying in the field, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " it be not known who hath slain him:",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "DEU.21.2",
      "edition_verse_id": "WEBSTER1833:DEU.21.2",
      "verse": 2,
      "spans": [
        {
          "text": "Then thy elders and thy judges shall come forth, and they shall measure to the cities which ",
          "kind": "text"
        },
        {
          "text": "are",
          "kind": "supplied"
        },
        {
          "text": " around him that is slain:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.3",
      "edition_verse_id": "WEBSTER1833:DEU.21.3",
      "verse": 3,
      "spans": [
        {
          "text": "And it shall be ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " the city ",
          "kind": "text"
        },
        {
          "text": "which is",
          "kind": "supplied"
        },
        {
          "text": " next to the slain man, even the elders of that city shall take a heifer which hath not been wrought with, ",
          "kind": "text"
        },
        {
          "text": "and",
          "kind": "supplied"
        },
        {
          "text": " which hath not drawn in the yoke;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.4",
      "edition_verse_id": "WEBSTER1833:DEU.21.4",
      "verse": 4,
      "spans": [
        {
          "text": "And the elders of that city shall bring down the heifer to a rough valley, which is neither tilled nor sown, and shall strike off the heifer's neck there in the valley;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.5",
      "edition_verse_id": "WEBSTER1833:DEU.21.5",
      "verse": 5,
      "spans": [
        {
          "text": "And the priests the sons of Levi shall come near (for them the LORD thy God hath chosen to minister to him, and to bless in the name of the LORD) and by their word shall every controversy and every stroke be ",
          "kind": "text"
        },
        {
          "text": "tried",
          "kind": "supplied"
        },
        {
          "text": ";",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.6",
      "edition_verse_id": "WEBSTER1833:DEU.21.6",
      "verse": 6,
      "spans": [
        {
          "text": "And all the elders of that city ",
          "kind": "text"
        },
        {
          "text": "that are",
          "kind": "supplied"
        },
        {
          "text": " next to the slain ",
          "kind": "text"
        },
        {
          "text": "man",
          "kind": "supplied"
        },
        {
          "text": ", shall wash their hands over the heifer that is beheaded in the valley:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.7",
      "edition_verse_id": "WEBSTER1833:DEU.21.7",
      "verse": 7,
      "spans": [
        {
          "text": "And they shall answer and say, Our hands have not shed this blood, neither have our eyes seen ",
          "kind": "text"
        },
        {
          "text": "it",
          "kind": "supplied"
        },
        {
          "text": ".",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.8",
      "edition_verse_id": "WEBSTER1833:DEU.21.8",
      "verse": 8,
      "spans": [
        {
          "text": "Be merciful, O LORD, to thy people Israel, whom thou hast redeemed, and lay not innocent blood to the charge of thy people Israel. And the blood shall be forgiven them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.9",
      "edition_verse_id": "WEBSTER1833:DEU.21.9",
      "verse": 9,
      "spans": [
        {
          "text": "So shalt thou remove the ",
          "kind": "text"
        },
        {
          "text": "guilt of",
          "kind": "supplied"
        },
        {
          "text": " innocent blood from among you, when thou shalt do ",
          "kind": "text"
        },
        {
          "text": "that which is",
          "kind": "supplied"
        },
        {
          "text": " right in the sight of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.10",
      "edition_verse_id": "WEBSTER1833:DEU.21.10",
      "verse": 10,
      "spans": [
        {
          "text": "When thou goest forth to war against thy enemies, and the LORD thy God hath delivered them into thy hands, and thou hast taken them captive,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.11",
      "edition_verse_id": "WEBSTER1833:DEU.21.11",
      "verse": 11,
      "spans": [
        {
          "text": "And ",
          "kind": "text"
        },
        {
          "text": "thou",
          "kind": "supplied"
        },
        {
          "text": " seest among the captives a beautiful woman, and hast a desire to her, that thou wouldest have her for thy wife:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.12",
      "edition_verse_id": "WEBSTER1833:DEU.21.12",
      "verse": 12,
      "spans": [
        {
          "text": "Then thou shalt bring her home to thy house, and she shall shave her head, and pare her nails:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.13",
      "edition_verse_id": "WEBSTER1833:DEU.21.13",
      "verse": 13,
      "spans": [
        {
          "text": "And she shall put off from her the raiment of her captivity, and shall remain in thy house, and bewail her father and her mother a full month: and after that, thou shalt go in to her, and be her husband, and she shall be thy wife.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.14",
      "edition_verse_id": "WEBSTER1833:DEU.21.14",
      "verse": 14,
      "spans": [
        {
          "text": "And it shall be, if thou shalt have no delight in her, then thou shalt let her go whither she will; but thou shalt not sell her at all for money; thou shalt not make merchandise of her, because thou hast humbled her.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.15",
      "edition_verse_id": "WEBSTER1833:DEU.21.15",
      "verse": 15,
      "spans": [
        {
          "text": "If a man shall have two wives, one beloved, and another hated, and they have borne him children, ",
          "kind": "text"
        },
        {
          "text": "both",
          "kind": "supplied"
        },
        {
          "text": " the beloved and the hated; and ",
          "kind": "text"
        },
        {
          "text": "if",
          "kind": "supplied"
        },
        {
          "text": " the first-born son be hers that was hated:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.16",
      "edition_verse_id": "WEBSTER1833:DEU.21.16",
      "verse": 16,
      "spans": [
        {
          "text": "Then it shall be, when he maketh his sons to inherit ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " which he hath, ",
          "kind": "text"
        },
        {
          "text": "that",
          "kind": "supplied"
        },
        {
          "text": " he may not prefer the son of the beloved first-born, before the son of the hated, ",
          "kind": "text"
        },
        {
          "text": "which is indeed",
          "kind": "supplied"
        },
        {
          "text": " the first-born:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.17",
      "edition_verse_id": "WEBSTER1833:DEU.21.17",
      "verse": 17,
      "spans": [
        {
          "text": "But he shall acknowledge the son of the hated ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " the first-born, by giving him a double portion of all that he hath: for he ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " the beginning of his strength; the right of the first-born ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " his.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.18",
      "edition_verse_id": "WEBSTER1833:DEU.21.18",
      "verse": 18,
      "spans": [
        {
          "text": "If a man shall have a stubborn and rebellious son, who will not obey the voice of his father, or the voice of his mother, and ",
          "kind": "text"
        },
        {
          "text": "who",
          "kind": "supplied"
        },
        {
          "text": ", when they have chastened him, will not hearken to them:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.19",
      "edition_verse_id": "WEBSTER1833:DEU.21.19",
      "verse": 19,
      "spans": [
        {
          "text": "Then shall his father and his mother lay hold on him, and bring him out to the elders of his city, and to the gate of his place;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.20",
      "edition_verse_id": "WEBSTER1833:DEU.21.20",
      "verse": 20,
      "spans": [
        {
          "text": "And they shall say to the elders of his city, This our son ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " stubborn and rebellious, he will not obey our voice; ",
          "kind": "text"
        },
        {
          "text": "he is",
          "kind": "supplied"
        },
        {
          "text": " a glutton, and a drunkard.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.21",
      "edition_verse_id": "WEBSTER1833:DEU.21.21",
      "verse": 21,
      "spans": [
        {
          "text": "And all the men of his city shall stone him with stones, that he may die: so shalt thou remove evil from among you, and all Israel shall hear, and fear.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.22",
      "edition_verse_id": "WEBSTER1833:DEU.21.22",
      "verse": 22,
      "spans": [
        {
          "text": "And if a man shall have committed a sin worthy of death, and he must be put to death, and thou shalt hang him on a tree:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "DEU.21.23",
      "edition_verse_id": "WEBSTER1833:DEU.21.23",
      "verse": 23,
      "spans": [
        {
          "text": "His body shall not remain all night upon the tree, but thou shalt in any wise bury him that day; (for he that is hanged ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " accursed of God;) that thy land may not be defiled, which the LORD thy God giveth thee ",
          "kind": "text"
        },
        {
          "text": "for",
          "kind": "supplied"
        },
        {
          "text": " an inheritance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
