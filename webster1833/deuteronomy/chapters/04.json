        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " by the bank of the river Arnon, even to mount Sion, which ",
          "kind": "text"
        },
        {
          "text": "is",
          "kind": "supplied"
        },
        {
          "text": " Hermon,",
          "kind": "text"
